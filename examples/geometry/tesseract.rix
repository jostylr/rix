/**
plugins: [scene3d, nd, svg, gltf]
**/

## A 4D hypercube stays exact through a Cayley rotation and an explicit
## coordinate projection. Approximation begins only at Snapshot/glTF export.
tesseract := .nd.Hypercube(4, 2);
rotation := .nd.CayleyRotation(4, 1, 4, 1/3);
xyz := .nd.CoordinateProjection(4, [1, 2, 3]);
projection := .nd.Compose(xyz, rotation);
projected := .nd.Project(tesseract, projection);

camera := .scene3d.OrthographicCamera([4, 4, 3], [0, 0, 0]);
scene := .nd.ToScene3D(projected, {=
    camera=camera,
    style={= color="#275dad", width=2 }
});
snapshot := .scene3d.Snapshot(scene, {= size=[640, 480], mode="wireframe" });
graphic := snapshot["value"];

.Out("tesseract.svg", graphic);
.Out("tesseract.gltf", scene);

.Figure(
    graphic,
    "A tesseract after an exact 4D Cayley rotation and explicit 4D → 3D projection.",
    "tesseract-projection",
    "A blue wireframe projection of a four-dimensional hypercube."
)

