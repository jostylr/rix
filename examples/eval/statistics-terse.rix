## The same statistics expressed with collection pipe operators.

Sum(accumulator, value) -> accumulator + value;
Mean(items) -> (items |:> 0 >: Sum) / .LEN(items);

Variance(items) -> {;
    average := Mean(items);
    squaredDifferences := items |>> ((x) -> (x - average) ^ 2);
    (squaredDifferences |:> 0 >: Sum) / .LEN(items)
};

data := [10, 20, 30, 40, 50, 60];

{=
    data = data,
    mean = Mean(data),
    variance = Variance(data)
}
