## Collatz sequence with direct conditional expressions and tail recursion.

NextCollatz(n) -> n % 2 == 0 ?: n / 2 ?_ 3 * n + 1;

CollatzLength(n, count) ->
    n == 1 ?: count ?_ $(NextCollatz(n), count + 1);

StepsToOne(n) -> CollatzLength(n, 0);

n1 := NextCollatz(27);
n2 := NextCollatz(n1);
n3 := NextCollatz(n2);
n4 := NextCollatz(n3);

{=
    start = 27,
    steps = StepsToOne(27),
    firstFive = [27, n1, n2, n3, n4]
}
