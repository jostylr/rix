## Exact mean and population variance with public collection capabilities.

.Plugin.Load("numerics");

Sum(accumulator, value) -> accumulator + value;

Mean(items) -> .Reduce(items, Sum, 0) / .LEN(items);

Variance(items) -> {;
    average := Mean(items);
    squaredDifferences := .PMap(items, (x) -> (x - average) ^ 2);
    .Reduce(squaredDifferences, Sum, 0) / .LEN(items)
};

data := [10, 20, 30, 40, 50, 60];
mean := Mean(data);
variance := Variance(data);

{=
    data = data,
    mean = mean,
    variance = variance,
    standardDeviation = .numerics.Sqrt(variance)
}
