## Prime discovery with stack-safe recursive trial division.

HasDivisorFrom(n, divisor) ->
    divisor * divisor > n
        ?: _
        ?_ n % divisor == 0
            ?: 1
            ?_ $(n, divisor + 1);

IsPrime(n) ->
    n < 2 ?: _ ?_ n == 2 ?: 1 ?_ !HasDivisorFrom(n, 2);

primes := .IRANGE(1, 50) |>? IsPrime;

{= primes=primes, count=.LEN(primes) }
