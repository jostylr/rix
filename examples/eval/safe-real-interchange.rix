.Plugin.Load("numerics");
.Plugin.Load("data");
saved := """
{"schema":"rix.refinable-real@1","subject":{"kind":"expression","graph":{"kind":"call","semanticId":"rix.function.sqrt@1","branch":"nonnegative","arguments":[{"kind":"constant","value":{"$integer":"2"}}]}},"snapshot":{"interval":{"$interval":[{"$integer":"1"},{"$integer":"2"}]},"status":"certified","evidenceLevel":"proof","verification":"unavailable","evidence":[],"achievedWidth":{"$integer":"1"},"work":{"calls":"0","iterations":"0"}},"recipe":{"kind":"expression","provider":"numerics","providerVersion":"2","algorithm":"semantic-enclosure","algorithmVersion":"1","checker":"rix.real.numerics-replay@1","graph":{"kind":"call","semanticId":"rix.function.sqrt@1","branch":"nonnegative","arguments":[{"kind":"constant","value":{"$integer":"2"}}]}}}
""";
real := .RealImportJSON(saved);
before := .RealImportInfo(real);
after := .RealRefineImported(real,{= width=1/1000,maxCalls=256,maxIterations=256 });
rows := .data.Relation(["stage","verification","enclosure"],[
    ["Imported",before[:verification],before[:interval]],
    ["Explicitly refined",after[:verification],after[:interval]]
]);
copy := .data.ParseCSV(.data.RenderCSV(rows));
view := .data.TableView(copy,{= caption="Saved declarations and locally replayed evidence" });
.Out("interchange.html",view);
.Out("interchange.rixdoc.json",view);
_
