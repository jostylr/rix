## The lazy divisor source stops as soon as Find discovers a factor.

FirstDivisor(n) ->
    [2 |+ 1] |>|| ((divisor) -> divisor * divisor > n ?: 1 ?_ n % divisor == 0);

IsPrime(n) -> {?
    n < 2 ? _;
    n == 2 ? 1;
    FirstDivisor(n) * FirstDivisor(n) > n
};

primes := .IRANGE(1, 50) |>? IsPrime;

{= primes=primes, count=.LEN(primes) }
