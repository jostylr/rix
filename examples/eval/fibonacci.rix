## Fibonacci with ordinary recursion and a stack-safe tail-recursive form.

FibonacciRecursive(n) ->
    n <= 1 ?: n ?_ FibonacciRecursive(n - 1) + FibonacciRecursive(n - 2);

FibonacciTail(n, current, next) ->
    n <= 0 ?: current ?_ $(n - 1, next, current + next);

Fibonacci(n) -> FibonacciTail(n, 0, 1);

{=
    recursive10 = FibonacciRecursive(10),
    tailRecursive10 = Fibonacci(10),
    agree = FibonacciRecursive(10) == Fibonacci(10)
}
