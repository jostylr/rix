/**
plugins: [scene3d, tikz, gif]
**/

## Retained lit geometry and trajectory frames share Graphics with every exporter.
triangle := .scene3d.Mesh([[0,0,0],[1,0,0],[0,1,0]],[[1,2,3]],{= color="#2563eb",id="triangle" });
scene := .scene3d.Scene([triangle],{= lights=[.scene3d.AmbientLight("#ffffff",1)] });
snapshot := .scene3d.Snapshot(scene,{= size=[240,160],mode=:lit });
.Out("lit-scene.tikz", .tikz.Render(snapshot,{= standalone=1 }));

frame := t -> .Figure(.Graphics.Graphic([240,160],[
    .Graphics.Rectangle([0,0],[240,160],{= fill="#ffffff" }),
    .Graphics.Path([[20,140],[80,100],[140,60],[220,20]],{= stroke="#64748b",width=1 }),
    .Graphics.Circle([20+200*t,140-120*t],5,{= fill="#2563eb",id="trajectory-point" }),
    .Graphics.Text([10,20],"Retained trajectory: exact sampled state")
]),"Exact point moving along a retained trajectory","trajectory","An exact sample on the trajectory");
timeline := .Timeline.Sequence({=
    entries=[{: frame,[0,1/3,2/3,1] }],frameDurations=[1/4,1/2,1/2,3/4],title="Exact retained trajectory",
    tracks=[.Timeline.Track({= id="caption",kind=:caption,keyframes=[
        {= frame=1,value="Start: t = 0" }, {= frame=2,value="Sample: t = 1/3" },
        {= frame=3,value="Sample: t = 2/3" }, {= frame=4,value="End: t = 1" }
    ] })]
});
.Out("trajectory-frame.tikz",.tikz.Render(timeline,{= frame=2,standalone=1 }));
.Out("trajectory-frames.html",.Render(timeline,"gif-frames"));
## With an approved encoder, use .Out("trajectory.gif",timeline) as well.
timeline;
