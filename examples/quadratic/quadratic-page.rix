## Interactive exact quadratic rebasing page.
##
## The runner writes this declared page only when given --out=DIR.

.Plugin.Load("plot");

$$a := 1;
$$b := -3;
$$c := 2;
$$center := 1/2;
$$color := "#0c7b7f";
$$frozen := [];

$$view := {;
    av := $a;
    bv := $b;
    cv := $c;
    d := $center;
    currentColor := $color;
    frozenVersions := $frozen;
    P := x -> av*x^2 + bv*x + cv;
    slope := bv + 2*av*d;
    value := P(d);
    centerTerm := d < 0 ?? @"x + @{0 - d}" ?: @"x - @{d}";
    ## These symmetric bounds cover every value reachable by the sliders:
    ## |a| <= 5, |b| <= 8, |c| <= 8, and |center| <= 3.
    ## They keep the origin fixed at the centre of every rendered graph.
    plotDomain := [-6, 6];
    plotSeries := [{=
        coefficients=[slope, value - slope*d],
        label="linear part",
        stroke="#b45309",
        width=2
    }].Concat(frozenVersions.Map(version -> {=
        coefficients=version["coefficients"],
        label=version["label"],
        stroke=version["color"],
        width=2
    }));
    plot := .plot.Polynomial([av, bv, cv], plotDomain, {=
        size=[620, 320],
        yDomain=[-256, 256],
        label="quadratic",
        stroke=currentColor,
        series=plotSeries,
        ticks=[{= x=d, label=@"center = @{d}" }],
        marks=[{=
            point=[d, value],
            label=@"(@{d}, f(@{d}) = @{value})",
            style={= fill="#be123c", stroke="#fff", width=2 },
            labelStyle={= fill="#be123c", size=13 }
        }]
    });

    .Fragment([
        .Heading(1, "Quadratic rebasing"),
        .Paragraph(@"Explore f(x) = @{av}x² + @{bv}x + @{cv}, centered at x = @{d}. All values remain exact RiX rationals."),
        .ControlPanel({=
            title="Coefficients and center",
            description="Each slider recomputes the centered form immediately.",
            style={=
                kinds={= action={= variant="primary" } },
                ids={= ("clear-frozen")={= variant="danger" } }
            },
            controls=[
                .Controls.Slider($$a, -5:5, 1, "a"),
                .Controls.Slider($$b, -8:8, 1, "b"),
                .Controls.Slider($$c, -8:8, 1, "c"),
                .Controls.Slider($$center, -3:3, 1/2, "center"),
                .Controls.Choice($$color, [
                    {= value="#0c7b7f", label="teal" },
                    {= value="#7c3aed", label="violet" },
                    {= value="#be123c", label="crimson" },
                    {= value="#2563eb", label="blue" }
                ], "quadratic color"),
                .Controls.Action({=
                    id="freeze",
                    target=$$frozen,
                    action=versions -> versions ++ [{=
                        coefficients=[av, bv, cv],
                        color=currentColor,
                        label=@"frozen @{versions.Len() + 1}"
                    }],
                    label="Freeze quadratic"
                }),
                .Controls.Action({=
                    id="clear-frozen",
                    target=$$frozen,
                    action=versions -> [],
                    label="Clear frozen curves"
                })
            ]
        }),
        .Heading(2, "Centered form"),
        .Paragraph(@"f(x) = @{av}(@{centerTerm})² + @{slope}(@{centerTerm}) + @{value}"),
        .Heading(2, "Quadratic and linear part"),
        .Figure(plot, "The tick marks the selected center; the red point is (center, f(center))."),
        .Heading(2, "Exact synthetic division"),
        .Algebra.SyntheticDivision(d, [av, bv, cv]),
        .Algebra.SyntheticDivision(d, [av, bv + av*d])
    ])
};

## A static ordered comparison: each entry is one quadratic group and each
## group visits the same centers. A future grid/PDF renderer can recover that
## grouping from the scene origin metadata.
comicScene := (state, origin) -> {;
    av := state["a"];
    bv := state["b"];
    cv := state["c"];
    d := state["center"];
    P := x -> av*x^2 + bv*x + cv;
    slope := bv + 2*av*d;
    value := P(d);
    .Figure(.plot.Polynomial([av, bv, cv], [-6, 6], {=
        size=[360, 220],
        yDomain=[-256, 256],
        stroke=state["color"],
        series=[{= coefficients=[slope, value - slope*d], label="linear part", stroke="#b45309", width=2 }],
        ticks=[{= x=d, label=@"center = @{d}" }],
        marks=[{= point=[d, value], label=@"(@{d}, @{value})", style={= fill="#be123c" } }]
    }), @"Snapshot @{origin[:ordinal]} (group @{origin[:entry]}, center @{origin[:state]}): f(x) = @{av}x² + @{bv}x + @{cv}; center @{d}")
};

comic := .Snapshots({=
    title="Quadratic rebasing snapshots",
    caption="Three quadratic groups, each evaluated at centers −2, 0, and 2.",
    entries=[
        {: comicScene, [
            {= a=1, b=-3, c=2, center=-2, color="#0c7b7f" },
            {= a=1, b=-3, c=2, center=0, color="#0c7b7f" },
            {= a=1, b=-3, c=2, center=2, color="#0c7b7f" }
        ]},
        {: comicScene, [
            {= a=2, b=1, c=-3, center=-2, color="#7c3aed" },
            {= a=2, b=1, c=-3, center=0, color="#7c3aed" },
            {= a=2, b=1, c=-3, center=2, color="#7c3aed" }
        ]},
        {: comicScene, [
            {= a=-1, b=4, c=1, center=-2, color="#be123c" },
            {= a=-1, b=4, c=1, center=0, color="#be123c" },
            {= a=-1, b=4, c=1, center=2, color="#be123c" }
        ]}
    ]
});

.Out("comic.html", comic);
.Out("index.html", $view)
