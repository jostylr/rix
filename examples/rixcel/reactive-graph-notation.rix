## Concise ReactiveGraph definitions use the .RG secondary language.
## A $ prefix or the source keyword declares an externally settable node.

graph := `.RG.Init.Set:
    $source1 := 2
    source source2 := 3
    target1 := source1 + source2
    target2 := target1 * 4
`;

## A plain block extends the context-local default graph.
`.RG:
    target3 := target2 + source1
`;

graph.Node("source1").Set(10);
[graph.Get("target1"), graph.Get("target2"), graph.Get("target3")]
