## One observable FormulaSheet can drive any structured output.
## Edit the embedded grid in RiX Web or the notebook to move the point.

pointSheet := .FormulaSheet([[@{120}, @{40}]]);

.LiveView(pointSheet, @{
    .Fragment([
        .Sheet(source, {=
            title="Point formulas",
            axes=["point", "coordinate"]
        }),
        .Graphics.Graphic([260, 140], [
            .Graphics.Path(
                [[20, 120], [source[1,1], source[1,2]]],
                {= stroke="#4f46e5", width=3 }
            ),
            .Graphics.Circle(
                [source[1,1], source[1,2]],
                8,
                {= fill="#f97316" }
            )
        ])
    ])
})
