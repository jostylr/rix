{
  "format": "rixcel",
  "version": 2,
  "id": "budget",
  "shape": [2, 2],
  "view": {
    "title": "Budget example",
    "axes": ["region", "measure"],
    "axisLabels": [
      ["North", "South"],
      ["Revenue", "Cost"]
    ]
  },
  "defaultSlot": {
    "source": "_",
    "assignmentMode": ":=",
    "view": { "blank": true }
  },
  "events": [
    {
      "id": "budget:event:1",
      "sequence": 1,
      "type": "slot:set",
      "index": [1, 1],
      "source": "10",
      "assignmentMode": ":=",
      "view": {},
      "command": "document.SetSource(1, 1, \"10\", \":=\")"
    },
    {
      "id": "budget:event:2",
      "sequence": 2,
      "type": "slot:set",
      "index": [1, 2],
      "source": "grid[1,1] * 2",
      "assignmentMode": ":=",
      "view": {},
      "command": "document.SetSource(1, 2, \"grid[1,1] * 2\", \":=\")"
    },
    {
      "id": "budget:event:3",
      "sequence": 3,
      "type": "slot:set",
      "index": [2, 1],
      "source": "3",
      "assignmentMode": ":=",
      "view": {},
      "command": "document.SetSource(2, 1, \"3\", \":=\")"
    },
    {
      "id": "budget:event:4",
      "sequence": 4,
      "type": "slot:set",
      "index": [2, 2],
      "source": "grid[1,2] + grid[2,1]",
      "assignmentMode": ":=",
      "view": {},
      "command": "document.SetSource(2, 2, \"grid[1,2] + grid[2,1]\", \":=\")"
    }
  ],
  "cursor": 4,
  "drafts": []
}
