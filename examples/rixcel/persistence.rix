## RiXCel JSON stores source and rebuilds runtime state on import.

model := .FormulaSheet(
    {:2x2:
        @{10}, @{ grid[1,1] * 2};
        @{3},  @{ grid[1,2] + grid[2,1]}
    },
    {=
        id="budget",
        view={=
            title="Recompiled values",
            axes=["region", "measure"],
            axisLabels=[
                ["North", "South"],
                ["Revenue", "Cost"]
            ]
        }
    }
);

saved := .RiXCelExport(model);
restored := .RiXCelImport(saved);

.Fragment([
    .Heading(2, "Restored RiXCel document"),
    .Text(saved),
    .Sheet(restored)
])
