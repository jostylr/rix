## A formula-backed sheet owns deferred formulas rather than immediate values.
## grid, row, col, and index belong to the sheet's isolated formula context.

model := .FormulaSheet({:2x2:
    @{1}, @{ grid[1,1] + 1 };
    @{ grid[1,2] * 2 }, @{ grid[2,1] + 1 }
}, {= id="formula-example" });

.Sheet(model, {= title="Formula results" });

## Source is authoritative and compiles inside the FormulaSheet.
## The assignment mode is stored separately for future document semantics.
model.SetSource(1, 1, "10", ":=");
.Sheet(model, {= title="Recalculated results" })
