## A formula-backed sheet owns deferred formulas rather than immediate values.
## grid, near, row, col, and index belong to the isolated formula context.

model := .FormulaSheet({:2x2:
    @{1}, @{ near[0,-1] + 1 };
    @{ near[-1,1] * 2 }, @{ near[0,-1] + 1 }
}, {=
    id="formula-example",
    view={=
        axes=["region", "measure"],
        axisLabels=[["North", "South"], ["Revenue", "Cost"]]
    }
});

.Sheet(model, {= title="Formula results" });

## Source is authoritative and compiles inside the FormulaSheet.
## An omitted mode is :=; an explicit prefix is separated from the body.
model.SetSource(1, 1, "::= 10");
southCost := model.At({= region="South", measure="Cost" });
.Fragment([
    .Sheet(model, {= title="Recalculated results" }),
    .Text(@"South cost: @{southCost}")
])
