/**
plugins: [graph]
**/
## Problem: compute exact single-source shortest paths in a nonnegative
## weighted graph, recover a path to e, and verify the retained certificate.
graph := .graph.Weighted([:a,:b,:c,:d,:e], [
    [:a,:b,4],
    [:a,:c,1],
    [:c,:b,2],
    [:b,:d,1],
    [:c,:d,5],
    [:c,:e,8],
    [:d,:e,3]
]);
paths := graph.ShortestPaths(:a);
pathToE := paths.PathTo(:e);

paths[:distances][:a] == 0
    && paths[:distances][:b] == 3
    && paths[:distances][:c] == 1
    && paths[:distances][:d] == 4
    && paths[:distances][:e] == 7 ##@ == 1;
pathToE[:vertices].First() == :a && pathToE[:vertices].Last() == :e ##@ == 1;
pathToE[:weight] ##@ == 7;
paths.Verify() ##@ == 1;
{=
    problem = :singleSourceShortestPaths,
    source = paths[:source],
    distances = paths[:distances],
    predecessors = paths[:predecessors],
    settledOrder = paths[:settledOrder],
    pathToE = pathToE[:vertices],
    pathWeight = pathToE[:weight],
    unreachable = paths[:unreachable],
    certificateVerified = paths.Verify()
};
