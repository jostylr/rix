/**
plugins: [stern-brocot]
**/

## A generated-page showcase for exact Stern–Brocot exploration.
## The same pure RiX model also drives rix-web's prewritten page.

$$current := .frac(0, 1);
$$formulaSource := "x^2";
$$decimalPreview := _;
$$decimalDigits := 12;

SternBrocotBoxWidth(text) -> {>> 116, 32 + 11 * text.Len() };

SternBrocotRationalDecimalText(value, limit) -> {;
    text := value.ToRepeatingDecimal({=
        limit=limit,
        onLimit="trunc"
    });
    text.EndsWith("#0") ?: text.Slice(1, text.Len() - 1) ?_ text
};

SternBrocotDecimalText(value, limit) ->
    value ? :Rational
        ?: SternBrocotRationalDecimalText(value, limit)
        ?_ @"@{value}";

SternBrocotFractionText(fraction, showDecimals, limit) ->
    showDecimals == _
        ?: fraction.ToString()
        ?_ SternBrocotDecimalText(fraction.Rational(), limit);

SternBrocotDecimalLimit(value) ->
    (value > 0 && value == (value // 1) && value <= 80)
        ?: _
        ?_ "maximum decimal digits must be an integer from 1 to 80";

SternBrocotGlyph(text, x, y, fill, label) -> {;
    width := SternBrocotBoxWidth(text);
    .Graphics.Group([
        .Graphics.Text([x, y - 32], label, {=
            anchor="middle",
            size=12,
            weight="bold",
            fill="#7768a7"
        }),
        .Graphics.Rectangle([x - width / 2, y - 23], [width, 46], {=
            fill=fill,
            stroke="#4a4560",
            width=2,
            radius=11
        }),
        .Graphics.Text([x, y + 6], text, {=
            anchor="middle",
            size=18,
            weight="bold",
            fill="#172033"
        })
    ])
};

SternBrocotFormulaGlyph(text, x, y) -> {;
    width := {>> 260, 42 + 10 * text.Len() };
    .Graphics.Group([
        .Graphics.Text([x, y - 34], "FORMULA RESULT", {=
            anchor="middle",
            size=12,
            weight="bold",
            fill="#7768a7"
        }),
        .Graphics.Rectangle([x - width / 2, y - 24], [width, 48], {=
            fill="#f4efff",
            stroke="#6551c6",
            width=2,
            radius=11
        }),
        .Graphics.Text([x, y + 6], text, {=
            anchor="middle",
            size=16,
            weight="bold",
            fill="#2f236b"
        })
    ])
};

$$view := {;
    node := .sternBrocotDescribe($current);
    tree := .sternBrocotVisibleTree(node["current"], 2);
    formulaValue := .Eval($formulaSource, {= x=node["rational"] }, :fresh);
    tableRows := tree["nodes"].Map(record -> [
        record["role"],
        record["level"],
        record["fraction"],
        record["parent"]
    ]);
    currentFraction := node["current"];
    parent := node["parent"];
    children := node["children"];
    showDecimals := $decimalPreview;
    decimalLimit := $decimalDigits;
    currentText := SternBrocotFractionText(currentFraction, showDecimals, decimalLimit);
    parentText := parent == _ ?: _ ?_ SternBrocotFractionText(parent, showDecimals, decimalLimit);
    leftText := SternBrocotFractionText(children[1], showDecimals, decimalLimit);
    rightText := SternBrocotFractionText(children[2], showDecimals, decimalLimit);
    formulaResultText := showDecimals == _
        ?: @"@{formulaValue}"
        ?_ SternBrocotDecimalText(formulaValue, decimalLimit);
    formulaDisplay := @"@{$formulaSource} = @{formulaResultText}";
    currentWidth := SternBrocotBoxWidth(currentText);
    parentWidth := parent == _ ?: 0 ?_ SternBrocotBoxWidth(parentText);
    leftWidth := SternBrocotBoxWidth(leftText);
    rightWidth := SternBrocotBoxWidth(rightText);
    formulaWidth := {>> 260, 42 + 10 * formulaDisplay.Len() };
    graphicWidth := {>>
        600,
        currentWidth + 80,
        parentWidth + 80,
        leftWidth + rightWidth + 88,
        formulaWidth + 80
    };
    centerX := graphicWidth / 2;
    leftX := 32 + leftWidth / 2;
    rightX := graphicWidth - 32 - rightWidth / 2;
    currentY := parent == _ ?: 82 ?_ 148;
    childY := parent == _ ?: 232 ?_ 270;
    parentParts := parent == _
        ?: []
        ?_ [
            .Graphics.Path([[centerX, 70], [centerX, 120]], {= stroke="#aaa3c9", width=3 }),
            .Graphics.Action({=
                id="scene-parent",
                target=$$current,
                action=value -> value.F().SternBrocotParent(),
                label="Go to parent",
                children=[SternBrocotGlyph(parentText, centerX, 45, "#eeeafc", "PARENT")]
            })
        ];
    treeGraphic := .Graphics.Graphic([graphicWidth, 400], [
        .Graphics.Path([[centerX, currentY + 24], [leftX, childY - 24]], {= stroke="#aaa3c9", width=3 }),
        .Graphics.Path([[centerX, currentY + 24], [rightX, childY - 24]], {= stroke="#aaa3c9", width=3 })
    ] ++ parentParts ++ [
        SternBrocotGlyph(currentText, centerX, currentY, "#fff2be", "CURRENT"),
        .Graphics.Action({=
            id="scene-left",
            target=$$current,
            action=value -> value.F().SternBrocotChildren()[1],
            label="Go to left child",
            children=[SternBrocotGlyph(leftText, leftX, childY, "#e2f8ec", "LEFT CHILD")]
        }),
        .Graphics.Action({=
            id="scene-right",
            target=$$current,
            action=value -> value.F().SternBrocotChildren()[2],
            label="Go to right child",
            children=[SternBrocotGlyph(rightText, rightX, childY, "#e5edff", "RIGHT CHILD")]
        }),
        SternBrocotFormulaGlyph(formulaDisplay, centerX, 362)
    ]);

    hero := .Section({=
        level=1,
        title="Explore exact rationals",
        style={= variant="hero", width="full" },
        children=[
            .Paragraph("Navigate the Stern–Brocot tree, inspect each node's exact structure, and evaluate a RiX formula at the selected rational."),
            .Paragraph([.Link({= href="../showcases.html", children="← All RiX showcases" })])
        ]
    });

    navigation := .ControlPanel({=
        title="Move through the tree",
        description="Every step is computed from the exact structural fraction.",
        style={=
            layout="grid",
            columns=3,
            gap="compact",
            kinds={= action={= variant="primary" } },
            ids={=
                parent={= row=1, column=2 },
                left={= row=2, column=1 },
                right={= row=2, column=3 },
                root={= row=3, column=2, variant="quiet" }
            }
        },
        controls=[
            .Controls.Action({=
                id="parent",
                target=$$current,
                action=value -> {;
                    parent := value.F().SternBrocotParent();
                    parent == _ ?: value ?_ parent
                },
                label="↑ Parent",
                shortcut="ArrowUp",
                disabled=node["parent"] == _
            }),
            .Controls.Action({=
                id="left",
                target=$$current,
                action=value -> value.F().SternBrocotChildren()[1],
                label="← Left child",
                shortcut="ArrowLeft"
            }),
            .Controls.Action({=
                id="right",
                target=$$current,
                action=value -> value.F().SternBrocotChildren()[2],
                label="Right child →",
                shortcut="ArrowRight"
            }),
            .Controls.Action({=
                id="root",
                target=$$current,
                action=value -> .frac(0, 1),
                label="Root"
            })
        ]
    });

    comparison := .ControlPanel({=
        title="Jump and compare",
        description="Jump accepts a RiX fraction expression. Formula is plain RiX source evaluated with exact x in a fresh scope.",
        style={= gap="normal", all={= width="full" } },
        controls=[
            .Controls.Input({=
                id="jump",
                target=$$current,
                label="Jump to fraction",
                placeholder="3/5 or .frac(3, 5)"
            }),
            .Controls.Input({=
                id="formula",
                target=$$formulaSource,
                label="Formula in x",
                placeholder="x^2 - 1/2",
                inputMode=:text
            }),
            .Controls.Input({=
                id="decimal-digits",
                target=$$decimalDigits,
                label="Maximum decimal digits",
                help="Terminating decimals and short repeating cycles stay shorter.",
                placeholder="12",
                validate=SternBrocotDecimalLimit
            }),
            .Controls.Hold({=
                id="decimal-preview",
                target=$$decimalPreview,
                key="ArrowDown",
                pressed=1,
                released=_,
                label="Hold ↓ for decimal labels",
                help="Display only: the exact fraction and formula values do not change."
            })
        ]
    });

    exactData := .Section({=
        level=2,
        title="Exact node data",
        style={= variant="card", width="full" },
        children=[.Table({=
            columns=["Quantity", "Exact value"],
            options={= density="compact", variant="plain" },
            rows=[
                ["Current", node["current"]],
                ["Depth", node["depth"]],
                ["Path", node["path"]],
                ["Farey boundaries", node["boundaries"]],
                ["Continued fraction", node["continuedfraction"]],
                ["Convergents", node["convergents"]],
                ["Formula", $formulaSource],
                ["Formula result", formulaValue]
            ]
        })]
    });

    workbench := .Fragment({=
        style={= layout="split", gap="spacious", align="start", width="full" },
        children=[
            .Fragment({=
                style={= layout="stack", gap="normal" },
                children=[navigation, comparison]
            }),
            .Fragment({=
                style={= layout="stack", gap="normal" },
                children=[
                    .Figure({=
                        content=treeGraphic,
                        caption="Parent, current node, exact children, and the live formula result.",
                        style={= variant="card", width="full" }
                    }),
                    exactData
                ]
            })
        ]
    });

    records := .Section({=
        level=2,
        title="Portable visible-tree records",
        style={= variant="muted", width="full" },
        children=[
            .Paragraph("These renderer-neutral records are the exact model that a richer browser tree layout can consume."),
            .Table({=
                columns=["Role", "Relative level", "Fraction", "Parent"],
                options={= density="compact", variant="muted" },
                rows=tableRows
            })
        ]
    });

    .Fragment({=
        style={= layout="stack", gap="spacious", width="full" },
        children=[hero, workbench, records]
    })
};

.Out("index.html", $view)
