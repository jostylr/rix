/**
plugins: [stern-brocot]
**/

## A first generated-page slice for the exact Stern-Brocot explorer.
## The same pure RiX model also drives apps/webcalc's prewritten page.

SternBrocotGlyph(fraction, x, y, fill) -> .Graphics.Group([
    .Graphics.Rectangle([x - 45, y - 22], [90, 44], {=
        fill=fill,
        stroke="#334155",
        width=2,
        radius=8
    }),
    .Graphics.Text([x, y + 5], fraction.ToString(), {=
        anchor="middle",
        size=16,
        weight="bold",
        fill="#0f172a"
    })
]);

SternBrocotGraphic(node) -> {;
    current := node["current"];
    parent := node["parent"];
    children := node["children"];
    parentParts := parent == _
        ?: []
        ?_ [
            .Graphics.Path([[300, 82], [300, 138]], {= stroke="#64748b", width=2 }),
            SternBrocotGlyph(parent, 300, 60, "#e2e8f0")
        ];
    .Graphics.Graphic([600, 320], [
        .Graphics.Path([[300, 182], [180, 258]], {= stroke="#64748b", width=2 }),
        .Graphics.Path([[300, 182], [420, 258]], {= stroke="#64748b", width=2 })
    ] ++ parentParts ++ [
        SternBrocotGlyph(current, 300, 160, "#fef3c7"),
        SternBrocotGlyph(children[1], 180, 280, "#dcfce7"),
        SternBrocotGlyph(children[2], 420, 280, "#dbeafe")
    ])
};

$$current := .frac(0, 1);
$$Formula := x -> x^2;

$$view := {;
    node := .sternBrocotDescribe($current);
    tree := .sternBrocotVisibleTree(node["current"], 2);
    formulaValue := .sternBrocotEvaluate($Formula, node["current"]);
    tableRows := tree["nodes"].Map(record -> [
        record["role"],
        record["level"],
        record["fraction"],
        record["parent"]
    ]);

    .Fragment([
        .Heading(1, "RiX Stern–Brocot explorer"),
        .Paragraph("This standalone page is generated by RiX. Navigation, node records, continued fractions, convergents, and formula evaluation remain exact."),
        .ControlPanel({=
            title="Navigate and compare",
            description="The formula input accepts a callable such as x -> x^2 - 1/2. The jump input accepts a RiX value such as 3/5 or .frac(3, 5).",
            style={=
                kinds={= action={= variant="primary" } },
                ids={= reset={= variant="quiet" } }
            },
            controls=[
                .Controls.Action({=
                    id="parent",
                    target=$$current,
                    action=value -> {;
                        parent := value.F().SternBrocotParent();
                        parent == _ ?: value ?_ parent
                    },
                    label="Up"
                }),
                .Controls.Action({=
                    id="left",
                    target=$$current,
                    action=value -> value.F().SternBrocotChildren()[1],
                    label="Left child"
                }),
                .Controls.Action({=
                    id="right",
                    target=$$current,
                    action=value -> value.F().SternBrocotChildren()[2],
                    label="Right child"
                }),
                .Controls.Action({=
                    id="reset",
                    target=$$current,
                    action=value -> .frac(0, 1),
                    label="Root"
                }),
                .Controls.Input({=
                    id="jump",
                    target=$$current,
                    label="Jump to fraction",
                    placeholder="3/5"
                }),
                .Controls.Input({=
                    id="formula",
                    target=$$Formula,
                    label="Formula",
                    placeholder="x -> x^2"
                })
            ]
        }),
        .Figure(SternBrocotGraphic(node), "Parent, current node, and exact left/right children."),
        .Table({=
            columns=["Quantity", "Exact value"],
            rows=[
                ["Current", node["current"]],
                ["Depth", node["depth"]],
                ["Path", node["path"]],
                ["Farey boundaries", node["boundaries"]],
                ["Continued fraction", node["continuedfraction"]],
                ["Convergents", node["convergents"]],
                ["Formula result", formulaValue]
            ]
        }),
        .Heading(2, "Portable visible-tree records"),
        .Table({=
            columns=["Role", "Relative level", "Fraction", "Parent"],
            rows=tableRows
        })
    ])
};

.Out("index.html", $view)
