{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/publication-project.schema.json",
  "title": "Publication project semantic record",
  "description": "RiX map fields before conversion to tagged map/sequence records. Every value is retained output. The runtime validates unique safe paths and cross-document links; a book begins with index.qmd.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectType",
    "title",
    "documents"
  ],
  "properties": {
    "schema": {
      "const": "rix.publication-project@1"
    },
    "projectType": {
      "enum": [
        "website",
        "book",
        "default"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 4096
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "title",
          "value"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_.\\/-]+\\.qmd$"
          },
          "title": {
            "type": "string",
            "maxLength": 4096
          },
          "value": {
            "type": "object"
          }
        }
      }
    }
  }
}
