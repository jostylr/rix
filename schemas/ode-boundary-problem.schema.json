{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/ode-boundary-problem/v1.schema.json",
  "title": "RiX bounded shooting parameter family",
  "description": "Documentation schema for the portable record projection. Use the corresponding RiX checker to validate mathematical evidence.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "problem",
    "initialExpressions",
    "residuals",
    "shootingBox",
    "variables",
    "initialBounds",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "const": "rix.ode.boundary-problem@1"
    },
    "interpretation": {
      "const": "terminalResidualsOfParameterizedInitialStates"
    },
    "problem": {
      "$ref": "ode-problem.schema.json"
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16
    }
  }
}
