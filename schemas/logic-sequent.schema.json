{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/logic-sequent.schema.json",
  "title": "Bounded classical propositional sequent evidence",
  "description": "Semantic record. The runtime also validates formulas, complete rule replay, acyclicity and aggregate work/text bounds. Valid replay of an unresolved record is not a theorem.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "system",
    "checker",
    "left",
    "right",
    "options",
    "status",
    "complete",
    "countermodel",
    "nodes",
    "work"
  ],
  "properties": {
    "schema": {
      "const": "rix.logic.sequent@1"
    },
    "system": {
      "const": "classical-lk"
    },
    "checker": {
      "const": "classical-lk-replay@1"
    },
    "left": {
      "$ref": "#/$defs/context"
    },
    "right": {
      "$ref": "#/$defs/context"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxsteps",
        "maxnodes",
        "maxdepth",
        "maxtext"
      ],
      "properties": {
        "maxsteps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxnodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxdepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "maxtext": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 4194304
        }
      }
    },
    "status": {
      "enum": [
        "valid",
        "invalid",
        "unresolved"
      ]
    },
    "complete": {
      "enum": [
        null,
        1
      ]
    },
    "countermodel": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "atom",
          "truth"
        ],
        "additionalProperties": false,
        "properties": {
          "atom": {
            "type": "string",
            "maxLength": 256
          },
          "truth": {
            "enum": [
              0,
              1
            ]
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "id",
          "depth",
          "left",
          "right",
          "rule",
          "principal",
          "premises",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "left": {
            "$ref": "#/$defs/context"
          },
          "right": {
            "$ref": "#/$defs/context"
          },
          "rule": {
            "enum": [
              "identity",
              "top-left",
              "top-right",
              "bottom-left",
              "bottom-right",
              "not-left",
              "not-right",
              "and-left",
              "and-right",
              "or-left",
              "or-right",
              "implies-left",
              "implies-right",
              "iff-left",
              "iff-right",
              "open",
              "budget"
            ]
          },
          "principal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "premises": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            }
          },
          "status": {
            "enum": [
              "valid",
              "invalid",
              "unresolved"
            ]
          },
          "reason": {
            "enum": [
              null,
              "step-limit",
              "node-limit",
              "depth-limit",
              "text-limit"
            ]
          }
        }
      }
    },
    "work": {
      "type": "object",
      "required": [
        "steps",
        "nodes",
        "text",
        "unresolved"
      ],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formula"
      }
    },
    "formula": {
      "type": "object",
      "required": [
        "schema",
        "valuekind",
        "kind"
      ],
      "properties": {
        "schema": {
          "const": "rix.logic.formula@1"
        },
        "valuekind": {
          "const": "logicFormula"
        },
        "kind": {
          "enum": [
            "atom",
            "top",
            "bottom",
            "not",
            "and",
            "or",
            "implies",
            "iff"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operand": {
          "$ref": "#/$defs/formula"
        },
        "left": {
          "$ref": "#/$defs/formula"
        },
        "right": {
          "$ref": "#/$defs/formula"
        }
      }
    }
  }
}
