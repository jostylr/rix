{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/rational-box/v1.schema.json",
  "title": "RiX exact rational box v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "dimension", "variables", "axes"],
  "properties": {
    "schema": { "const": "rix.numerics.rational-box@1" },
    "dimension": { "type": "integer", "minimum": 1, "maximum": 16 },
    "variables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "axes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "range-set.schema.json" }
    }
  }
}
