{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/rixcel-document/v3.schema.json",
  "title": "Canonical RiXCel document v3",
  "description": "Sparse source-authoritative structural history. Runtime parsing/replay validates shape products, active-prefix dimensions, unique edits, canonical commands, rewrites and stable IDs. Schema validation does not execute formulas. Versions 0\u20132 migrate in the runtime.",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "initialShape",
    "shape",
    "view",
    "defaultSlot",
    "events",
    "cursor",
    "drafts"
  ],
  "properties": {
    "format": {
      "const": "rixcel"
    },
    "version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "initialShape": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "shape": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "view": {
      "type": "object",
      "properties": {
        "regions": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/regionBounds"
          }
        },
        "formats": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/regionBounds"
              },
              {
                "type": "object",
                "required": [
                  "style"
                ],
                "properties": {
                  "style": {
                    "$ref": "#/$defs/formatStyle"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "defaultSlot": {
      "type": "object",
      "required": [
        "source",
        "assignmentMode",
        "view"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "assignmentMode": {
          "enum": [
            "=",
            ":=",
            "~=",
            "::=",
            "~~="
          ]
        },
        "view": {
          "type": "object"
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sequence",
          "type",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "enum": [
              "slot:set",
              "slot:batch",
              "view:axis-label",
              "axis:insert",
              "view:region",
              "view:format"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "axis": {
            "type": "integer",
            "minimum": 1
          },
          "coordinate": {
            "type": "integer",
            "minimum": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "assignmentMode": {
            "enum": [
              "=",
              ":=",
              "~=",
              "::=",
              "~~="
            ]
          },
          "view": {
            "type": "object"
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source",
                "assignmentMode",
                "view",
                "index"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "assignmentMode": {
                  "enum": [
                    "=",
                    ":=",
                    "~=",
                    "::=",
                    "~~="
                  ]
                },
                "view": {
                  "type": "object"
                },
                "index": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          },
          "start": {
            "anyOf": [
              {
                "$ref": "#/$defs/boundsIndex"
              },
              {
                "type": "null"
              }
            ]
          },
          "end": {
            "anyOf": [
              {
                "$ref": "#/$defs/boundsIndex"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "style": {
            "$ref": "#/$defs/formatStyle"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "slot:set"
                }
              }
            },
            "then": {
              "required": [
                "index",
                "source",
                "assignmentMode",
                "view"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "slot:batch"
                }
              }
            },
            "then": {
              "required": [
                "edits"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "view:axis-label"
                }
              }
            },
            "then": {
              "required": [
                "axis",
                "coordinate",
                "label"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "axis:insert"
                }
              }
            },
            "then": {
              "required": [
                "axis",
                "coordinate",
                "count"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "view:region"
                }
              }
            },
            "then": {
              "required": [
                "name",
                "start",
                "end"
              ],
              "anyOf": [
                {
                  "properties": {
                    "start": {
                      "type": "null"
                    },
                    "end": {
                      "type": "null"
                    }
                  }
                },
                {
                  "properties": {
                    "start": {
                      "$ref": "#/$defs/boundsIndex"
                    },
                    "end": {
                      "$ref": "#/$defs/boundsIndex"
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "view:format"
                }
              }
            },
            "then": {
              "required": [
                "start",
                "end",
                "style"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/boundsIndex"
                },
                "end": {
                  "$ref": "#/$defs/boundsIndex"
                }
              }
            }
          }
        ]
      }
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "source",
          "assignmentMode",
          "kind",
          "message"
        ],
        "properties": {
          "index": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "source": {
            "type": "string"
          },
          "assignmentMode": {
            "enum": [
              "=",
              ":=",
              "~=",
              "::=",
              "~~="
            ]
          },
          "kind": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "boundsIndex": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "formatStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bold": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "italic": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right",
            null
          ]
        },
        "numberFormat": {
          "enum": [
            "exact",
            "decimal",
            null
          ]
        },
        "precision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "regionBounds": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/boundsIndex"
        },
        "end": {
          "$ref": "#/$defs/boundsIndex"
        }
      }
    }
  }
}
