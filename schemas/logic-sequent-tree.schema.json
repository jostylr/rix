{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/logic-sequent-tree.schema.json",
  "title": "Bounded sequent tree rendering metadata",
  "type": "object",
  "required": [
    "schema",
    "status",
    "checker",
    "omitted",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "rix.logic.sequent-tree@1"
    },
    "status": {
      "enum": [
        "valid",
        "invalid",
        "unresolved"
      ]
    },
    "checker": {
      "const": "classical-lk-replay@1"
    },
    "omitted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "source": {
      "$ref": "logic-sequent.schema.json"
    }
  }
}
