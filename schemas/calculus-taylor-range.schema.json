{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/calculus-taylor-range/v1.schema.json",
  "title": "RiX checked second-derivative Taylor range v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "strategy", "status", "certified", "domainStatus", "range", "curvature", "partitions", "evidence"],
  "properties": {
    "schema": { "const": "rix.numerics.calculus-taylor-range@1" },
    "strategy": { "const": "secondDerivativeTaylor" },
    "status": { "enum": ["enclosed", "unknown"] },
    "certified": { "type": "boolean" },
    "domainStatus": { "enum": ["allDefined", "unresolved"] },
    "range": { "$ref": "range-set.schema.json" },
    "curvature": { "enum": ["convex", "concave", "affine", "unknown", "mixed"] },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input", "midpoint", "radius", "midpointRange", "midpointDerivativeRange", "secondDerivativeRange", "linearRange", "remainderRange", "enclosure", "curvature"]
      }
    },
    "evidence": {}
  }
}
