{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/rixcel-workbook/v1.schema.json",
  "title": "Canonical RiXCel workbook v1",
  "description": "Document-owned definitions and explicit import references. Runtime validates unique IDs, references, coordinates and work limits. No executable provider or schedule is serialized. Parsing does not evaluate formulas.",
  "type": "object",
  "required": [
    "format",
    "version",
    "documents",
    "external"
  ],
  "properties": {
    "format": {
      "const": "rixcel-workbook"
    },
    "version": {
      "const": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "document",
          "names",
          "exports",
          "imports"
        ],
        "properties": {
          "document": {
            "$ref": "rixcel-document-v3.schema.json"
          },
          "names": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "oneOf": [
                {
                  "required": [
                    "index"
                  ],
                  "properties": {
                    "index": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "source"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 65536
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "exports": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "oneOf": [
                {
                  "required": [
                    "index"
                  ],
                  "properties": {
                    "index": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "source"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 65536
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "imports": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "oneOf": [
                {
                  "required": [
                    "document",
                    "export"
                  ],
                  "properties": {
                    "document": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "export": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "external"
                  ],
                  "properties": {
                    "external": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "external": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "metadata"
        ],
        "properties": {
          "value": {
            "type": "string",
            "description": "Inert mathematical JSON snapshot; decoded and bounded by the shared codec."
          },
          "metadata": {
            "type": "object",
            "required": [
              "source",
              "version"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
