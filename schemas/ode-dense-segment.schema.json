{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/ode-dense-segment/v1.schema.json",
  "title": "RiX ODE dense-output or validated-tube segment v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "valueKind",
    "segmentKind",
    "method",
    "index",
    "tStart",
    "tEnd",
    "stateStart",
    "interpolation"
  ],
  "properties": {
    "schema": { "const": "rix.ode.dense-segment@1" },
    "valueKind": { "const": "odeDenseSegment" },
    "segmentKind": {
      "enum": ["approximate", "validatedTube", "unresolvedTube"]
    },
    "method": { "enum": ["euler", "rk4", "adaptiveRK4", "validatedPicard"] },
    "index": { "type": "integer", "minimum": 1 },
    "stateStart": { "type": "array", "minItems": 1 },
    "stateEnd": { "type": ["array", "null"] },
    "interpolation": { "enum": ["linear", "intervalTube", "none"] },
    "certified": { "type": ["boolean", "null"] }
  }
}
