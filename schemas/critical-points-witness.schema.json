{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/critical-points-witness/v1.schema.json",
  "title": "RiX complete critical-points witness v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "functionGraph", "derivativeGraph", "searchSet", "isolatingComponents", "complete", "evidence"],
  "properties": {
    "schema": { "const": "rix.calculus.critical-points-witness@1" },
    "functionGraph": { "type": "string", "minLength": 1 },
    "derivativeGraph": { "type": "string", "minLength": 1 },
    "searchSet": { "$ref": "range-set.schema.json" },
    "isolatingComponents": {
      "type": "array",
      "items": { "$ref": "range-set.schema.json" }
    },
    "complete": { "const": true },
    "endpointPolicy": { "enum": ["open", "closed", "leftClosed", "rightClosed"] },
    "evidence": {}
  }
}
