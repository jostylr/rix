{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/ode-solution/v1.schema.json",
  "title": "RiX ODE solution v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "valueKind",
    "problem",
    "method",
    "status",
    "classification",
    "stateNames",
    "interval",
    "points",
    "segments",
    "work",
    "diagnostics"
  ],
  "properties": {
    "schema": { "const": "rix.ode.solution@1" },
    "valueKind": { "const": "odeSolution" },
    "problem": { "$ref": "ode-problem.schema.json" },
    "method": { "enum": ["euler", "rk4", "adaptiveRK4", "validatedPicard", "validatedTaylor2"] },
    "status": { "enum": ["approximate", "validated", "partial"] },
    "classification": {
      "enum": ["fixedStepTrajectory", "adaptiveTrajectory", "adaptiveBudgetExhausted", "certifiedTube", "unresolvedTube", "certifiedTaylorTube", "unresolvedTaylorTube"]
    },
    "stateNames": { "type": "array", "minItems": 1 },
    "points": { "type": "array", "minItems": 1 },
    "segments": {
      "type": "array",
      "items": { "$ref": "ode-dense-segment.schema.json" }
    },
    "certified": { "type": ["boolean", "null"] },
    "diagnostics": { "type": "array" }
  }
}
