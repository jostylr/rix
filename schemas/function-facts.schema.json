{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/function-facts/v1.schema.json",
  "title": "RiX trusted function facts v1",
  "description": "Portable mathematical facts published by the plugin that owns a function. Certification requires the runtime's non-portable trusted-provider seal; this record alone is not authority.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema", "version", "functionId", "operations", "domain",
    "globalRange", "period", "symmetry", "monotonicity",
    "singularities", "certified", "evidenceLevel", "evidence"
  ],
  "properties": {
    "schema": { "const": "rix.numerics.function-facts@1" },
    "version": { "const": 1 },
    "functionId": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["domain", "globalRange", "period", "symmetry", "monotonicity", "singularities"]
      }
    },
    "domain": { "type": "object" },
    "globalRange": { "type": "object" },
    "period": { "type": "object" },
    "symmetry": { "type": "object" },
    "monotonicity": { "type": "object" },
    "singularities": { "type": "object" },
    "certified": { "type": "boolean" },
    "evidenceLevel": { "const": "trustedCapability" },
    "evidence": { "type": "object" }
  }
}
