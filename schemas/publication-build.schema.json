{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rix.ratmath.com/schema/publication-build.schema.json",
  "title": "RiX publication build manifest",
  "type": "object",
  "required": [
    "schema",
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "rix.publication-build@1"
    },
    "out": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_./-]+$"
    },
    "defaultProfile": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": [
                "html",
                "markdown",
                "quarto",
                "latex",
                "pdf",
                "svg",
                "png",
                "tikz",
                "gif",
                "gif-frames",
                "canvas",
                "gltf",
                "text",
                "bundle"
              ]
            }
          },
          "plugins": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "live": {
            "type": "boolean"
          },
          "plan": {
            "type": "object"
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "maxDocuments": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512,
            "default": 32
          },
          "maxJobs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096,
            "default": 256
          },
          "maxTargets": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128,
            "default": 8
          },
          "maxSourceBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32000000,
            "default": 2000000
          },
          "maxOutputBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024000000,
            "default": 64000000
          },
          "maxJobMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 480000,
            "default": 30000
          },
          "maxBuildMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4800000,
            "default": 300000
          },
          "maxDependencies": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096,
            "default": 256
          },
          "debounceMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2400,
            "default": 150
          },
          "pollMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4000,
            "default": 250
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "title": {
            "type": "string",
            "maxLength": 1000
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_./-]+$"
            }
          },
          "assetRoots": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "anyOf": [
                {
                  "const": "."
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_./-]+$"
                }
              ]
            }
          },
          "assetPackages": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "const": "."
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_./-]+$"
                }
              ]
            }
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 100000
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
