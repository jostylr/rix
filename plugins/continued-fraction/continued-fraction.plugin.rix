/**
id: continued-fraction
description: Finite and lazy simple continued fractions with exact convergents and certified enclosures.
kind: rix
mount: continuedFraction
aliases: [cf]
exports: [Finite, Lazy, Periodic, Sqrt2, FromRational, Coefficient, CoefficientResult, Coefficients, Convergent, Convergents, Enclosure, ErrorInterval, QuadraticForm, BestApproximation, Translate, Reciprocal, ZeroStatus, Record]
groups: [Numerics, Exact]
permissions: []
requires: [rix.oracle@1]
provides: [rix.continued-fraction@1, rix.refinable@1, rix.enclosable-real@1]
schemas: [rix.continued-fraction.finite@1, rix.continued-fraction.lazy@1, rix.continued-fraction.gosper@1, rix.continued-fraction.coefficient-result@1, rix.continued-fraction.arithmetic-real@1, rix.continued-fraction.quadratic-form@1, rix.continued-fraction.best-approximation@1, rix.continued-fraction.zero-status@1]
snapshot: false
deterministic: true
defaultEnabled: false
**/

CFOption(options, key, fallback) -> options.Has(key) ?: options[key] ?_ fallback;

CFRequireIndex(value, label) -> {;
    index = value ~!: :Integer;
    index >= 0 ?: index ?_ .Error(@"@{label} must be a nonnegative Integer");
};

CFRequireCount(value, label) -> {;
    count = value ~!: :Integer;
    count >= 1 ?: count ?_ .Error(@"@{label} must be a positive Integer");
};

CFRequirePositiveDenominator(value, label) -> CFRequireCount(value, label);

CFValidateCoefficient(value, index) -> {;
    coefficient = value ~!: :Integer;
    valid = index == 0 ?: 1 ?_ coefficient > 0;
    valid
      ?: coefficient
      ?_ .Error(@"Continued-fraction coefficient @{index} must be a positive Integer");
};

CFCoefficientResult(real, index, options ?= {= }) -> {;
    n = CFRequireIndex(index, "Continued-fraction coefficient index");
    outOfRange = real[:kind] == :finite ?: n >= real[:length] ?_ _;
    outOfRange
      ?: .ImmutableValue({=
          valueKind=:continuedFractionCoefficientResult,
          schema="rix.continued-fraction.coefficient-result@1",
          status=:end,
          index=n,
          coefficient=_,
          certified=1,
          reason=:finiteStreamEnded,
          work={= calls=0, inputs=0, outputs=real[:length] }
      })
      ?_ (real[:kind] == :gosper
           ?: real[:coefficientResultFunction](n, options)
           ?_ .ImmutableValue({=
               valueKind=:continuedFractionCoefficientResult,
               schema="rix.continued-fraction.coefficient-result@1",
               status=:coefficient,
               index=n,
               coefficient=CFValidateCoefficient(n |> real[:coefficientFunction], n),
               certified=1,
               reason=:sourceCoefficient,
               work={= calls=1, inputs=1, outputs=n+1 }
           }));
};

CFCoefficientAt(real, index, options ?= {= }) -> {;
    result = CFCoefficientResult(real, index, options);
    result[:status] == :coefficient
      ?: result[:coefficient]
      ?_ (result[:status] == :end
           ?: .Error(@"Continued-fraction stream has no coefficient at index @{result[:index]}")
           ?_ .Error(@"Continued-fraction coefficient @{result[:index]} is unresolved: @{result[:reason]}"));
};

CFCoefficients(real, count ?= _, options ?= {= }) -> {;
    amount = count == _
      ?: (real[:kind] == :finite ?: real[:length] ?_ .Error("Lazy continued fractions require an explicit coefficient count"))
      ?_ CFRequireIndex(count, "Continued-fraction coefficient count");
    exceedsFinite = real[:kind] == :finite ?: amount > real[:length] ?_ _;
    exceedsFinite
      ?: .Error("Requested coefficient count exceeds the finite continued fraction")
      ?_ _;
    values = [];
    {@ index = 0; index < @amount; {;
        @values ~= @values.Push(CFCoefficientAt(@real, index, @options));
    }; index += 1 };
    values;
};

CFConvergentState(real, count) -> {;
    amount = CFRequireCount(count, "Continued-fraction convergent count");
    exceedsFinite = real[:kind] == :finite ?: amount > real[:length] ?_ _;
    exceedsFinite
      ?: .Error("Requested convergent exceeds the finite continued fraction")
      ?_ _;
    p0 = 0;
    p1 = 1;
    q0 = 1;
    q1 = 0;
    {@ index = 0; index < @amount; {;
        coefficient = CFCoefficientAt(@real, index);
        nextP = coefficient * @p1 + @p0;
        nextQ = coefficient * @q1 + @q0;
        @p0 ~= @p1;
        @p1 ~= nextP;
        @q0 ~= @q1;
        @q1 ~= nextQ;
    }; index += 1 };
    {=
        count = amount,
        previous = q0 == 0 ?: _ ?_ p0 / q0,
        current = q1 == 0 ?: _ ?_ p1 / q1,
        p0 = p0,
        p1 = p1,
        q0 = q0,
        q1 = q1
    };
};

CFConvergent(real, count) -> CFConvergentState(real, count)[:current];

CFConvergents(real, count ?= _) -> {;
    amount = count == _
      ?: (real[:kind] == :finite ?: real[:length] ?_ .Error("Lazy continued fractions require an explicit convergent count"))
      ?_ CFRequireIndex(count, "Continued-fraction convergent count");
    results = [];
    {@ index = 1; index <= @amount; {;
        @results ~= @results.Push(CFConvergent(@real, index));
    }; index += 1 };
    results;
};

CFWitness(real, count) -> {;
    state = CFConvergentState(real, count);
    interval = state[:previous]:state[:current];
    {=
        count = state[:count],
        previous = state[:previous],
        convergent = state[:current],
        interval = interval,
        width = interval.Width(),
        p0 = state[:p0],
        p1 = state[:p1],
        q0 = state[:q0],
        q1 = state[:q1]
    };
};

CFNextWitness(real, witness) -> {;
    index = witness[:count];
    coefficient = CFCoefficientAt(real, index);
    nextP = coefficient * witness[:p1] + witness[:p0];
    nextQ = coefficient * witness[:q1] + witness[:q0];
    next = nextP / nextQ;
    interval = witness[:convergent]:next;
    {=
        count = index + 1,
        previous = witness[:convergent],
        convergent = next,
        interval = interval,
        width = interval.Width(),
        p0 = witness[:p1],
        p1 = nextP,
        q0 = witness[:q1],
        q1 = nextQ
    };
};

CFEnclosureAt(real, count ?= _) -> {;
    real[:kind] == :gosper
      ?: (count == _
           ?: CFGosperProtocolEnclosure(real,{= },:enclose)[:interval]
           ?_ CFWitness(real,CFRequireCount(count,"Continued-fraction enclosure count"))[:interval])
      ?_ (real[:kind] == :finite
           ?: {;
               exact = CFConvergent(@real, @count == _ ?: @real[:length] ?_ @count);
               exact:exact;
           }
           ?_ CFWitness(real, count == _ ?: 2 ?_ CFRequireCount(count, "Continued-fraction enclosure count"))[:interval]);
};

CFErrorInterval(real, count) -> {;
    convergent = CFConvergent(real, count);
    enclosure = CFEnclosureAt(real, real[:kind] == :finite ?: _ ?_ count);
    (enclosure.Low() - convergent):(enclosure.High() - convergent);
};

CFCapabilities(real) -> {;
    lazy = real[:kind] != :finite;
    gosper = real[:kind] == :gosper;
    {=
        valueKind = :numericsCapabilities,
        schema = "rix.numerics.capabilities@1",
        backend = :continuedFraction,
        representation = gosper
          ?: :nativeGosperContinuedFraction
          ?_ (lazy ?: :lazySimpleContinuedFraction ?_ :finiteSimpleContinuedFraction),
        denotation = :singleton,
        operations = [:enclose, :refine],
        evidenceLevels = gosper
          ?: [:constructorGuarantee, :proof]
          ?_ [lazy ?: real[:evidenceLevel] ?_ :proof],
        certified = 1,
        arbitraryRefinement = 1,
        deterministic = 1,
        minimumWidth = 0,
        maxCalls = lazy ?: 100000 ?_ 0,
        maxIterations = lazy ?: 100000 ?_ 0
    };
};

CFRecord(real) -> {=
    valueKind = :continuedFraction,
    schema = real[:schema],
    kind = real[:kind],
    name = real[:name],
    coefficients = real[:kind] == :finite ?: real[:coefficients] ?_ _,
    length = real[:kind] == :finite ?: real[:length] ?_ _,
    prefix = real[:prefix],
    period = real[:period],
    transducer = real[:transducer],
    operation = real[:operation],
    initialForm = real[:initialForm],
    initialEnclosure = real[:kind] == :gosper ?: _ ?_ real[:initialWitness][:interval],
    evidence = real[:evidence],
    certified = 1
};

CFAttachProtocol(real) -> {;
    real._proto = {=
        Coefficient = (self, index, options ?= {= }) -> CFCoefficientAt(self, index, options),
        CoefficientResult = (self, index, options ?= {= }) -> CFCoefficientResult(self, index, options),
        Coefficients = (self, count ?= _, options ?= {= }) -> CFCoefficients(self, count, options),
        Convergent = (self, count) -> CFConvergent(self, count),
        Convergents = (self, count ?= _) -> CFConvergents(self, count),
        Value = (self) -> self[:kind] == :finite ?: CFConvergent(self, self[:length]) ?_ .Error("Lazy continued fractions do not have a finite exact Value"),
        Enclosure = (self, count ?= _) -> CFEnclosureAt(self, count),
        ErrorInterval = (self, count) -> CFErrorInterval(self, count),
        QuadraticForm = (self) -> CFQuadraticForm(self),
        BestApproximation = (self, maxDenominator, options ?= {= }) -> CFBestApproximation(self, maxDenominator, options),
        Translate = (self, offset, options ?= {= }) -> CFTranslate(self, offset, options),
        Reciprocal = (self, options ?= {= }) -> CFReciprocal(self, options),
        ZeroStatus = (self, options ?= {= }) -> CFZeroStatus(self, options),
        Record = (self) -> CFRecord(self),
        Enclose = (self, request ?= {= }) -> self[:kind] == :gosper
          ?: CFGosperProtocolEnclosure(self, request, :enclose)
          ?_ CFProtocolEnclosure(self, request, :enclose),
        Refine = (self, request ?= {= }) -> self[:kind] == :gosper
          ?: CFGosperProtocolEnclosure(self, request, :refine)
          ?_ CFProtocolEnclosure(self, request, :refine),
        NumericsCapabilities = (self) -> CFCapabilities(self)
    };
    .ImmutableValue(real);
};

CFFinite(coefficients, options ?= {= }) -> {;
    length = coefficients.Len();
    length >= 1 ?: _ ?_ .Error("Finite continued fractions require at least one coefficient");
    exactCoefficients = [];
    {@ index = 0; index < @length; {;
        @exactCoefficients ~= @exactCoefficients.Push(CFValidateCoefficient((@coefficients)[index + 1], index));
    }; index += 1 };
    coefficientFunction = (index) -> (@exactCoefficients)[index + 1];
    provisional = {=
        valueKind = :continuedFraction,
        schema = "rix.continued-fraction.finite@1",
        kind = :finite,
        name = CFOption(options, "name", :finite),
        coefficients = exactCoefficients,
        length = length,
        coefficientFunction = coefficientFunction,
        evidenceLevel = :proof,
        evidence = CFOption(options, "evidence", {= kind=:finiteEvaluation, property=:exactRationalValue })
    };
    exact = CFConvergent(provisional, length) ~!: :Rational;
    provisional["initialwitness"] = {=
        count=length,
        previous=exact,
        convergent=exact,
        interval=exact:exact,
        width=0,
        p0=exact.Numerator(), p1=exact.Numerator(),
        q0=exact.Denominator(), q1=exact.Denominator()
    };
    CFAttachProtocol(provisional);
};

CFLazy(coefficientFunction, options ?= {= }) -> {;
    provisional = {=
        valueKind = :continuedFraction,
        schema = "rix.continued-fraction.lazy@1",
        kind = CFOption(options, "kind", :lazy),
        name = CFOption(options, "name", :lazy),
        coefficientFunction = coefficientFunction,
        prefix = CFOption(options, "prefix", _),
        period = CFOption(options, "period", _),
        evidenceLevel = CFOption(options, "evidencelevel", :constructorGuarantee),
        evidence = CFOption(options, "evidence", {=
            kind=:declaredSimpleContinuedFraction,
            property=:positiveTailCoefficients
        })
    };
    provisional["initialwitness"] = CFWitness(provisional, 2);
    CFAttachProtocol(provisional);
};

CFPeriodic(prefix, period, options ?= {= }) -> {;
    prefixLength = prefix.Len();
    periodLength = period.Len();
    prefixLength >= 1 ?: _ ?_ .Error("Periodic continued fractions require a nonempty prefix");
    periodLength >= 1 ?: _ ?_ .Error("Periodic continued fractions require a nonempty period");
    exactPrefix = CFCoefficients(CFFinite(prefix), prefixLength);
    exactPeriod = [];
    {@ index = 0; index < @periodLength; {;
        @exactPeriod ~= @exactPeriod.Push(CFValidateCoefficient((@period)[index + 1], index + 1));
    }; index += 1 };
    rule = (index) -> index < @prefixLength
      ?: (@exactPrefix)[index + 1]
      ?_ (@exactPeriod)[((index - @prefixLength) % @periodLength) + 1];
    CFLazy(rule, {=
        kind = :periodic,
        name = CFOption(options, "name", :periodic),
        prefix = exactPrefix,
        period = exactPeriod,
        evidenceLevel = CFOption(options, "evidencelevel", :constructorGuarantee),
        evidence = CFOption(options, "evidence", {=
            kind=:periodicSimpleContinuedFraction,
            property=:positiveRepeatingTail
        })
    });
};

CFSqrt2() -> CFPeriodic([1], [2], {=
    name = :sqrt2,
    evidenceLevel = :proof,
    evidence = {=
        kind=:periodicQuadraticIrrational,
        property=:squareEqualsTwo,
        equation="x = 1 + 1/(1+x)"
    }
});

CFFromRational(value, options ?= {= }) -> {;
    exact = value ~!: :Rational;
    CFFinite(exact.ToContinuedFraction(), {= name=CFOption(options, "name", :rational) });
};

CFConstruct(value, options ?= {= }) -> {;
    alreadyContinuedFraction = value ? :Map ?: value[:valueKind] == :continuedFraction ?_ _;
    alreadyContinuedFraction
      ?: value
      ?_ (value ? :Array ?: CFFinite(value, options) ?_ CFFromRational(value, options));
};

CFRequireCoefficientStream(real, label ?= "Continued-fraction operation") -> {;
    valid = (real ? :Map) && real[:valueKind] == :continuedFraction && real[:kind] != :arithmetic;
    valid ?: real ?_ .Error(@"@{label} requires a finite, lazy, or periodic coefficient stream");
};

CFIntegerGcd(left, right) -> {;
    a := (left ~!: :Integer).Abs();
    b := (right ~!: :Integer).Abs();
    {@ step=1; @b != 0; {; remainder=@a % @b; @a ~= @b; @b ~= remainder; }; step += 1 };
    a;
};

CFGosperNormalize(values) -> {;
    content := 0;
    {@ index=1; index<=@values.Len(); {;
        @content ~= CFIntegerGcd(@content, @values[index]);
    }; index+=1 };
    normalized = content > 1
      ?: values.Map((value)->value // @content)
      ?_ values;
    denominatorStart = normalized.Len() == 8 ?: 5 ?_ 3;
    denominatorSign := 0;
    {@ index=@denominatorStart; index<=@normalized.Len() && @denominatorSign==0; {;
        value = @normalized[index];
        @denominatorSign ~= value < 0 ?: -1 ?_ (value > 0 ?: 1 ?_ 0);
    }; index+=1 };
    denominatorSign < 0
      ?: normalized.Map((value)->-value)
      ?_ normalized;
};

CFGosperForm4(state) -> {=
    a=state[1], b=state[2], c=state[3], d=state[4]
};

CFGosperForm8(state) -> {=
    a=state[1], b=state[2], c=state[3], d=state[4],
    e=state[5], f=state[6], g=state[7], h=state[8]
};

CFGosperInput4(state, coefficient) -> CFGosperNormalize([
    coefficient*state[1]+state[2],
    state[1],
    coefficient*state[3]+state[4],
    state[3]
]);

CFGosperOutput4(state, coefficient) -> CFGosperNormalize([
    state[3], state[4],
    state[1]-coefficient*state[3],
    state[2]-coefficient*state[4]
]);

CFGosperInputX8(state, coefficient) -> CFGosperNormalize([
    coefficient*state[1]+state[3], coefficient*state[2]+state[4], state[1], state[2],
    coefficient*state[5]+state[7], coefficient*state[6]+state[8], state[5], state[6]
]);

CFGosperInputY8(state, coefficient) -> CFGosperNormalize([
    coefficient*state[1]+state[2], state[1], coefficient*state[3]+state[4], state[3],
    coefficient*state[5]+state[6], state[5], coefficient*state[7]+state[8], state[7]
]);

CFGosperOutput8(state, coefficient) -> CFGosperNormalize([
    state[5], state[6], state[7], state[8],
    state[1]-coefficient*state[5],
    state[2]-coefficient*state[6],
    state[3]-coefficient*state[7],
    state[4]-coefficient*state[8]
]);

CFGosperAnalyzeCorners(numerators, denominators) -> {;
    denominatorSafe := 1;
    denominatorSign := 0;
    values := [];
    corners := [];
    {@ index=1; index<=@denominators.Len(); {;
        denominator = @denominators[index];
        numerator = @numerators[index];
        sign = denominator < 0 ?: -1 ?_ (denominator > 0 ?: 1 ?_ 0);
        sign == 0
          ?: {; @denominatorSafe ~= 0; }
          ?_ (@denominatorSign == 0
               ?: {; @denominatorSign ~= @sign; }
               ?_ (sign == @denominatorSign ?: _ ?_ {; @denominatorSafe ~= 0; }));
        value = denominator == 0 ?: _ ?_ numerator/denominator;
        @values ~= @values.Push(value);
        @corners ~= @corners.Push({= numerator=numerator, denominator=denominator, value=value });
    }; index+=1 };
    stable := denominatorSafe;
    term := _;
    exact := denominatorSafe;
    denominatorSafe ?: {;
        @term ~= (@values[1] ~!: :Rational).Floor();
        firstNumerator = @numerators[1];
        firstDenominator = @denominators[1];
        {@ index=1; index<=@values.Len(); {;
            @stable ~= @stable && (@values[index] ~!: :Rational).Floor() == @term;
            @exact ~= @exact && @numerators[index]*@firstDenominator == @firstNumerator*@denominators[index];
        }; index+=1 };
    } ?_ _;
    {=
        denominatorSafe=denominatorSafe,
        stable=stable,
        term=term,
        exact=exact,
        values=values,
        corners=corners
    };
};

CFGosperAnalyze4(state, inputDone) -> {;
    us = inputDone ?: [0] ?_ [0,1];
    numerators := [];
    denominators := [];
    {@ index=1; index<=@us.Len(); {;
        u = @us[index];
        @numerators ~= @numerators.Push(@state[1]+@state[2]*u);
        @denominators ~= @denominators.Push(@state[3]+@state[4]*u);
    }; index+=1 };
    CFGosperAnalyzeCorners(numerators,denominators);
};

CFGosperAnalyze8(state, leftDone, rightDone) -> {;
    us = leftDone ?: [0] ?_ [0,1];
    vs = rightDone ?: [0] ?_ [0,1];
    numerators := [];
    denominators := [];
    {@ ui=1; ui<=@us.Len(); {;
        u = @us[ui];
        {@ vi=1; vi<=@vs.Len(); {;
            v = @vs[vi];
            @numerators ~= @numerators.Push(
                @state[1]+@state[2]*v+@state[3]*@u+@state[4]*@u*v
            );
            @denominators ~= @denominators.Push(
                @state[5]+@state[6]*v+@state[7]*@u+@state[8]*@u*v
            );
        }; vi+=1 };
    }; ui+=1 };
    CFGosperAnalyzeCorners(numerators,denominators);
};

CFGosperInputBudget(options) -> CFRequireCount(
    CFOption(options,"maxinputterms",4096),
    "Gosper maxInputTerms"
);

CFGosperTraceAppend(trace, keepTrace, event) ->
    keepTrace ?: trace.Push(.ImmutableValue(event)) ?_ trace;

CFGosperCoefficientRecord(status, index, coefficient, reason, work, form, analysis, trace) ->
    .ImmutableValue({=
        valueKind=:continuedFractionCoefficientResult,
        schema="rix.continued-fraction.coefficient-result@1",
        status=status,
        index=index,
        coefficient=coefficient,
        certified=status == :coefficient || status == :end ?: 1 ?_ _,
        reason=reason,
        work=work,
        form=form,
        analysis=analysis,
        trace=trace
    });

CFGosperHomographicCoefficient(source, initialState, target, options ?= {= }) -> {;
    requested = CFRequireIndex(target,"Gosper output coefficient index");
    maxInputs = CFGosperInputBudget(options);
    keepTrace = CFOption(options,"trace",_);
    state := initialState;
    inputIndex := 0;
    outputIndex := 0;
    inputDone := _;
    inputRequests := 0;
    trace := [];
    analysis := _;
    started := _;
    finished := _;
    result := _;
    {@ step=1; @finished==_; {;
        @started == _
          ?: {;
              sourceResult = CFCoefficientResult(@source,@inputIndex,@options);
              @inputRequests += 1;
              sourceResult[:status] == :coefficient
                ?: {;
                    coefficient = @sourceResult[:coefficient];
                    before := @state;
                    @state ~= CFGosperInput4(@state,coefficient);
                    @inputIndex += 1;
                    @inputDone ~= @source[:kind] == :finite && @inputIndex >= @source[:length];
                    @started ~= 1;
                    @trace ~= CFGosperTraceAppend(@trace,@keepTrace,{=
                        action=:input, source=:x, coefficient=coefficient,
                        before=CFGosperForm4(before), after=CFGosperForm4(@state)
                    });
                }
                ?_ {;
                    @finished ~= 1;
                    @result ~= CFGosperCoefficientRecord(
                        @sourceResult[:status],@requested,_,@sourceResult[:reason],
                        {= inputs=@inputRequests, outputs=@outputIndex, maxInputTerms=@maxInputs, exhausted=1 },
                        CFGosperForm4(@state),_,@trace
                    );
                };
          }
          ?_ {;
              @analysis ~= CFGosperAnalyze4(@state,@inputDone);
              @analysis[:stable]
                ?: {;
                    coefficient = @analysis[:term];
                    CFValidateCoefficient(coefficient,@outputIndex);
                    before := @state;
                    @state ~= CFGosperOutput4(@state,coefficient);
                    @trace ~= CFGosperTraceAppend(@trace,@keepTrace,{=
                        action=:output, coefficient=coefficient,
                        before=CFGosperForm4(before), after=CFGosperForm4(@state),
                        corners=@analysis[:corners]
                    });
                    @outputIndex == @requested
                      ?: {;
                          @finished ~= 1;
                          @result ~= CFGosperCoefficientRecord(
                              :coefficient,@requested,@coefficient,:stableFloor,
                              {= inputs=@inputRequests, outputs=@outputIndex+1, maxInputTerms=@maxInputs, exhausted=_ },
                              CFGosperForm4(@state),@analysis,@trace
                          );
                      }
                      ?_ {; @outputIndex += 1; };
                }
                ?_ (@inputDone
                     ?: {;
                         terminalStatus = @analysis[:denominatorSafe] || @outputIndex > 0
                           ?: :end
                           ?_ :domainUnresolved;
                         terminalReason = terminalStatus == :end
                           ?: :exactRationalStreamEnded
                           ?_ :undefinedHomographicValue;
                         @finished ~= 1;
                         @result ~= CFGosperCoefficientRecord(
                             terminalStatus,@requested,_,terminalReason,
                             {= inputs=@inputRequests, outputs=@outputIndex, maxInputTerms=@maxInputs, exhausted=terminalStatus != :end },
                             CFGosperForm4(@state),@analysis,@trace
                         );
                     }
                     ?_ (@inputRequests >= @maxInputs
                          ?: {;
                              @finished ~= 1;
                              @result ~= CFGosperCoefficientRecord(
                                  :budgetExhausted,@requested,_,:coefficientNotStable,
                                  {= inputs=@inputRequests, outputs=@outputIndex, maxInputTerms=@maxInputs, exhausted=1 },
                                  CFGosperForm4(@state),@analysis,@trace
                              );
                          }
                          ?_ {;
                              sourceResult = CFCoefficientResult(@source,@inputIndex,@options);
                              @inputRequests += 1;
                              sourceResult[:status] == :coefficient
                                ?: {;
                                    coefficient = @sourceResult[:coefficient];
                                    before := @state;
                                    @state ~= CFGosperInput4(@state,coefficient);
                                    @inputIndex += 1;
                                    @inputDone ~= @source[:kind] == :finite && @inputIndex >= @source[:length];
                                    @trace ~= CFGosperTraceAppend(@trace,@keepTrace,{=
                                        action=:input, source=:x, coefficient=coefficient,
                                        before=CFGosperForm4(before), after=CFGosperForm4(@state)
                                    });
                                }
                                ?_ (sourceResult[:status] == :end
                                     ?: {; @inputDone ~= 1; }
                                     ?_ {;
                                         @finished ~= 1;
                                         @result ~= CFGosperCoefficientRecord(
                                             @sourceResult[:status],@requested,_,@sourceResult[:reason],
                                             {= inputs=@inputRequests, outputs=@outputIndex, maxInputTerms=@maxInputs, exhausted=1 },
                                             CFGosperForm4(@state),@analysis,@trace
                                         );
                                     });
                          }));
          };
    }; step+=1 };
    result;
};

CFGosperInitial8(operation) -> {?
    operation == :add ? [0,1,1,0, 0,0,0,1];
    operation == :sub ? [0,1,-1,0, 0,0,0,1];
    operation == :mul ? [1,0,0,0, 0,0,0,1];
    operation == :div ? [0,1,0,0, 0,0,1,0];
    .Error("Unsupported Gosper bihomographic operation")
};

CFGosperBihomographicCoefficient(operation, left, right, target, options ?= {= }) -> {;
    requested = CFRequireIndex(target,"Gosper output coefficient index");
    maxInputs = CFGosperInputBudget(options);
    keepTrace = CFOption(options,"trace",_);
    state := CFGosperInitial8(operation);
    leftIndex := 0; rightIndex := 0; outputIndex := 0;
    leftDone := _; rightDone := _;
    leftStarted := _; rightStarted := _;
    inputRequests := 0;
    trace := [];
    analysis := _;
    exactZeroDivisor = operation == :div && right[:kind] == :finite &&
      CFConvergent(right,right[:length]) == 0;
    finished := exactZeroDivisor ?: 1 ?_ _;
    result := exactZeroDivisor
      ?: CFGosperCoefficientRecord(
          :domainUnresolved,requested,_,:divisorIsExactlyZero,
          {= inputs=0, leftInputs=0, rightInputs=0, outputs=0, maxInputTerms=maxInputs, exhausted=_ },
          CFGosperForm8(state),_,[]
      )
      ?_ _;
    {@ step=1; @finished==_; {;
        needLeft = @leftStarted == _;
        needRight = @leftStarted != _ && @rightStarted == _;
        forceInput = needLeft || needRight;
        forceInput
          ?: {;
              side = @needLeft ?: :x ?_ :y;
              source = @needLeft ?: @left ?_ @right;
              sourceIndex = @needLeft ?: @leftIndex ?_ @rightIndex;
              sourceResult = CFCoefficientResult(source,sourceIndex,@options);
              @inputRequests += 1;
              sourceResult[:status] == :coefficient
                ?: {;
                    coefficient = @sourceResult[:coefficient];
                    before := @state;
                    @state ~= @side == :x
                      ?: CFGosperInputX8(@state,coefficient)
                      ?_ CFGosperInputY8(@state,coefficient);
                    @side == :x
                      ?: {;
                          @leftIndex += 1; @leftStarted ~= 1;
                          @leftDone ~= @left[:kind] == :finite && @leftIndex >= @left[:length];
                      }
                      ?_ {;
                          @rightIndex += 1; @rightStarted ~= 1;
                          @rightDone ~= @right[:kind] == :finite && @rightIndex >= @right[:length];
                      };
                    @trace ~= CFGosperTraceAppend(@trace,@keepTrace,{=
                        action=:input, source=@side, coefficient=coefficient,
                        before=CFGosperForm8(before), after=CFGosperForm8(@state)
                    });
                }
                ?_ {;
                    @finished ~= 1;
                    @result ~= CFGosperCoefficientRecord(
                        @sourceResult[:status],@requested,_,@sourceResult[:reason],
                        {= inputs=@inputRequests, leftInputs=@leftIndex, rightInputs=@rightIndex, outputs=@outputIndex, maxInputTerms=@maxInputs, exhausted=1 },
                        CFGosperForm8(@state),_,@trace
                    );
                };
          }
          ?_ {;
              @analysis ~= CFGosperAnalyze8(@state,@leftDone,@rightDone);
              @analysis[:stable]
                ?: {;
                    coefficient = @analysis[:term];
                    CFValidateCoefficient(coefficient,@outputIndex);
                    before := @state;
                    @state ~= CFGosperOutput8(@state,coefficient);
                    @trace ~= CFGosperTraceAppend(@trace,@keepTrace,{=
                        action=:output, coefficient=coefficient,
                        before=CFGosperForm8(before), after=CFGosperForm8(@state),
                        corners=@analysis[:corners]
                    });
                    @outputIndex == @requested
                      ?: {;
                          @finished ~= 1;
                          @result ~= CFGosperCoefficientRecord(
                              :coefficient,@requested,@coefficient,:stableFloor,
                              {= inputs=@inputRequests, leftInputs=@leftIndex, rightInputs=@rightIndex, outputs=@outputIndex+1, maxInputTerms=@maxInputs, exhausted=_ },
                              CFGosperForm8(@state),@analysis,@trace
                          );
                      }
                      ?_ {; @outputIndex += 1; };
                }
                ?_ ((@leftDone && @rightDone)
                     ?: {;
                         status = @analysis[:denominatorSafe] || @outputIndex > 0
                           ?: :end
                           ?_ :domainUnresolved;
                         reason = status == :end ?: :exactRationalStreamEnded ?_ :undefinedBihomographicValue;
                         @finished ~= 1;
                         @result ~= CFGosperCoefficientRecord(
                             status,@requested,_,reason,
                             {= inputs=@inputRequests, leftInputs=@leftIndex, rightInputs=@rightIndex, outputs=@outputIndex, maxInputTerms=@maxInputs, exhausted=status != :end },
                             CFGosperForm8(@state),@analysis,@trace
                         );
                     }
                     ?_ (@inputRequests >= @maxInputs
                          ?: {;
                              @finished ~= 1;
                              @result ~= CFGosperCoefficientRecord(
                                  :budgetExhausted,@requested,_,:coefficientNotStable,
                                  {= inputs=@inputRequests, leftInputs=@leftIndex, rightInputs=@rightIndex, outputs=@outputIndex, maxInputTerms=@maxInputs, exhausted=1 },
                                  CFGosperForm8(@state),@analysis,@trace
                              );
                          }
                          ?_ {;
                              chooseLeft = !@leftDone && (@rightDone || @leftIndex <= @rightIndex);
                              side = chooseLeft ?: :x ?_ :y;
                              source = chooseLeft ?: @left ?_ @right;
                              sourceIndex = chooseLeft ?: @leftIndex ?_ @rightIndex;
                              sourceResult = CFCoefficientResult(source,sourceIndex,@options);
                              @inputRequests += 1;
                              sourceResult[:status] == :coefficient
                                ?: {;
                                    coefficient = @sourceResult[:coefficient];
                                    before := @state;
                                    @state ~= @side == :x
                                      ?: CFGosperInputX8(@state,coefficient)
                                      ?_ CFGosperInputY8(@state,coefficient);
                                    @side == :x
                                      ?: {;
                                          @leftIndex += 1;
                                          @leftDone ~= @left[:kind] == :finite && @leftIndex >= @left[:length];
                                      }
                                      ?_ {;
                                          @rightIndex += 1;
                                          @rightDone ~= @right[:kind] == :finite && @rightIndex >= @right[:length];
                                      };
                                    @trace ~= CFGosperTraceAppend(@trace,@keepTrace,{=
                                        action=:input, source=@side, coefficient=coefficient,
                                        before=CFGosperForm8(before), after=CFGosperForm8(@state)
                                    });
                                }
                                ?_ (sourceResult[:status] == :end
                                     ?: (side == :x ?: {; @leftDone ~= 1; } ?_ {; @rightDone ~= 1; })
                                     ?_ {;
                                         @finished ~= 1;
                                         @result ~= CFGosperCoefficientRecord(
                                             @sourceResult[:status],@requested,_,@sourceResult[:reason],
                                             {= inputs=@inputRequests, leftInputs=@leftIndex, rightInputs=@rightIndex, outputs=@outputIndex, maxInputTerms=@maxInputs, exhausted=1 },
                                             CFGosperForm8(@state),@analysis,@trace
                                         );
                                     });
                          }));
          };
    }; step+=1 };
    result;
};

CFNativeStream(value) -> (value ? :Map) &&
    value[:valueKind] == :continuedFraction && value[:kind] != :arithmetic;

CFNativeSource(value) ->
    CFNativeStream(value)
      ?: value
      ?_ (CFExact(value)
           ?: CFFromRational(value,{= name=:embeddedRational })
           ?_ .Error("Gosper arithmetic requires continued-fraction, Integer, or Rational operands"));

CFOracleSource(value) -> CFNativeStream(value) && value[:kind] == :finite
  ?: CFConvergent(value,value[:length])
  ?_ value;

CFGosperProtocolEnclosure(real, request, operation) -> {;
    result = operation == :enclose
      ?: real[:recipe].Enclose(request)
      ?_ real[:recipe].Refine(request);
    .ImmutableValue(result.Merge({=
        backend=:continuedFraction,
        evidence={=
            kind=:gosperTransducerEnclosure,
            property=:containsNativeContinuedFractionValue,
            transducer=real[:transducer],
            operation=real[:operation],
            source=result[:evidence]
        },
        source={=
            plugin=:continuedFraction,
            schema=real[:schema],
            kind=:gosper,
            transducer=real[:transducer]
        }
    }));
};

CFGosperHomographic(operation, sourceValue, initialState, recipe, options ?= {= }) -> {;
    source = CFNativeSource(sourceValue);
    settings = options;
    coefficientResultFunction = (index, request ?= {= }) ->
        CFGosperHomographicCoefficient(
            @source,
            @initialState,
            index,
            @settings.Merge(request)
        );
    provisional = {=
        valueKind=:continuedFraction,
        schema="rix.continued-fraction.gosper@1",
        kind=:gosper,
        name=CFOption(options,"name",:gosperHomographic),
        transducer=:homographic,
        operation=operation,
        source=source,
        left=source,
        right=_,
        prefix=[],
        period=_,
        initialForm=CFGosperForm4(initialState),
        coefficientResultFunction=coefficientResultFunction,
        recipe=recipe,
        evidenceLevel=:proof,
        evidence={=
            kind=:gosperHomographicTransducer,
            property=:exactCoefficientTransactions,
            operation=operation,
            initialForm=CFGosperForm4(initialState),
            source=source[:evidence]
        },
        provenance={= plugin=:continuedFraction, version=3, source=:gosperHomographic }
    };
    CFAttachProtocol(provisional);
};

CFGosperBihomographic(operation, leftValue, rightValue, options ?= {= }) -> {;
    left = CFNativeSource(leftValue);
    right = CFNativeSource(rightValue);
    settings = options;
    initialState = CFGosperInitial8(operation);
    recipe = .oracle.Operation(operation,CFOracleSource(left),CFOracleSource(right));
    coefficientResultFunction = (index, request ?= {= }) ->
        CFGosperBihomographicCoefficient(
            @operation,@left,@right,index,@settings.Merge(request)
        );
    provisional = {=
        valueKind=:continuedFraction,
        schema="rix.continued-fraction.gosper@1",
        kind=:gosper,
        name=CFOption(options,"name",:gosperBihomographic),
        transducer=:bihomographic,
        operation=operation,
        source=_,
        left=left,
        right=right,
        prefix=[],
        period=_,
        initialForm=CFGosperForm8(initialState),
        coefficientResultFunction=coefficientResultFunction,
        recipe=recipe,
        evidenceLevel=:proof,
        evidence={=
            kind=:gosperBihomographicTransducer,
            property=:exactCoefficientTransactions,
            operation=operation,
            initialForm=CFGosperForm8(initialState),
            left=left[:evidence],
            right=right[:evidence]
        },
        provenance={= plugin=:continuedFraction, version=3, source=:gosperBihomographic }
    };
    CFAttachProtocol(provisional);
};

CFZeroStatus(real, options ?= {= }) -> {;
    source = CFRequireCoefficientStream(real,"Continued-fraction ZeroStatus");
    source[:kind] == :finite
      ?: {;
          value = CFConvergent(@source,@source[:length]);
          status = value == 0 ?: :zero ?_ :nonzero;
          .ImmutableValue({=
              valueKind=:continuedFractionZeroStatus,
              schema="rix.continued-fraction.zero-status@1",
              status=status,
              certified=1,
              sign=value < 0 ?: :negative ?_ (value > 0 ?: :positive ?_ :zero),
              reason=:exactFiniteValue,
              evidence={= kind=:exactRationalComparison, value=value }
          });
      }
      ?_ ((source[:kind] == :lazy || source[:kind] == :periodic)
           ?: {;
               leading = CFCoefficientAt(@source,0,@options);
               .ImmutableValue({=
                   valueKind=:continuedFractionZeroStatus,
                   schema="rix.continued-fraction.zero-status@1",
                   status=:nonzero,
                   certified=1,
                   sign=leading >= 0 ?: :positive ?_ :negative,
                   reason=:infiniteRegularContinuedFraction,
                   evidence={=
                       kind=:regularContinuedFractionSign,
                       leadingCoefficient=leading,
                       property=:positiveInfiniteTail
                   }
               });
           }
           ?_ {;
               first = CFCoefficientResult(@source,0,@options);
               first[:status] != :coefficient
                 ?: .ImmutableValue({=
                     valueKind=:continuedFractionZeroStatus,
                     schema="rix.continued-fraction.zero-status@1",
                     status=:unknown,
                     certified=_,
                     sign=:unknown,
                     reason=first[:reason],
                     evidence=first
                 })
                 ?_ (first[:coefficient] != 0
                      ?: .ImmutableValue({=
                          valueKind=:continuedFractionZeroStatus,
                          schema="rix.continued-fraction.zero-status@1",
                          status=:nonzero,
                          certified=1,
                          sign=first[:coefficient] > 0 ?: :positive ?_ :negative,
                          reason=:nonzeroLeadingCoefficient,
                          evidence=first
                      })
                      ?_ {;
                          second = CFCoefficientResult(@source,1,@options);
                          status = second[:status] == :end
                            ?: :zero
                            ?_ (second[:status] == :coefficient ?: :nonzero ?_ :unknown);
                          .ImmutableValue({=
                              valueKind=:continuedFractionZeroStatus,
                              schema="rix.continued-fraction.zero-status@1",
                              status=status,
                              certified=status == :unknown ?: _ ?_ 1,
                              sign=status == :zero ?: :zero ?_ (status == :nonzero ?: :positive ?_ :unknown),
                              reason=status == :zero ?: :terminatedAfterZero
                                ?_ (status == :nonzero ?: :positiveTailAfterZero ?_ second[:reason]),
                              evidence={= first=@first, second=second }
                          });
                      });
           });
};

CFPrimitiveIntegerCoefficients(coefficients) -> {;
    content := 0;
    {@ index=1; index <= @coefficients.Len(); {;
        @content ~= CFIntegerGcd(@content, (@coefficients)[index]);
    }; index += 1 };
    content == 0 ?: .Error("Continued-fraction quadratic form cannot be the zero polynomial") ?_ _;
    primitive = coefficients.Map((coefficient) -> coefficient // @content);
    primitive.Last() < 0 ?: primitive.Map((coefficient) -> -coefficient) ?_ primitive;
};

CFMobiusMatrix(coefficients) -> {;
    a := 1; b := 0; c := 0; d := 1;
    {@ index=1; index <= @coefficients.Len(); {;
        coefficient = (@coefficients)[index];
        nextA = @a * coefficient + @b;
        nextB := @a;
        nextC = @c * coefficient + @d;
        nextD := @c;
        @a ~= nextA; @b ~= nextB; @c ~= nextC; @d ~= nextD;
    }; index += 1 };
    {= a=a, b=b, c=c, d=d, determinant=a*d-b*c };
};

CFQuadraticForm(real) -> {;
    source = CFRequireCoefficientStream(real, "Continued-fraction QuadraticForm");
    source[:kind] == :periodic
      ?: _
      ?_ .Error("Continued-fraction QuadraticForm requires an explicitly periodic stream");
    prefixMatrix = CFMobiusMatrix(source[:prefix]);
    periodMatrix = CFMobiusMatrix(source[:period]);
    a = prefixMatrix[:a]; b = prefixMatrix[:b];
    c = prefixMatrix[:c]; d = prefixMatrix[:d];
    p = periodMatrix[:a]; q = periodMatrix[:b];
    r = periodMatrix[:c]; s = periodMatrix[:d];
    fixedLinear = s - p;
    quadratic = r*d^2 - fixedLinear*d*c - q*c^2;
    linear = -2*r*d*b + fixedLinear*(d*a+b*c) + 2*q*a*c;
    constant = r*b^2 - fixedLinear*a*b - q*a^2;
    coefficients = CFPrimitiveIntegerCoefficients([constant, linear, quadratic]);
    coefficients[3] != 0
      ?: _
      ?_ .Error("Periodic continued fraction did not produce a quadratic equation");
    form = {=
        valueKind=:continuedFractionQuadraticForm,
        schema="rix.continued-fraction.quadratic-form@1",
        coefficients=coefficients,
        constant=coefficients[1],
        linear=coefficients[2],
        quadratic=coefficients[3],
        discriminant=coefficients[2]^2 - 4*coefficients[3]*coefficients[1],
        prefix=source[:prefix],
        period=source[:period],
        prefixMatrix=prefixMatrix,
        periodMatrix=periodMatrix,
        enclosure=source[:initialWitness][:interval],
        certified=1,
        evidenceLevel=source[:evidenceLevel],
        evidence={=
            kind=:periodicMobiusFixedPoint,
            property=:satisfiesPrimitiveQuadraticEquation,
            periodDeterminant=periodMatrix[:determinant],
            source=source[:evidence]
        }
    };
    .ImmutableValue(form);
};

CFBestApproximation(real, maxDenominator, options ?= {= }) -> {;
    source = CFRequireCoefficientStream(real, "Continued-fraction BestApproximation");
    bound = CFRequirePositiveDenominator(maxDenominator, "Continued-fraction denominator bound");
    maxCoefficients = CFRequireCount(
        CFOption(options, "maxcoefficients", 1000),
        "Continued-fraction best-approximation maxCoefficients"
    );
    p0 := 0; p1 := 1; q0 := 1; q1 := 0;
    index := 0; calls := 0; selected := _; nextDenominator := _;
    status := :budgetExhausted; reason := :maxCoefficientsReached; done := _;
    {@ step=1; @done == _ && @index < @maxCoefficients; {;
        finiteEnd = @source[:kind] == :finite && @index >= @source[:length];
        finiteEnd
          ?: {; @done ~= 1; @status ~= :certified; @reason ~= :exactFiniteValue; }
          ?_ {;
              coefficient = CFCoefficientAt(@source, @index);
              @calls += 1;
              nextP = coefficient*@p1 + @p0;
              nextQ = coefficient*@q1 + @q0;
              nextQ > @bound
                ?: {;
                    @nextDenominator ~= @nextQ;
                    @done ~= 1;
                    @status ~= :certified;
                    @reason ~= :nextConvergentExceedsBound;
                }
                ?_ {;
                    @index += 1;
                    @selected ~= {=
                        count=@index,
                        numerator=@nextP,
                        denominator=@nextQ,
                        rational=@nextP/@nextQ
                    };
                    @p0 ~= @p1; @p1 ~= @nextP;
                    @q0 ~= @q1; @q1 ~= @nextQ;
                };
          };
    }; step += 1 };
    selected
      ?: _
      ?_ .Error("Continued-fraction BestApproximation could not produce a denominator-bounded convergent");
    certified = status == :certified;
    result = {=
        valueKind=:continuedFractionBestApproximation,
        schema="rix.continued-fraction.best-approximation@1",
        status=status,
        approximation=selected[:rational],
        numerator=selected[:numerator],
        denominator=selected[:denominator],
        denominatorBound=bound,
        nextDenominator=nextDenominator,
        certified=certified,
        optimality=certified ?: :bestApproximationSecondKind ?_ :unresolvedBeyondCurrentDenominator,
        errorMeasure=:absoluteScaledError,
        certifiedThrough=certified ?: bound ?_ selected[:denominator],
        evidenceLevel=source[:evidenceLevel],
        evidence=certified
          ?: {=
              kind=:continuedFractionConvergentTheorem,
              property=:minimizesAbsoluteQxMinusP,
              coefficientCount=selected[:count],
              nextDenominator=nextDenominator,
              source=source[:evidence]
          }
          ?_ _,
        work={=
            calls=calls,
            coefficients=selected[:count],
            maxCoefficients=maxCoefficients,
            exhausted=status != :certified
        },
        diagnostics=status == :certified ?: [] ?_ [reason]
    };
    .ImmutableValue(result);
};

CFDropFirst(values) -> {;
    result = [];
    {@ index=2; index <= @values.Len(); {; @result ~= @result.Push((@values)[index]); }; index += 1 };
    result;
};

CFTransformationEvidence(real, operation, parameter ?= _) -> {=
    kind=:exactCoefficientTransformation,
    property=:sameRealAfterArithmeticTransformation,
    operation=operation,
    parameter=parameter,
    source=real[:evidence]
};

CFTranslate(real, offset, options ?= {= }) -> {;
    source = CFRequireCoefficientStream(real, "Continued-fraction Translate");
    exactOffset = offset ~!: :Integer;
    name = CFOption(options, "name", :translated);
    evidence = CFTransformationEvidence(source, :translate, exactOffset);
    {? source[:kind] == :gosper
         ? CFGosperHomographic(
             :translate,source,[1,exactOffset,0,1],
             .oracle.Operation(:add,source,exactOffset),
             options.Merge({= name=name })
           );
       source[:kind] == :finite
         ? CFFinite(
             source[:coefficients].Set(1, source[:coefficients][1] + exactOffset),
             {= name=name, evidence=evidence }
           );
       source[:kind] == :periodic
         ? CFPeriodic(
             source[:prefix].Set(1, source[:prefix][1] + exactOffset),
             source[:period],
             {= name=name, evidenceLevel=source[:evidenceLevel], evidence=evidence }
           );
       CFLazy(
         (index) -> index == 0
           ?: CFCoefficientAt(@source, 0) + @exactOffset
           ?_ CFCoefficientAt(@source, index),
         {= name=name, evidenceLevel=source[:evidenceLevel], evidence=evidence }
       )
    };
};

CFReciprocal(real, options ?= {= }) -> {;
    source = CFRequireCoefficientStream(real, "Continued-fraction Reciprocal");
    name = CFOption(options, "name", :reciprocal);
    evidence = CFTransformationEvidence(source, :reciprocal);
    source[:kind] == :gosper
      ?: CFGosperHomographic(
          :reciprocal,source,[0,1,1,0],
          .oracle.Operation(:div,1,source),
          options.Merge({= name=name })
        )
      ?_ {;
    leading = CFCoefficientAt(@source, 0);
    leading >= 0
      ?: _
      ?_ .Error("Continued-fraction Reciprocal currently requires a positive represented real");
    @source[:kind] == :finite && @source[:length] == 1 && leading == 0
      ?: .Error("Continued-fraction Reciprocal is undefined at zero")
      ?_ _;
    {? @source[:kind] == :finite
         ? CFFinite(
             leading > 0 ?: [0] ++ @source[:coefficients] ?_ CFDropFirst(@source[:coefficients]),
             {= name=@name, evidence=@evidence }
           );
       @source[:kind] == :periodic
         ? {;
             transformedPrefix = @leading > 0
               ?: [0] ++ @source[:prefix]
               ?_ (@source[:prefix].Len() > 1 ?: CFDropFirst(@source[:prefix]) ?_ @source[:period]);
             CFPeriodic(
               transformedPrefix,
               @source[:period],
               {= name=@name, evidenceLevel=@source[:evidenceLevel], evidence=@evidence }
             );
           };
       {;
         rule = @leading > 0
           ?: ((index) -> index == 0 ?: 0 ?_ CFCoefficientAt(@source, index-1))
           ?_ ((index) -> CFCoefficientAt(@source, index+1));
         CFLazy(
         rule,
         {= name=@name, evidenceLevel=@source[:evidenceLevel], evidence=@evidence }
         );
       }
    };
    };
};

CFRefinementState(real, requestedWidth, maxCalls, maxIterations) -> {;
    selected = real[:initialWitness];
    calls = 0;
    iterations = 0;
    {@ step = 1;
       (@selected)[:width] > @requestedWidth && @calls < @maxCalls && @iterations < @maxIterations;
       {;
           @selected ~= CFNextWitness(@real, @selected);
           @calls += 1;
           @iterations += 1;
       };
       step += 1
    };
    {= selected=selected, calls=calls, iterations=iterations };
};

CFProtocolEnclosure(real, request, operation) -> {;
    capabilities = CFCapabilities(real);
    normalized = .RefinementRequest(request, operation, capabilities);
    requestedWidth = normalized[:absoluteWidth];
    maxCalls = normalized[:work][:maxCalls];
    maxIterations = normalized[:work][:maxIterations];
    finite = real[:kind] == :finite;
    state = finite
      ?: {= selected=real[:initialWitness], calls=0, iterations=0 }
      ?_ CFRefinementState(real, requestedWidth, maxCalls, maxIterations);
    selected = state[:selected];
    achievedWidth = selected[:width];
    goalMet = achievedWidth <= requestedWidth;
    status = goalMet ?: :enclosed ?_ :budgetExhausted;
    approximation = .CertifiedApproximation(selected[:convergent], selected[:interval], {=
        reason=status,
        requested=requestedWidth,
        achieved=achievedWidth,
        provider=:continuedFraction
    });
    {=
        valueKind = :enclosure,
        schema = "rix.numerics.enclosure@1",
        status = status,
        interval = selected[:interval],
        certified = 1,
        goalMet = goalMet,
        requestedWidth = requestedWidth,
        achievedWidth = achievedWidth,
        approximation = approximation,
        evidenceLevel = finite ?: :proof ?_ real[:evidenceLevel],
        backend = :continuedFraction,
        operation = normalized[:operation],
        trace = [selected],
        work = {=
            calls=state[:calls],
            iterations=state[:iterations],
            coefficients=selected[:count],
            maxCalls=maxCalls,
            maxIterations=maxIterations,
            exhausted=!goalMet
        },
        diagnostics = goalMet ?: [] ?_ [:maxCallsReached],
        evidence = {=
            kind=finite ?: :finiteEvaluation ?_ :consecutiveConvergents,
            property=:containment,
            witness=selected,
            certificate=real[:evidence]
        },
        source = {= plugin=:continuedFraction, schema=real[:schema], kind=real[:kind] }
    };
};

CFFamily(value) -> (value ? :Map) &&
  (value[:valueKind] == :continuedFraction || value[:valueKind] == :continuedFractionArithmeticReal);
CFExact(value) -> (value ? :Integer) || (value ? :Rational);
CFArithmeticPair(left, right) ->
  (CFFamily(left) || CFFamily(right)) &&
  (CFFamily(left) || CFExact(left)) &&
  (CFFamily(right) || CFExact(right));

CFArithmeticCapabilities(real) -> {=
    valueKind=:numericsCapabilities,
    schema="rix.numerics.capabilities@1",
    backend=:continuedFraction,
    representation=:oracleBackedContinuedFractionArithmetic,
    denotation=:singleton,
    operations=[:enclose, :refine],
    evidenceLevels=[:constructorGuarantee, :proof],
    certified=1,
    arbitraryRefinement=1,
    deterministic=1,
    minimumWidth=0,
    maxCalls=100000,
    maxIterations=100000
};

CFOracleArithmetic(operation, left, right ?= _) -> {;
    unary = operation == :neg || operation == :abs;
    recipe = unary
      ?: .oracle.Operation(operation, CFOracleSource(left))
      ?_ .oracle.Operation(operation, CFOracleSource(left), CFOracleSource(right));
    real = {=
        valueKind=:continuedFractionArithmeticReal,
        schema="rix.continued-fraction.arithmetic-real@1",
        kind=:arithmetic,
        operation=operation,
        recipe=recipe,
        provenance={= plugin=:continuedFraction, version=2, source=:arithmeticRecipe }
    };
    real._proto = {=
        Enclose=(self, request ?= {= })->self[:recipe].Enclose(request),
        Refine=(self, request ?= {= })->self[:recipe].Refine(request),
        NumericsCapabilities=(self)->CFArithmeticCapabilities(self),
        Record=(self)->{= valueKind=self[:valueKind], schema=self[:schema], operation=self[:operation], certified=1 }
    };
    .ImmutableValue(real ~!: :ContinuedFractionReal);
};

CFFiniteBinary(operation, left, right) -> {;
    a = CFConvergent(left,left[:length]);
    b = CFConvergent(right,right[:length]);
    value = {? operation == :add ? a+b;
               operation == :sub ? a-b;
               operation == :mul ? a*b;
               operation == :div ? a/b;
               .Error("Unsupported finite continued-fraction arithmetic operation")
            };
    CFFromRational(value,{= name=:exactArithmetic });
};

CFGosperPeriodicSquare(source) -> {;
    form = CFQuadraticForm(source);
    initialState = [-form[:linear],-form[:constant],0,form[:quadratic]];
    form[:linear] == 0
      ?: CFFromRational((-form[:constant])/form[:quadratic],{= name=:exactQuadraticSquare })
      ?_ CFGosperHomographic(
          :square,source,initialState,
          .oracle.Operation(:mul,source,source),
          {= name=:gosperQuadraticSquare }
      );
};

CFNativeBinary(operation, leftValue, rightValue) -> {;
    left = CFNativeSource(leftValue);
    right = CFNativeSource(rightValue);
    exactZeroDivisor = operation == :div && right[:kind] == :finite &&
      CFConvergent(right,right[:length]) == 0;
    sameComparison = (leftValue ? :Map) && (rightValue ? :Map)
      ?: leftValue == rightValue
      ?_ _;
    same = sameComparison ?: 1 ?_ _;
    exactFinite = left[:kind] == :finite
      ?: (right[:kind] == :finite
           ?: (operation == :div
                ?: (CFConvergent(right,right[:length]) == 0
                     ?: _
                     ?_ CFFiniteBinary(operation,left,right))
                ?_ CFFiniteBinary(operation,left,right))
           ?_ _)
      ?_ _;
    exactZeroDivisor
      ?: CFOracleArithmetic(:div,left,right)
      ?_ (exactFinite != _
           ?: exactFinite
           ?_ (same
           ?: (operation == :sub
                ?: CFFromRational(0,{= name=:identicalDifference })
                ?_ (operation == :div
                     ?: {;
                         zeroStatus = CFZeroStatus(@left);
                         zeroStatus[:status] == :nonzero
                           ?: CFFromRational(1,{= name=:identicalQuotient })
                           ?_ CFGosperBihomographic(@operation,@left,@right);
                     }
                     ?_ (operation == :add
                          ?: CFGosperHomographic(
                              :double,left,[2,0,0,1],
                              .oracle.Operation(:add,left,left),
                              {= name=:gosperDouble }
                          )
                          ?_ (operation == :mul
                               ?: (left[:kind] == :periodic
                                    ?: CFGosperPeriodicSquare(left)
                                    ?_ CFGosperBihomographic(operation,left,right))
                               ?_ CFGosperBihomographic(operation,left,right)))))
                ?_ CFGosperBihomographic(operation,left,right)));
};

CFNativeNegate(sourceValue) -> {;
    source = CFNativeSource(sourceValue);
    source[:kind] == :finite
      ?: CFFromRational(-CFConvergent(source,source[:length]),{= name=:exactNegation })
      ?_ CFGosperHomographic(
          :neg,source,[-1,0,0,1],
          .oracle.Operation(:neg,source),
          {= name=:gosperNegation }
        );
};

CFNativeAbsolute(sourceValue) -> {;
    source = CFNativeSource(sourceValue);
    source[:kind] == :finite
      ?: CFFromRational(CFConvergent(source,source[:length]).Abs(),{= name=:exactAbsoluteValue })
      ?_ (source[:kind] == :lazy || source[:kind] == :periodic
           ?: (CFCoefficientAt(source,0) >= 0 ?: source ?_ CFNativeNegate(source))
           ?_ CFOracleArithmetic(:abs,source));
};

CFNativePower(sourceValue, exponentValue) -> {;
    source = CFNativeSource(sourceValue);
    exponent = exponentValue ~!: :Integer;
    exponent < 0 && source[:kind] == :finite && CFConvergent(source,source[:length]) == 0
      ?: .Error("A zero continued fraction cannot be raised to a negative power")
      ?_ _;
    exponent == 0
      ?: CFFromRational(1,{= name=:zerothPower })
      ?_ (exponent == 1
           ?: source
           ?_ (exponent == -1
                ?: CFGosperHomographic(
                    :reciprocal,source,[0,1,1,0],
                    .oracle.Operation(:div,1,source),
                    {= name=:gosperReciprocal }
                )
                ?_ (source[:kind] == :finite
                     ?: CFFromRational(CFConvergent(source,source[:length])^exponent,{= name=:exactPower })
                     ?_ (exponent == 2 && source[:kind] == :periodic
                          ?: CFGosperPeriodicSquare(source)
                          ?_ CFOracleArithmetic(:pow,source,exponent)))));
};

CFArithmetic(operation, left, right ?= _) -> {;
    nativeLeft = CFNativeStream(left) || CFExact(left);
    operation == :neg
      ?: {; @nativeLeft ?: CFNativeNegate(@left) ?_ CFOracleArithmetic(@operation,@left); }
      ?_ (operation == :abs
           ?: {; @nativeLeft ?: CFNativeAbsolute(@left) ?_ CFOracleArithmetic(@operation,@left); }
           ?_ (operation == :pow
                ?: {;
                    (@nativeLeft && CFExact(@right))
                      ?: CFNativePower(@left,@right)
                      ?_ CFOracleArithmetic(@operation,@left,@right);
                }
                ?_ ((nativeLeft && (CFNativeStream(right) || CFExact(right)))
                     ?: CFNativeBinary(operation,left,right)
                     ?_ CFOracleArithmetic(operation,left,right))));
};

.TypeKnown(:ContinuedFractionReal) ?: _ ?_ .TypeRegister({=
    name=:ContinuedFractionReal,
    nativeType=:map,
    defaultTraits=[:number, :ordered],
    convertFrom={= map=(x) ?- [CFFamily(x)] -> x },
    validate=(x)->CFFamily(x),
    proto={=
        Coefficient=(self,index,options ?= {= })->self[:kind] == :arithmetic
          ?: .Error("Oracle-backed continued-fraction arithmetic has no native coefficient stream")
          ?_ CFCoefficientAt(self,index,options),
        CoefficientResult=(self,index,options ?= {= })->self[:kind] == :arithmetic
          ?: .Error("Oracle-backed continued-fraction arithmetic has no native coefficient stream")
          ?_ CFCoefficientResult(self,index,options),
        Coefficients=(self,count ?= _,options ?= {= })->self[:kind] == :arithmetic
          ?: .Error("Oracle-backed continued-fraction arithmetic has no native coefficient stream")
          ?_ CFCoefficients(self,count,options),
        Value=(self)->self[:kind] == :finite
          ?: CFConvergent(self,self[:length])
          ?_ .Error("Infinite or transduced continued fractions do not have an immediate exact Value"),
        Convergent=(self,count)->CFConvergent(self,count),
        Convergents=(self,count ?= _)->CFConvergents(self,count),
        Enclosure=(self,count ?= _)->CFEnclosureAt(self,count),
        ErrorInterval=(self,count)->CFErrorInterval(self,count),
        QuadraticForm=(self)->CFQuadraticForm(self),
        BestApproximation=(self,maxDenominator,options ?= {= })->CFBestApproximation(self,maxDenominator,options),
        Translate=(self,offset,options ?= {= })->CFTranslate(self,offset,options),
        Reciprocal=(self,options ?= {= })->CFReciprocal(self,options),
        ZeroStatus=(self,options ?= {= })->CFZeroStatus(self,options),
        Record=(self)->self[:kind] == :arithmetic
          ?: {= valueKind=self[:valueKind], schema=self[:schema], operation=self[:operation], certified=1 }
          ?_ CFRecord(self),
        Enclose=(self,request ?= {= })->self[:kind] == :arithmetic
          ?: self[:recipe].Enclose(request)
          ?_ (self[:kind] == :gosper ?: CFGosperProtocolEnclosure(self,request,:enclose) ?_ CFProtocolEnclosure(self,request,:enclose)),
        Refine=(self,request ?= {= })->self[:kind] == :arithmetic
          ?: self[:recipe].Refine(request)
          ?_ (self[:kind] == :gosper ?: CFGosperProtocolEnclosure(self,request,:refine) ?_ CFProtocolEnclosure(self,request,:refine)),
        NumericsCapabilities=(self)->self[:kind] == :arithmetic ?: CFArithmeticCapabilities(self) ?_ CFCapabilities(self)
    },
    installs={=
        ADD=[{= name=:CFAdd, priority=300, prep=(x,y)->CFArithmeticPair(x,y), impl=(x,y)->CFArithmetic(:add,x,y) }],
        SUB=[{= name=:CFSub, priority=300, prep=(x,y)->CFArithmeticPair(x,y), impl=(x,y)->CFArithmetic(:sub,x,y) }],
        MUL=[{= name=:CFMul, priority=300, prep=(x,y)->CFArithmeticPair(x,y), impl=(x,y)->CFArithmetic(:mul,x,y) }],
        DIV=[{= name=:CFDiv, priority=300, prep=(x,y)->CFArithmeticPair(x,y), impl=(x,y)->CFArithmetic(:div,x,y) }],
        POW=[{= name=:CFPow, priority=300, prep=(x,y)->CFFamily(x)&&(y ? :Integer), impl=(x,y)->CFArithmetic(:pow,x,y) }],
        NEG=[{= name=:CFNeg, priority=300, prep=(x)->CFFamily(x), impl=(x)->CFArithmetic(:neg,x) }],
        ABS=[{= name=:CFAbs, priority=300, prep=(x)->CFFamily(x), impl=(x)->CFArithmetic(:abs,x) }]
    }
});

.TypeInstall(:ContinuedFractionReal);

continuedFractionNamespace = (value, options ?= {= }) -> CFConstruct(value, options);
continuedFractionNamespace._proto = {=
    Finite = (self, coefficients, options ?= {= }) -> CFFinite(coefficients, options),
    Lazy = (self, coefficientFunction, options ?= {= }) -> CFLazy(coefficientFunction, options),
    Periodic = (self, prefix, period, options ?= {= }) -> CFPeriodic(prefix, period, options),
    Sqrt2 = (self) -> CFSqrt2(),
    FromRational = (self, value, options ?= {= }) -> CFFromRational(value, options),
    Coefficient = (self, real, index, options ?= {= }) -> CFCoefficientAt(real, index, options),
    CoefficientResult = (self, real, index, options ?= {= }) -> CFCoefficientResult(real, index, options),
    Coefficients = (self, real, count ?= _, options ?= {= }) -> CFCoefficients(real, count, options),
    Convergent = (self, real, count) -> CFConvergent(real, count),
    Convergents = (self, real, count ?= _) -> CFConvergents(real, count),
    Enclosure = (self, real, count ?= _) -> CFEnclosureAt(real, count),
    ErrorInterval = (self, real, count) -> CFErrorInterval(real, count),
    QuadraticForm = (self, real) -> CFQuadraticForm(real),
    BestApproximation = (self, real, maxDenominator, options ?= {= }) -> CFBestApproximation(real, maxDenominator, options),
    Translate = (self, real, offset, options ?= {= }) -> CFTranslate(real, offset, options),
    Reciprocal = (self, real, options ?= {= }) -> CFReciprocal(real, options),
    ZeroStatus = (self, real, options ?= {= }) -> CFZeroStatus(real, options),
    Record = (self, real) -> CFRecord(real)
};

.Host.RegisterCallableValue(
    "continuedFraction",
    continuedFractionNamespace,
    "Finite and lazy simple continued fractions with exact convergents and certified enclosures",
    ["Numerics", "Exact"]
);
