/**
id: algebraic-real
description: Exact real algebraic roots certified by canonical Polynomial values and Sturm isolating intervals.
kind: rix
mount: algebraicReal
aliases: [ar]
exports: [Root, Sqrt, Sqrt2, CosTurns, SinTurns, Polynomial, Evaluate, Derivative, SturmSequence, RootCount, RootCountEvidence, IsSquareFree, Refine, Sign, SignEvidence, Compare, CompareRational, ResultantOperation, Export, Import]
groups: [Numerics, Exact, Algebra]
permissions: []
requires: [rix.polynomial.algorithms@1, rix.oracle@1, rix.numerics@1]
provides: [rix.algebraic-real@1, rix.exact-sign@1, rix.root-count@1, rix.refinable@1, rix.enclosable-real@1]
schemas: [rix.algebraic-real@1, rix.algebraic-real.export@1, rix.algebraic-real.arithmetic-real@1, rix.polynomial@1, rix.exact.sign-witness@1, rix.exact.root-count@1]
snapshot: false
deterministic: true
defaultEnabled: false
**/

AROption(options, key, fallback) -> options.Has(key) ?: options[key] ?_ fallback;

ARRequirePositiveInteger(value, label) -> {;
    integer = value ~!: :Integer;
    integer >= 1 ?: integer ?_ .Error(@"@{label} must be a positive Integer");
};

ARScalarIsZero(value, label ?= "value") -> (value ? :Integer)
  ?: (value == 0)
  ?_ ((value ? :Rational)
       ?: (value.Numerator() == 0)
       ?_ .Error(@"Expected an exact Integer or Rational @{label}; received @{value}"));
ARSignOf(value) -> value < 0 ?: -1 ?_ value > 0 ?: 1 ?_ 0;

ARIntegerGcd(left, right) -> {;
    a := (left ~!: :Integer).Abs();
    b := (right ~!: :Integer).Abs();
    {@ step=1; @b!=0; {; remainder=@a%@b; @a ~= @b; @b ~= remainder; }; step+=1 };
    a;
};

ARIntegerLcm(left, right) -> {;
    a = left ~!: :Integer;
    b = right ~!: :Integer;
    ((a==0)||(b==0)) ?: 0 ?_ (a//ARIntegerGcd(a,b)*b).Abs();
};

ARPrimitiveIntegerCoefficients(coefficients) -> {;
    rationals = coefficients.Map((coefficient)->coefficient ~!: :Rational);
    denominator := 1;
    {@ index=1; index<=@rationals.Len(); {;
        @denominator ~= ARIntegerLcm(@denominator,@rationals[index].Denominator());
    }; index+=1 };
    integers = rationals.Map((coefficient)->(coefficient*@denominator).Numerator());
    content := 0;
    {@ index=1; index<=@integers.Len(); {;
        @content ~= ARIntegerGcd(@content,@integers[index]);
    }; index+=1 };
    primitive = integers.Map((coefficient)->coefficient//@content);
    primitive.Last()<0 ?: primitive.Map((coefficient)->-coefficient) ?_ primitive;
};

ARPolynomial(coefficients) -> {;
    coefficients ? :Array ?: _ ?_ .Error("Algebraic-real polynomials require an Array of coefficients");
    candidate = .poly({= coefficients=coefficients, order=:ascending, variable=:x });
    candidate.Degree() >= 1 ?: _ ?_ .Error("Algebraic-real polynomials must have positive degree");
    canonicalCoefficients = ARPrimitiveIntegerCoefficients(candidate.AscendingCoefficients());
    polynomial = .poly({= coefficients=canonicalCoefficients, order=:ascending, variable=:x });
    polynomial.IsSquareFree()
      ?: polynomial
      ?_ .Error("Algebraic-real defining polynomial must be square-free");
};

ARRequirePolynomial(value) -> value ? :Polynomial ?: value ?_ .Error("Expected a Polynomial value");
ARPolynomialEvaluate(polynomial, point) -> ARRequirePolynomial(polynomial).Evaluate(point ~!: :Rational);
ARRootCount(polynomial, interval) -> ARRequirePolynomial(polynomial).RootCount(interval);

ARRequireReal(value) -> {;
    valid = value ? :Map ?: value[:valueKind] == :algebraicReal ?_ _;
    valid ?: value ?_ .Error("Expected an AlgebraicReal value");
};

ARCapabilities(real) -> {=
    valueKind = :numericsCapabilities,
    schema = "rix.numerics.capabilities@1",
    backend = :algebraicReal,
    representation = :squareFreeIntegerPolynomialIsolatingInterval,
    denotation = :singleton,
    operations = [:enclose, :refine],
    evidenceLevels = [:proof],
    certified = 1,
    exactSign = 1,
    exactRationalComparison = 1,
    arbitraryRefinement = 1,
    deterministic = 1,
    minimumWidth = 0,
    maxCalls = 100000,
    maxIterations = 100000
};

ARRefinementState(real, requestedWidth, maxCalls, maxIterations) -> {;
    polynomial = real[:polynomial];
    low := real[:interval].Low();
    high := real[:interval].High();
    lowValue := polynomial.Evaluate(low);
    highValue := polynomial.Evaluate(high);
    calls := 0;
    iterations := 0;
    {@ step = 1;
       ((@high - @low) > @requestedWidth) && (@calls < @maxCalls) && (@iterations < @maxIterations);
       {;
           midpoint = (@low + @high) / 2;
           midpointValue = @polynomial.Evaluate(midpoint);
           ARScalarIsZero(midpointValue)
             ?: {;
                 @low ~= @midpoint;
                 @high ~= @midpoint;
                 @lowValue ~= 0;
                 @highValue ~= 0;
             }
             ?_ ARSignOf(@lowValue) == ARSignOf(midpointValue)
                  ?: {; @low ~= @midpoint; @lowValue ~= @midpointValue; }
                  ?_ {; @high ~= @midpoint; @highValue ~= @midpointValue; };
           @calls += 1;
           @iterations += 1;
       };
       step += 1
    };
    interval = low:high;
    {=
        interval = interval,
        width = interval.Width(),
        midpoint = interval.Midpoint(),
        lowValue = lowValue,
        highValue = highValue,
        calls = calls,
        iterations = iterations
    };
};

ARProtocolEnclosure(real, request, operation) -> {;
    exactReal = ARRequireReal(real);
    capabilities = ARCapabilities(exactReal);
    normalized = .RefinementRequest(request, operation, capabilities);
    requestedWidth = normalized[:absoluteWidth];
    maxCalls = normalized[:work][:maxCalls];
    maxIterations = normalized[:work][:maxIterations];
    state = ARRefinementState(exactReal, requestedWidth, maxCalls, maxIterations);
    goalMet = state[:width] <= requestedWidth;
    status = goalMet ?: :enclosed ?_ :budgetExhausted;
    approximation = .CertifiedApproximation(state[:midpoint], state[:interval], {=
        reason = status,
        requested = requestedWidth,
        achieved = state[:width],
        provider = :algebraicReal
    });
    {=
        valueKind = :enclosure,
        schema = "rix.numerics.enclosure@1",
        status = status,
        interval = state[:interval],
        certified = 1,
        goalMet = goalMet,
        requestedWidth = requestedWidth,
        achievedWidth = state[:width],
        approximation = approximation,
        evidenceLevel = :proof,
        backend = :algebraicReal,
        operation = normalized[:operation],
        trace = [{=
            interval=state[:interval],
            lowValue=state[:lowValue],
            highValue=state[:highValue],
            rootCount=1
        }],
        work = {=
            calls=state[:calls],
            iterations=state[:iterations],
            maxCalls=maxCalls,
            maxIterations=maxIterations,
            exhausted=!goalMet
        },
        diagnostics = goalMet ?: [] ?_ [:maxCallsReached],
        evidence = {=
            kind=:sturmIsolationWithSignBisection,
            property=:containment,
            polynomial=exactReal[:coefficients],
            rootIndex=exactReal[:rootIndex],
            rootCount=1
        },
        source = {=
            plugin=:algebraicReal,
            schema=exactReal[:schema],
            rootIndex=exactReal[:rootIndex]
        }
    };
};

ARExactSign(real) -> {;
    exactReal = ARRequireReal(real);
    interval = exactReal[:interval];
    interval.High() <= 0
      ?: :negative
      ?_ interval.Low() >= 0
           ?: :positive
           ?_ {;
               atZero = @exactReal[:polynomial].Evaluate(0);
               ARScalarIsZero(atZero)
                 ?: :zero
                 ?_ @exactReal[:polynomial].RootCount(@interval.Low():0) == 1
                      ?: :negative
                      ?_ :positive;
           };
};

ARSignEvidence(real) -> {;
    exactReal = ARRequireReal(real);
    witness = {=
        valueKind=:exactSignWitness,
        schema="rix.exact.sign-witness@1",
        property=:sign,
        subjectType=:algebraicReal,
        subject=exactReal,
        at=_,
        value=_,
        sign=ARExactSign(exactReal),
        exact=1,
        certified=1,
        method=:sturmIsolation,
        evidence={=
            polynomial=exactReal[:polynomial],
            interval=exactReal[:interval],
            rootIndex=exactReal[:rootIndex]
        }
    };
    witness._proto = {= Sign=(self)->self[:sign], Record=(self)->self };
    .ImmutableValue(witness);
};

ARCompareRational(real, value) -> {;
    exactReal = ARRequireReal(real);
    rational = value ~!: :Rational;
    interval = exactReal[:interval];
    polynomialValue = exactReal[:polynomial].Evaluate(rational);
    exactMatch = ARScalarIsZero(polynomialValue) ?: interval.ContainsValue(rational) ?_ _;
    exactMatch
      ?: :equal
      ?_ {;
          @rational <= @interval.Low()
            ?: :greater
            ?_ @rational >= @interval.High()
                 ?: :less
                 ?_ @exactReal[:polynomial].RootCount(@interval.Low():@rational) == 1
                      ?: :less
                      ?_ :greater;
      };
};

ARExport(real) -> {;
    exactReal = ARRequireReal(real);
    {=
        valueKind = :algebraicRealExport,
        schema = "rix.algebraic-real.export@1",
        version = 1,
        coefficients = exactReal[:coefficients],
        interval = exactReal[:interval],
        rootIndex = exactReal[:rootIndex],
        name = exactReal[:name],
        evidence = exactReal[:evidence]
    };
};

ARRecord(real) -> {;
    exactReal = ARRequireReal(real);
    {=
        valueKind = :algebraicReal,
        schema = exactReal[:schema],
        polynomial = exactReal[:polynomial],
        coefficients = exactReal[:coefficients],
        interval = exactReal[:interval],
        rootIndex = exactReal[:rootIndex],
        name = exactReal[:name],
        evidence = exactReal[:evidence],
        certified = 1
    };
};

ARAttachProtocol(real) -> {;
    real._proto = {=
        Polynomial = (self) -> self[:polynomial],
        Coefficients = (self) -> self[:coefficients],
        Interval = (self) -> self[:interval],
        RootIndex = (self) -> self[:rootIndex],
        EvaluatePolynomial = (self, point) -> self[:polynomial].Evaluate(point),
        RootCount = (self, interval) -> self[:polynomial].RootCount(interval),
        RootCountEvidence = (self, interval) -> self[:polynomial].RootCountEvidence(interval),
        Sign = (self) -> ARExactSign(self),
        SignEvidence = (self) -> ARSignEvidence(self),
        CompareRational = (self, value) -> ARCompareRational(self, value),
        Record = (self) -> ARRecord(self),
        Export = (self) -> ARExport(self),
        Enclose = (self, request ?= {= }) -> ARProtocolEnclosure(self, request, :enclose),
        Refine = (self, request ?= {= }) -> ARProtocolEnclosure(self, request, :refine),
        NumericsCapabilities = (self) -> ARCapabilities(self)
    };
    .ImmutableValue(real);
};

ARRoot(coefficients, interval, rootIndex ?= 1, options ?= {= }) -> {;
    polynomial = ARPolynomial(coefficients);
    canonical = polynomial.AscendingCoefficients();
    exactInterval = interval ~!: :RationalInterval;
    low = exactInterval.Low();
    high = exactInterval.High();
    low < high ?: _ ?_ .Error("Algebraic-real isolating interval must have increasing endpoints");
    lowValue = polynomial.Evaluate(low);
    highValue = polynomial.Evaluate(high);
    lowIsRoot = ARScalarIsZero(lowValue, "low endpoint evaluation");
    highIsRoot = ARScalarIsZero(highValue, "high endpoint evaluation");
    endpointRoot = lowIsRoot || highIsRoot;
    endpointRoot
      ?: .Error("Algebraic-real isolating endpoints cannot be roots")
      ?_ _;
    sturmSequence = polynomial.SturmSequence();
    isolatedCount = polynomial.RootCount(exactInterval);
    isolatedCount == 1
      ?: _
      ?_ .Error(@"Algebraic-real interval must isolate exactly one distinct real root; found @{isolatedCount}");
    index = ARRequirePositiveInteger(rootIndex, "Algebraic-real root index");
    bound = polynomial.RootBound();
    leftBoundary = low <= -bound ?: low - 1 ?_ -bound;
    computedIndex = polynomial.RootCount(leftBoundary:low) + 1;
    index == computedIndex
      ?: _
      ?_ .Error(@"Algebraic-real root index @{index} does not match certified index @{computedIndex}");
    evidence = {=
        kind = :sturmIsolation,
        property = :uniqueRealRoot,
        squareFree = 1,
        rootCount = isolatedCount,
        rootIndex = computedIndex,
        cauchyBound = bound,
        endpointSigns = [ARSignOf(lowValue), ARSignOf(highValue)],
        sturmLength = sturmSequence.Len(),
        provenance = AROption(options, "evidence", _)
    };
    real = {=
        valueKind = :algebraicReal,
        schema = "rix.algebraic-real@1",
        name = AROption(options, "name", :root),
        polynomial = polynomial,
        coefficients = canonical,
        interval = exactInterval,
        rootIndex = computedIndex,
        sturmSequence = sturmSequence,
        evidence = evidence,
        certified = 1
    };
    ARAttachProtocol(real);
};

ARSqrt2(sign ?= 1) -> {;
    direction = sign ~!: :Integer;
    direction == 1
      ?: ARRoot([-2, 0, 1], 1:2, 2, {=
          name=:sqrt2,
          evidence={= kind=:definingEquation, equation="x^2 - 2 = 0", branch=:positive }
      })
      ?_ direction == -1
           ?: ARRoot([-2, 0, 1], -2:-1, 1, {=
               name=:negativeSqrt2,
               evidence={= kind=:definingEquation, equation="x^2 - 2 = 0", branch=:negative }
           })
           ?_ .Error("Algebraic-real Sqrt2 sign must be 1 or -1");
};

ARImport(record) -> {;
    valid = record ? :Map ?: record[:schema] == "rix.algebraic-real.export@1" ?_ _;
    valid ?: _ ?_ .Error("Expected an algebraic-real export record");
    record[:version] == 1 ?: _ ?_ .Error("Unsupported algebraic-real export version");
    ARRoot(record[:coefficients], record[:interval], record[:rootIndex], {=
        name=record[:name],
        evidence=record[:evidence]
    });
};

ARBase(value) -> (value ? :Map) && value[:valueKind] == :algebraicReal;
ARBaseOrExact(value) -> ARBase(value) || ARExact(value);
ARRationalValue(value) -> ARExact(value)
  ?: value ~!: :Rational
  ?_ (ARBase(value)&&value[:polynomial].Degree()==1)
       ?: -value[:coefficients][1]/value[:coefficients][2]
       ?_ _;
ARBasePair(left, right) ->
  (ARBase(left) || ARBase(right)) && ARBaseOrExact(left) && ARBaseOrExact(right);

ARRationalRoot(value) -> {;
    exact = value ~!: :Rational;
    polynomial = ARPolynomial([-exact,1]);
    interval = (exact-1):(exact+1);
    bound = polynomial.RootBound();
    index = polynomial.RootCount((-bound):interval.Low())+1;
    ARRoot(polynomial.AscendingCoefficients(),interval,index,{=
        name=:rational,
        evidence={= kind=:exactRationalEmbedding, value=exact }
    });
};

ARBasePromote(value) -> ARBase(value) ?: value ?_ ARRationalRoot(value);

ARLinearTransform(value, scale, shift, options ?= {= }) -> {;
    base=ARRequireReal(value); exactScale=scale ~!: :Rational; exactShift=shift ~!: :Rational;
    exactScale==0
      ?: ARRationalRoot(exactShift)
      ?_ {;
          coefficients=ARAffineCoefficients(@base[:coefficients],1/@exactScale,-@exactShift/@exactScale);
          polynomial=ARPolynomial(coefficients);
          interval=@base[:interval]*@exactScale+@exactShift;
          ARRoot(polynomial.AscendingCoefficients(),interval,ARRootIndexForInterval(polynomial,interval),{=
              name=AROption(@options,"name",:affineTransform),
              evidence=AROption(@options,"evidence",{= kind=:exactPolynomialTransform,operation=:affine,scale=@exactScale,shift=@exactShift,operand=@base.Record() })
          });
      };
};

ARZeroArray(length) -> {;
    result := [];
    {@ index=1; index<=@length; {; @result ~= @result.Push(0); }; index+=1 };
    result;
};

ARPower(base, exponent) -> exponent == 0 ?: 1 ?_ base^exponent;

ARArrayAdd(left, right) -> {;
    length = left.Len() > right.Len() ?: left.Len() ?_ right.Len();
    result := ARZeroArray(length);
    {@ index=1; index<=@length; {;
        a = index<=@left.Len() ?: @left[index] ?_ 0;
        b = index<=@right.Len() ?: @right[index] ?_ 0;
        @result ~= @result.Set(index,a+b);
    }; index+=1 };
    result;
};

ARArrayScale(coefficients, scalar) -> coefficients.Map((coefficient)->coefficient*scalar);

ARArrayMultiply(left, right) -> {;
    result := ARZeroArray(left.Len()+right.Len()-1);
    {@ i=1; i<=@left.Len(); {;
        {@ j=1; j<=@right.Len(); {;
            index = @i+j-1;
            @result ~= @result.Set(index,@result[index]+@left[@i]*@right[j]);
        }; j+=1 };
    }; i+=1 };
    result;
};

## Return p(scale*x+shift), in ascending x order, using exact coefficients.
ARAffineCoefficients(coefficients, scale, shift) -> {;
    degree = coefficients.Len()-1;
    result := ARZeroArray(degree+1);
    basis := [1];
    {@ power=0; power<=@degree; {;
        coefficient = @coefficients[power+1];
        @result ~= ARArrayAdd(@result,ARArrayScale(@basis,coefficient));
        power<@degree ?: {; @basis ~= ARArrayMultiply(@basis,[@shift,@scale]); } ?_ _;
    }; power+=1 };
    result;
};

## At the exact parameter z, construct the x-polynomial eliminated with f(x).
AREliminantAt(operation, rightPolynomial, z) -> {;
    coefficients = rightPolynomial.AscendingCoefficients();
    degree = rightPolynomial.Degree();
    operation == :add
      ?: ARAffineCoefficients(coefficients,-1,z)              ## g(z-x)
      ?_ operation == :subtract
           ?: ARAffineCoefficients(coefficients,1,-z)         ## g(x-z)
           ?_ operation == :multiply
                ?: coefficients.Reverse().Map((coefficient,index)->
                    coefficient*ARPower(@z,@degree-index+1))   ## x^m g(z/x)
                ?_ .Error(@"Unsupported algebraic resultant operation @{operation}");
};

ARResultantSample(operation, leftPolynomial, rightPolynomial, z) ->
    operation == :divide
      ?: {; ## alpha/beta=z iff f(z*y)=0 and g(y)=0.
          transformed = ARAffineCoefficients(@leftPolynomial.AscendingCoefficients(),@z,0);
          @rightPolynomial.Resultant(.poly({= coefficients=transformed, order=:ascending, variable=:x }));
      }
      ?_ leftPolynomial.Resultant(.poly({=
          coefficients=AREliminantAt(operation,rightPolynomial,z),
          order=:ascending,
          variable=:x
      }));

ARLagrangeBasis(index, degree) -> {;
    basis := [1];
    denominator := 1;
    {@ j=0; j<=@degree; {;
        j==@index
          ?: _
          ?_ {;
              @basis ~= ARArrayMultiply(@basis,[-@j,1]);
              @denominator *= @index-@j;
          };
    }; j+=1 };
    {= coefficients=basis, denominator=denominator };
};

ARInterpolateResultant(operation, leftPolynomial, rightPolynomial) -> {;
    degree = leftPolynomial.Degree()*rightPolynomial.Degree();
    result := ARZeroArray(degree+1);
    {@ i=0; i<=@degree; {;
        lagrange = ARLagrangeBasis(i,@degree);
        sample = ARResultantSample(@operation,@leftPolynomial,@rightPolynomial,i);
        @result ~= ARArrayAdd(@result,ARArrayScale(lagrange[:coefficients],sample/lagrange[:denominator]));
    }; i+=1 };
    candidate = .poly({= coefficients=result, order=:ascending, variable=:x });
    squareFree = candidate // candidate.Gcd(candidate.Derivative());
    ARPolynomial(squareFree.AscendingCoefficients());
};

AROperandInterval(value, width) -> ARBase(value)
  ?: ARRefinementState(value,width,100000,100000)[:interval]
  ?_ {; exact=@value ~!: :Rational; exact:exact; };

AROperationInterval(operation, left, right, width) -> {;
    leftInterval = AROperandInterval(left,width);
    rightInterval = AROperandInterval(right,width);
    operation == :add
      ?: leftInterval+rightInterval
      ?_ operation == :subtract
           ?: leftInterval-rightInterval
           ?_ operation == :multiply
                ?: leftInterval*rightInterval
                ?_ {;
                    @rightInterval.ContainsZero()
                      ?: _
                      ?_ @leftInterval/@rightInterval;
                };
};

ARIsolatingOperationInterval(polynomial, operation, left, right, options ?= {= }) -> {;
    maxRefinements = ARRequirePositiveInteger(AROption(options,"maxrefinements",128),"Algebraic operation maxRefinements");
    width := AROption(options,"initialwidth",1) ~!: :Rational;
    width > 0 ?: _ ?_ .Error("Algebraic operation initialWidth must be positive");
    candidate := _;
    count := 0;
    attempts := 0;
    endpointRoot := 1;
    {@ step=1; ((@count != 1) || @endpointRoot) && (@attempts < @maxRefinements); {;
        @candidate ~= AROperationInterval(@operation,@left,@right,@width);
        @candidate ? :RationalInterval
          ?: {;
              lowValue = @polynomial.Evaluate(@candidate.Low());
              highValue = @polynomial.Evaluate(@candidate.High());
              @endpointRoot ~= ARScalarIsZero(lowValue) || ARScalarIsZero(highValue);
              @count ~= @endpointRoot ?: 0 ?_ @polynomial.RootCount(@candidate);
          }
          ?_ _;
        @width /= 2;
        @attempts += 1;
    }; step+=1 };
    ((candidate ? :RationalInterval) && (count == 1) && !endpointRoot)
      ?: {= interval=candidate, attempts=attempts, requestedWidth=width*2 }
      ?_ .Error(@"Unable to isolate algebraic @{operation} result within @{maxRefinements} refinements");
};

ARRootIndexForInterval(polynomial, interval) -> {;
    bound = polynomial.RootBound();
    leftBoundary = interval.Low() <= -bound ?: interval.Low()-1 ?_ -bound;
    polynomial.RootCount(leftBoundary:interval.Low())+1;
};

ARResultantOperation(operation, left, right, options ?= {= }) -> {;
    ARBasePair(left,right) ?: _ ?_ .Error("Exact algebraic field operations require AlgebraicReal or Rational operands");
    operation==:divide&&ARBase(right)&&ARExactSign(right)==:zero ?: .Error("Cannot divide by an algebraic zero")
      ?_ operation==:divide&&ARExact(right)&&right==0 ?: .Error("Cannot divide by zero") ?_ _;
    leftRational=ARRationalValue(left); rightRational=ARRationalValue(right);
    rationalResult=(leftRational!=_&&rightRational!=_)
      ?: (operation==:add ?: leftRational+rightRational
           ?_ operation==:subtract ?: leftRational-rightRational
           ?_ operation==:multiply ?: leftRational*rightRational
           ?_ operation==:divide ?: leftRational/rightRational
           ?_ _)
      ?_ _;
    linearShortcut=operation==:add
      ?: ((ARBase(left)&&ARExact(right)) ?: ARLinearTransform(left,1,right,options)
           ?_ ((ARExact(left)&&ARBase(right)) ?: ARLinearTransform(right,1,left,options) ?_ _))
      ?_ (operation==:subtract
           ?: ((ARBase(left)&&ARExact(right)) ?: ARLinearTransform(left,1,-right,options)
                ?_ ((ARExact(left)&&ARBase(right)) ?: ARLinearTransform(right,-1,left,options) ?_ _))
           ?_ (operation==:multiply
                ?: ((ARBase(left)&&ARExact(right)) ?: ARLinearTransform(left,right,0,options)
                     ?_ ((ARExact(left)&&ARBase(right)) ?: ARLinearTransform(right,left,0,options) ?_ _))
                ?_ (operation==:divide
                     ?: ((ARBase(left)&&ARExact(right)) ?: ARLinearTransform(left,1/right,0,options) ?_ _)
                     ?_ _)));
    leftZero=(ARExact(left)&&left==0)||(ARBase(left)&&ARExactSign(left)==:zero);
    rightZero=(ARExact(right)&&right==0)||(ARBase(right)&&ARExactSign(right)==:zero);
    leftOne=ARExact(left)&&left==1; rightOne=ARExact(right)&&right==1;
    shortcut=rationalResult!=_ ?: ARRationalRoot(rationalResult) ?_ (linearShortcut!=_ ?: linearShortcut ?_ (operation==:add
      ?: (leftZero ?: ARBasePromote(right) ?_ (rightZero ?: ARBasePromote(left) ?_ _))
      ?_ (operation==:subtract
           ?: (rightZero ?: ARBasePromote(left) ?_ (leftZero ?: (ARBase(right) ?: ARExactNegate(right) ?_ ARRationalRoot(-right)) ?_ _))
           ?_ (operation==:multiply
                ?: ((leftZero||rightZero) ?: ARRationalRoot(0) ?_ (leftOne ?: ARBasePromote(right) ?_ (rightOne ?: ARBasePromote(left) ?_ _)))
                ?_ (operation==:divide
                     ?: (leftZero ?: ARRationalRoot(0) ?_ (rightOne ?: ARBasePromote(left) ?_ _))
                     ?_ _)))));
    shortcut!=_
      ?: shortcut
      ?_ {;
          a=ARBasePromote(@left); b=ARBasePromote(@right);
          polynomial=ARInterpolateResultant(@operation,a[:polynomial],b[:polynomial]);
          isolation=ARIsolatingOperationInterval(polynomial,@operation,@left,@right,@options);
          interval=isolation[:interval]; index=ARRootIndexForInterval(polynomial,interval);
          ARRoot(polynomial.AscendingCoefficients(),interval,index,{=
              name=AROption(@options,"name",@operation),
              evidence={=
                  kind=:resultantRootIsolation,property=:exactFieldOperation,operation=@operation,
                  elimination=:exactEvaluationAndInterpolation,
                  degreeBound=a[:polynomial].Degree()*b[:polynomial].Degree(),
                  isolationAttempts=isolation[:attempts],operands=[a.Record(),b.Record()]
              }
          });
      };
};

ARExactNegate(value) -> {;
    exact = ARRequireReal(value);
    coefficients = exact[:coefficients].Map((coefficient,index) -> coefficient*((-1)^(index-1)));
    polynomial = ARPolynomial(coefficients);
    low = exact[:interval].Low();
    high = exact[:interval].High();
    interval = (-high):(-low);
    ARRoot(polynomial.AscendingCoefficients(),interval,ARRootIndexForInterval(polynomial,interval),{=
        name=:negate,
        evidence={= kind=:exactPolynomialTransform, operation=:negate, operand=exact.Record() }
    });
};

ARExactPower(value, exponent, options ?= {= }) -> {;
    power = exponent ~!: :Integer;
    power == 0
      ?: ARRationalRoot(1)
      ?_ (power == 1
           ?: value
           ?_ (power == -1
                ?: ARResultantOperation(:divide,1,value,options)
                ?_ (power == 2
                     ?: ARResultantOperation(:multiply,value,value,options)
                     ?_ (power == -2
                          ?: ARResultantOperation(:divide,1,ARResultantOperation(:multiply,value,value,options),options)
                          ?_ {;
          base = @power < 0 ?: ARResultantOperation(:divide,1,@value,@options) ?_ @value;
          state := [ARRationalRoot(1),base,@power.Abs()];
          {@ step=1; @state[3]>0; {;
              @state[3]%2 == 1
                ?: {; @state ~= @state.Set(1,ARResultantOperation(:multiply,@state[1],@state[2],@options)); }
                ?_ _;
              remaining = @state[3]//2;
              @state ~= @state.Set(3,remaining);
              remaining>0
                ?: {; @state ~= @state.Set(2,ARResultantOperation(:multiply,@state[2],@state[2],@options)); }
                ?_ _;
          }; step+=1 };
          state[1];
      }))));
};

ARIntegerSqrtFloor(value) -> {;
    n=value ~!: :Integer;
    n>=0 ?: _ ?_ .Error("Algebraic-real square root requires a nonnegative integer");
    n<2 ?: n ?_ {;
        x:=@n; next:=(x+1)//2;
        {@ step=1; @next<@x; {; @x~=@next; @next~=(@x+(@n//@x))//2; }; step+=1 };
        x;
    };
};

ARRationalExactSqrt(value) -> {;
    exact=value ~!: :Rational;
    exact<0 ?: _ ?_ {;
        numerator=ARIntegerSqrtFloor(@exact.Numerator());
        denominator=ARIntegerSqrtFloor(@exact.Denominator());
        numerator^2==@exact.Numerator()&&denominator^2==@exact.Denominator()
          ?: numerator/denominator
          ?_ _;
    };
};

ARRationalSqrtBracket(value, iterations ?= 96) -> {;
    exact=value ~!: :Rational;
    exact>0 ?: _ ?_ .Error("Algebraic-real square-root bracketing requires a positive Rational");
    exactRoot=ARRationalExactSqrt(exact);
    exactRoot!=_
      ?: {; epsilon=1/(2^((@iterations ~!: :Integer)+4)); (@exactRoot-epsilon):(@exactRoot+epsilon); }
      ?_ {;
          low:=0; high:=@exact>=1 ?: @exact ?_ 1;
          {@ step=1; step<=@iterations; {;
              midpoint=(@low+@high)/2;
              midpoint^2<@exact ?: {; @low~=@midpoint; } ?_ {; @high~=@midpoint; };
          }; step+=1 };
          low:high;
      };
};

ARSquareFreePolynomial(coefficients) -> {;
    candidate=.poly({= coefficients=coefficients, order=:ascending, variable=:x });
    squareFree=candidate // candidate.Gcd(candidate.Derivative());
    ARPolynomial(squareFree.AscendingCoefficients());
};

ARSqrtPolynomial(value) -> {;
    base=ARBasePromote(value);
    source=base[:polynomial].AscendingCoefficients();
    expanded:=ARZeroArray(2*(source.Len()-1)+1);
    {@ index=1; index<=@source.Len(); {;
        @expanded ~= @expanded.Set(2*(index-1)+1,@source[index]);
    }; index+=1 };
    ARSquareFreePolynomial(expanded);
};

ARSqrtIsolation(polynomial, value, options ?= {= }) -> {;
    maxRefinements=ARRequirePositiveInteger(AROption(options,"maxrefinements",128),"Algebraic square-root maxRefinements");
    width:=AROption(options,"initialwidth",1) ~!: :Rational;
    candidate:=_; count:=0; endpointRoot:=1; attempts:=0;
    {@ step=1; ((@count!=1)||@endpointRoot)&&@attempts<@maxRefinements; {;
        source=AROperandInterval(@value,@width);
        source.Low()>0
          ?: {;
              lower=ARRationalSqrtBracket(@source.Low());
              upper=ARRationalSqrtBracket(@source.High());
              @candidate ~= lower.Low():upper.High();
              lowValue=@polynomial.Evaluate(@candidate.Low());
              highValue=@polynomial.Evaluate(@candidate.High());
              @endpointRoot ~= ARScalarIsZero(lowValue)||ARScalarIsZero(highValue);
              @count ~= @endpointRoot ?: 0 ?_ @polynomial.RootCount(@candidate);
          }
          ?_ _;
        @width/=2; @attempts+=1;
    }; step+=1 };
    ((candidate ? :RationalInterval)&&count==1&&!endpointRoot)
      ?: {= interval=candidate, attempts=attempts }
      ?_ .Error(@"Unable to isolate algebraic square root within @{maxRefinements} refinements");
};

ARSqrt(value, options ?= {= }) -> {;
    ARBaseOrExact(value) ?: _ ?_ .Error("Algebraic-real Sqrt requires an AlgebraicReal or Rational");
    sign=ARBase(value) ?: ARExactSign(value) ?_ (value<0 ?: :negative ?_ value>0 ?: :positive ?_ :zero);
    sign==:negative ?: .Error("Algebraic-real Sqrt requires a nonnegative value") ?_ _;
    sign==:zero
      ?: ARRationalRoot(0)
      ?_ {;
          rationalRoot=ARExact(@value) ?: ARRationalExactSqrt(@value) ?_ _;
          rationalRoot!=_
            ?: ARRationalRoot(rationalRoot)
            ?_ {;
                polynomial=ARSqrtPolynomial(@value);
                isolation=ARSqrtIsolation(polynomial,@value,@options);
                ARRoot(polynomial.AscendingCoefficients(),isolation[:interval],ARRootIndexForInterval(polynomial,isolation[:interval]),{=
                    name=AROption(@options,"name",:sqrt),
                    evidence={=
                        kind=:algebraicRootIsolation,
                        property=:nonnegativeSquareRoot,
                        isolationAttempts=isolation[:attempts],
                        radicand=ARBase(@value) ?: @value.Record() ?_ @value
                    }
                });
            };
      };
};

ARTchebyshev(degree) -> {;
    n=ARRequirePositiveInteger(degree,"Chebyshev degree");
    n==1 ?: [0,1] ?_ {;
        previous:=[1]; current:=[0,1];
        {@ index=2; index<=@n; {;
            next=ARArrayAdd(ARArrayScale(ARArrayMultiply([0,1],@current),2),ARArrayScale(@previous,-1));
            @previous~=@current; @current~=next;
        }; index+=1 };
        current;
    };
};

ARCosinePolynomial(denominator) -> {;
    coefficients=ARTchebyshev(denominator);
    adjusted=coefficients.Set(1,coefficients[1]-1);
    ARSquareFreePolynomial(adjusted);
};

ARCertifiedRoot(polynomial, provider, options ?= {= }) -> {;
    maxRefinements=ARRequirePositiveInteger(AROption(options,"maxrefinements",48),"Certified algebraic-root maxRefinements");
    maxWork=ARRequirePositiveInteger(AROption(options,"maxwork",512),"Certified algebraic-root maxWork");
    width:=1/16; candidate:=_; count:=0; endpointRoot:=1; attempts:=0;
    {@ step=1; ((@count!=1)||@endpointRoot)&&@attempts<@maxRefinements; {;
        refined=.numerics.Refine(@provider,{= absoluteWidth=@width,maxWork=@maxWork });
        refined.Has("interval")
          ?: {;
              @candidate ~= @refined[:interval];
              lowValue=@polynomial.Evaluate(@candidate.Low()); highValue=@polynomial.Evaluate(@candidate.High());
              @endpointRoot ~= ARScalarIsZero(lowValue)||ARScalarIsZero(highValue);
              @count ~= @endpointRoot ?: 0 ?_ @polynomial.RootCount(@candidate);
          }
          ?_ _;
        @width/=2; @attempts+=1;
    }; step+=1 };
    ((candidate ? :RationalInterval)&&count==1&&!endpointRoot)
      ?: {= interval=candidate, attempts=attempts }
      ?_ .Error(@"Unable to certify the requested algebraic root within @{maxRefinements} refinements");
};

ARTurnData(turns, options ?= {= }) -> {;
    exact=turns ~!: :Rational;
    denominator=exact.Denominator();
    maximum=ARRequirePositiveInteger(AROption(options,"maxdenominator",64),"Rational-turn maxDenominator");
    denominator<=maximum ?: _ ?_ .Error(@"Rational-turn denominator @{denominator} exceeds maxDenominator @{maximum}");
    raw=exact.Numerator()%denominator;
    numerator=raw<0 ?: raw+denominator ?_ raw;
    {= turns=numerator/denominator,numerator=numerator,denominator=denominator };
};

ARCosTurns(turns, options ?= {= }) -> {;
    data=ARTurnData(turns,options); p=data[:numerator]; q=data[:denominator];
    known=p==0 ?: 1
      ?_ (2*p==q ?: -1
           ?_ ((4*p==q||4*p==3*q) ?: 0
                ?_ ((6*p==q||6*p==5*q) ?: 1/2
                     ?_ ((3*p==q||3*p==2*q) ?: -1/2 ?_ _))));
    known!=_
      ?: ARRationalRoot(known)
      ?_ ((q==8&&(p==1||p==7)) ?: ARLinearTransform(ARSqrt(2),1/2,0,{= name=:cosRationalTurn,evidence={= kind=:rootOfUnityProjection,function=:cos,turns=data[:turns],denominator=q,special=:sqrt2Half } })
           ?_ (q==8&&(p==3||p==5)) ?: ARLinearTransform(ARSqrt(2),-1/2,0,{= name=:cosRationalTurn,evidence={= kind=:rootOfUnityProjection,function=:cos,turns=data[:turns],denominator=q,special=:negativeSqrt2Half } })
           ?_ (q==12&&(p==1||p==11)) ?: ARLinearTransform(ARSqrt(3),1/2,0,{= name=:cosRationalTurn,evidence={= kind=:rootOfUnityProjection,function=:cos,turns=data[:turns],denominator=q,special=:sqrt3Half } })
           ?_ (q==12&&(p==5||p==7)) ?: ARLinearTransform(ARSqrt(3),-1/2,0,{= name=:cosRationalTurn,evidence={= kind=:rootOfUnityProjection,function=:cos,turns=data[:turns],denominator=q,special=:negativeSqrt3Half } })
           ?_ {;
               polynomial=ARCosinePolynomial(@q);
               provider=.numerics.Cos(@data[:turns]*2*.numerics.Pi());
               isolation=ARCertifiedRoot(polynomial,provider,@options);
               ARRoot(polynomial.AscendingCoefficients(),isolation[:interval],ARRootIndexForInterval(polynomial,isolation[:interval]),{=
                   name=:cosRationalTurn,
                   evidence={= kind=:rootOfUnityProjection, function=:cos, turns=@data[:turns], denominator=@q, isolationAttempts=isolation[:attempts] }
               });
           });
};

ARSinTurns(turns, options ?= {= }) -> ARCosTurns(1/4-(turns ~!: :Rational),options);

ARCompare(left, right, options ?= {= }) -> {;
    (ARBase(left) && ARExact(right))
      ?: ARCompareRational(left,right)
      ?_ ((ARExact(left) && ARBase(right))
           ?: {;
               reversed = ARCompareRational(@right,@left);
               reversed == :less ?: :greater ?_ (reversed == :greater ?: :less ?_ :equal);
           }
           ?_ {;
               difference = ARResultantOperation(:subtract,@left,@right,@options);
               sign = ARExactSign(difference);
               sign == :negative ?: :less ?_ (sign == :positive ?: :greater ?_ :equal);
           });
};

ARComparisonTruth(comparison, relation) -> relation == :eq
  ?: comparison == :equal
  ?_ (relation == :neq
       ?: comparison != :equal
       ?_ (relation == :lt
            ?: comparison == :less
            ?_ (relation == :lte
                 ?: comparison != :greater
                 ?_ (relation == :gt
                      ?: comparison == :greater
                      ?_ comparison != :less))));

ARFamily(value) -> (value ? :Map) &&
  (value[:valueKind] == :algebraicReal || value[:valueKind] == :algebraicRealArithmeticReal);
ARExact(value) -> (value ? :Integer) || (value ? :Rational);
ARArithmeticPair(left, right) ->
  (ARFamily(left) || ARFamily(right)) &&
  (ARFamily(left) || ARExact(left)) &&
  (ARFamily(right) || ARExact(right));

ARArithmeticCapabilities(real) -> {=
    valueKind=:numericsCapabilities,
    schema="rix.numerics.capabilities@1",
    backend=:algebraicReal,
    representation=:oracleBackedAlgebraicArithmetic,
    denotation=:singleton,
    operations=[:enclose, :refine],
    evidenceLevels=[:constructorGuarantee, :proof],
    certified=1,
    arbitraryRefinement=1,
    deterministic=1,
    minimumWidth=0,
    maxCalls=100000,
    maxIterations=100000
};

ARArithmetic(operation, left, right ?= _) -> {;
    unary = operation == :neg || operation == :abs;
    recipe = unary ?: .oracle.Operation(operation, left) ?_ .oracle.Operation(operation, left, right);
    real = {=
        valueKind=:algebraicRealArithmeticReal,
        schema="rix.algebraic-real.arithmetic-real@1",
        kind=:arithmetic,
        operation=operation,
        recipe=recipe,
        provenance={= plugin=:algebraicReal, version=2, source=:arithmeticRecipe }
    };
    real._proto = {=
        Enclose=(self, request ?= {= })->self[:recipe].Enclose(request),
        Refine=(self, request ?= {= })->self[:recipe].Refine(request),
        NumericsCapabilities=(self)->ARArithmeticCapabilities(self),
        Record=(self)->{= valueKind=self[:valueKind], schema=self[:schema], operation=self[:operation], certified=1 }
    };
    .ImmutableValue(real ~!: :AlgebraicReal);
};

.TypeKnown(:AlgebraicReal) ?: _ ?_ .TypeRegister({=
    name=:AlgebraicReal,
    nativeType=:map,
    defaultTraits=[:number, :ordered],
    convertFrom={= map=(x) ?- [ARFamily(x)] -> x },
    validate=(x)->ARFamily(x),
    proto={=
        Enclose=(self,request ?= {= })->self[:kind] == :arithmetic ?: self[:recipe].Enclose(request) ?_ ARProtocolEnclosure(self,request,:enclose),
        Refine=(self,request ?= {= })->self[:kind] == :arithmetic ?: self[:recipe].Refine(request) ?_ ARProtocolEnclosure(self,request,:refine),
        NumericsCapabilities=(self)->self[:kind] == :arithmetic ?: ARArithmeticCapabilities(self) ?_ ARCapabilities(self),
        Compare=(self,other,options ?= {= })->ARCompare(self,other,options),
        ResultantOperation=(self,operation,other,options ?= {= })->ARResultantOperation(operation,self,other,options),
        Record=(self)->self[:kind] == :arithmetic ?: {= valueKind=self[:valueKind],schema=self[:schema],operation=self[:operation],certified=1 } ?_ ARRecord(self),
        Export=(self)->ARExport(self)
    },
    installs={=
        ADD=[
            {= name=:ARExactAdd, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARResultantOperation(:add,x,y) },
            {= name=:ARAdd, priority=300, prep=(x,y)->ARArithmeticPair(x,y), impl=(x,y)->ARArithmetic(:add,x,y) }
        ],
        SUB=[
            {= name=:ARExactSub, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARResultantOperation(:subtract,x,y) },
            {= name=:ARSub, priority=300, prep=(x,y)->ARArithmeticPair(x,y), impl=(x,y)->ARArithmetic(:sub,x,y) }
        ],
        MUL=[
            {= name=:ARExactMul, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARResultantOperation(:multiply,x,y) },
            {= name=:ARMul, priority=300, prep=(x,y)->ARArithmeticPair(x,y), impl=(x,y)->ARArithmetic(:mul,x,y) }
        ],
        DIV=[
            {= name=:ARExactDiv, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARResultantOperation(:divide,x,y) },
            {= name=:ARDiv, priority=300, prep=(x,y)->ARArithmeticPair(x,y), impl=(x,y)->ARArithmetic(:div,x,y) }
        ],
        POW=[
            {= name=:ARExactPow, priority=320, prep=(x,y)->ARBase(x)&&(y ? :Integer), impl=(x,y)->ARExactPower(x,y) },
            {= name=:ARPow, priority=300, prep=(x,y)->ARFamily(x)&&(y ? :Integer), impl=(x,y)->ARArithmetic(:pow,x,y) }
        ],
        NEG=[
            {= name=:ARExactNeg, priority=320, prep=(x)->ARBase(x), impl=(x)->ARExactNegate(x) },
            {= name=:ARNeg, priority=300, prep=(x)->ARFamily(x), impl=(x)->ARArithmetic(:neg,x) }
        ],
        ABS=[
            {= name=:ARExactAbs, priority=320, prep=(x)->ARBase(x), impl=(x)->ARExactSign(x)==:negative ?: ARExactNegate(x) ?_ x },
            {= name=:ARAbs, priority=300, prep=(x)->ARFamily(x), impl=(x)->ARArithmetic(:abs,x) }
        ],
        EQ=[{= name=:ARExactEq, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARComparisonTruth(ARCompare(x,y),:eq) }],
        NEQ=[{= name=:ARExactNeq, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARComparisonTruth(ARCompare(x,y),:neq) }],
        LT=[{= name=:ARExactLt, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARComparisonTruth(ARCompare(x,y),:lt) }],
        LTE=[{= name=:ARExactLte, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARComparisonTruth(ARCompare(x,y),:lte) }],
        GT=[{= name=:ARExactGt, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARComparisonTruth(ARCompare(x,y),:gt) }],
        GTE=[{= name=:ARExactGte, priority=320, prep=(x,y)->ARBasePair(x,y), impl=(x,y)->ARComparisonTruth(ARCompare(x,y),:gte) }]
    }
});

.TypeInstall(:AlgebraicReal);

ARConstruct(coefficients, interval, rootIndex ?= 1, options ?= {= }) ->
    ARRoot(coefficients, interval, rootIndex, options);

algebraicRealNamespace = (coefficients, interval, rootIndex ?= 1, options ?= {= }) ->
    ARConstruct(coefficients, interval, rootIndex, options);
algebraicRealNamespace._proto = {=
    Root = (self, coefficients, interval, rootIndex ?= 1, options ?= {= }) -> ARRoot(coefficients, interval, rootIndex, options),
    Sqrt = (self, value, options ?= {= }) -> ARSqrt(value, options),
    Sqrt2 = (self, sign ?= 1) -> ARSqrt2(sign),
    CosTurns = (self, turns, options ?= {= }) -> ARCosTurns(turns, options),
    SinTurns = (self, turns, options ?= {= }) -> ARSinTurns(turns, options),
    Polynomial = (self, coefficients) -> ARPolynomial(coefficients),
    Evaluate = (self, coefficients, point) -> ARPolynomial(coefficients).Evaluate(point),
    Derivative = (self, coefficients) -> ARPolynomial(coefficients).Derivative(),
    SturmSequence = (self, coefficients) -> ARPolynomial(coefficients).SturmSequence(),
    RootCount = (self, coefficients, interval) -> ARPolynomial(coefficients).RootCount(interval),
    RootCountEvidence = (self, coefficients, interval) -> ARPolynomial(coefficients).RootCountEvidence(interval),
    IsSquareFree = (self, coefficients) -> {; candidate=.poly({= coefficients=coefficients, order=:ascending, variable=:x }); candidate.IsSquareFree(); },
    Refine = (self, real, request ?= {= }) -> ARProtocolEnclosure(real, request, :refine),
    Sign = (self, real) -> ARExactSign(real),
    SignEvidence = (self, real) -> ARSignEvidence(real),
    Compare = (self, left, right, options ?= {= }) -> ARCompare(left, right, options),
    CompareRational = (self, real, value) -> ARCompareRational(real, value),
    ResultantOperation = (self, operation, left, right, options ?= {= }) -> ARResultantOperation(operation, left, right, options),
    Export = (self, real) -> ARExport(real),
    Import = (self, record) -> ARImport(record)
};

.Host.RegisterCallableValue(
    "algebraicReal",
    algebraicRealNamespace,
    "Exact real algebraic roots certified by canonical Polynomial values and Sturm isolating intervals",
    ["Numerics", "Exact", "Algebra"]
);
