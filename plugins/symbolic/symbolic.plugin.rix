/**
id: symbolic
description: Meta-plugin joining representation-sensitive FractionFunction work with portable abstract Calculus expressions.
kind: rix
mount: symbolic
exports: [Fraction, FractionFunction, CalculusExpression, Evaluate, EvaluateResult, SimplifyResult, CheckSimplification, RewriteResult, CheckRewrite, Differentiate, DifferentiateResult, DifferentiateN, DifferentiateNResult, Partial, PartialResult, Gradient, GradientResult, Jacobian, JacobianResult, Hessian, HessianResult, SelectedPrimitive, AntiderivativeFamily, DefiniteIntegral, Obligations, Transformations, FindTransformations, Transformation, Services]
groups: [Algebra, Calculus, Analysis, Exact, Symbolic]
permissions: []
requires: [rix.fraction-function@1, rix.calculus@1]
provides: [rix.symbolic.formal@1, rix.symbolic.transformations@1]
schemas: [rix.symbolic.transformation-descriptor@1]
snapshot: false
deterministic: true
defaultEnabled: false
**/

SymbolicNonFractionCalculusExpression(value) ->
    .calculus.IsExpression(value)
      ?: value
      ?_ ((value ? :Integer) || (value ? :Rational))
           ?: .calculus.Constant(value)
           ?_ .calculus.FromSpec(value);
SymbolicCalculusExpression(value) ->
    value ? :FractionFunction
      ?: value.CalculusExpression()
      ?_ SymbolicNonFractionCalculusExpression(value);
SymbolicFractionObligations(value) ->
    value.RestrictionExpressions().Reduce((result,expression)->
        result.Push(.calculus.Obligation(:domain,:nonzero,expression,{= reason=:fractionFunctionSourceDomain })),
        []
    );
SymbolicTransformationObligations(value) ->
    .calculus.IsTransformation(value)
      ?: value[:obligations]
      ?_ [];
SymbolicObligations(value) ->
    value ? :FractionFunction
      ?: SymbolicFractionObligations(value)
      ?_ SymbolicTransformationObligations(value);
SymbolicEvaluationTarget(value) ->
    .calculus.IsTransformation(value) ?: value ?_ SymbolicCalculusExpression(value);
SymbolicCalculusExpressions(values) ->
    values.Map((value)->SymbolicCalculusExpression(value));
SymbolicAppend(left, right) -> right.Reduce((result,value)->result.Push(value),left);
SymbolicIntegralOptions(value, options) -> {;
    options ? :Map ?: _ ?_ .Error("Symbolic integral options must be a Map");
    inherited = SymbolicObligations(value);
    supplied = options.Has("obligations") ?: options[:obligations] ?_ [];
    options.Set("obligations",SymbolicAppend(inherited,supplied));
};

SymbolicTransformationDescriptor(id, owner, operation, category, inputs, result, domainPolicy, verification, call, summary) ->
    .ImmutableValue({=
        schema="rix.symbolic.transformation-descriptor@1",
        id=id,
        owner=owner,
        mount=owner,
        operation=operation,
        category=category,
        inputs=.ImmutableValue(inputs),
        result=result,
        exact=1,
        domainPolicy=domainPolicy,
        verification=verification,
        call=call,
        summary=summary
    });

symbolicTransformationCatalog = .ImmutableValue([
    SymbolicTransformationDescriptor(
        "fracfun.simplify","fracfun","Simplify",:formal,[:FractionFunction],:FractionFunction,
        :preserveSource,:structural,"value.Simplify()","Apply safe form identities without crossing the canonical boundary."
    ),
    SymbolicTransformationDescriptor(
        "fracfun.expand","fracfun","Expand",:formal,[:FractionFunction],:FractionFunction,
        :preserveSource,:structural,"value.Expand()","Distribute products while retaining the source-domain evaluation form."
    ),
    SymbolicTransformationDescriptor(
        "fracfun.together","fracfun","Together",:formal,[:FractionFunction],:FractionFunction,
        :preserveSource,:structural,"value.Together()","Collect a displayed expression over a common denominator."
    ),
    SymbolicTransformationDescriptor(
        "fracfun.recenter","fracfun","Recenter",:formal,[:FractionFunction],:FractionFunction,
        :preserveSource,:structural,"value.Recenter(center)","Rewrite a polynomial form around an explicit center."
    ),
    SymbolicTransformationDescriptor(
        "fracfun.cancel","fracfun","Cancel",:formal,[:FractionFunction],:FractionFunction,
        :preserveSource,:exactReconstruction,"value.Cancel()","Cancel displayed factors while preserving holes from original denominators."
    ),
    SymbolicTransformationDescriptor(
        "fracfun.forget-restrictions","fracfun","ForgetRestrictions",:formal,[:FractionFunction],:FractionFunction,
        :explicitForget,:explicitRequest,"value.ForgetRestrictions()","Explicitly discard original denominator restrictions."
    ),
    SymbolicTransformationDescriptor(
        "poly.square-free","poly","SquareFreeDecomposition",:canonical,[:Polynomial],:Decomposition,
        :canonical,:exactReconstruction,".poly.SquareFreeDecomposition(value)","Decompose a canonical polynomial into square-free factors."
    ),
    SymbolicTransformationDescriptor(
        "poly.factor-evidence","poly","FactorEvidence",:canonical,[:Polynomial],:Evidence,
        :canonical,:exactReconstruction,".poly.FactorEvidence(value)","Return exact factor evidence with a reconstruction check."
    ),
    SymbolicTransformationDescriptor(
        "ratfun.together","ratfun","Together",:canonical,[:RationalFunction],:TogetherPresentation,
        :canonical,:exactReconstruction,".ratfun.Together(value)","Build a canonical single-quotient presentation."
    ),
    SymbolicTransformationDescriptor(
        "ratfun.factored","ratfun","Factored",:canonical,[:RationalFunction],:FactoredPresentation,
        :canonical,:exactReconstruction,".ratfun.Factored(value)","Build a factored numerator and denominator presentation."
    ),
    SymbolicTransformationDescriptor(
        "ratfun.partial-fractions","ratfun","PartialFractions",:canonical,[:RationalFunction],:PartialFractionPresentation,
        :canonical,:exactReconstruction,".ratfun.PartialFractions(value)","Build an exact partial-fraction presentation when supported."
    ),
    SymbolicTransformationDescriptor(
        "ratfun.pole-zero-evidence","ratfun","PoleZeroEvidence",:canonical,[:RationalFunction],:Evidence,
        :canonical,:exactReconstruction,".ratfun.PoleZeroEvidence(value)","Expose exact poles, zeros, multiplicities, and reconstruction evidence."
    ),
    SymbolicTransformationDescriptor(
        "ratfun.expand-presentation","ratfun","Expand",:canonical,[:RationalFunctionPresentation],:RationalFunction,
        :canonical,:exactReconstruction,".ratfun.Expand(presentation)","Recover the canonical rational function represented by a presentation."
    ),
    SymbolicTransformationDescriptor(
        "calculus.simplify","calculus","SimplifyResult",:calculus,[:CalculusExpression],:Transformation,
        :preserveSource,:checkedRewrite,".calculus.SimplifyResult(expression)","Apply checked unconditional graph simplifications without filling domain holes."
    ),
    SymbolicTransformationDescriptor(
        "calculus.differentiate","calculus","DifferentiateResult",:calculus,[:CalculusExpression],:Transformation,
        :obligationPreserving,:ruleEvidence,".calculus.DifferentiateResult(expression,variable)","Differentiate exactly and retain rule evidence and obligations."
    ),
    SymbolicTransformationDescriptor(
        "calculus.differentiate-n","calculus","DifferentiateNResult",:calculus,[:CalculusExpression],:Transformation,
        :obligationPreserving,:ruleEvidence,".calculus.DifferentiateNResult(expression,variable,order)","Apply exact differentiation repeatedly with accumulated evidence."
    ),
    SymbolicTransformationDescriptor(
        "calculus.gradient","calculus","GradientResult",:calculus,[:CalculusExpression],:Transformation,
        :obligationPreserving,:ruleEvidence,".calculus.GradientResult(expression,variables)","Construct an ordered exact gradient and its evidence."
    ),
    SymbolicTransformationDescriptor(
        "calculus.jacobian","calculus","JacobianResult",:calculus,[:CalculusExpressionArray],:Transformation,
        :obligationPreserving,:ruleEvidence,".calculus.JacobianResult(expressions,variables)","Construct an ordered exact Jacobian and its evidence."
    ),
    SymbolicTransformationDescriptor(
        "calculus.hessian","calculus","HessianResult",:calculus,[:CalculusExpression],:Transformation,
        :obligationPreserving,:ruleEvidence,".calculus.HessianResult(expression,variables)","Construct an ordered exact Hessian and its evidence."
    ),
    SymbolicTransformationDescriptor(
        "calculus.selected-primitive","calculus","SelectedPrimitive",:calculus,[:CalculusExpression],:IntegralRecord,
        :obligationPreserving,:formulation,".calculus.SelectedPrimitive(integrand,variable,primitive,options)","Record a selected primitive together with explicit obligations."
    ),
    SymbolicTransformationDescriptor(
        "calculus.antiderivative-family","calculus","AntiderivativeFamily",:calculus,[:CalculusExpression],:IntegralRecord,
        :obligationPreserving,:formulation,".calculus.AntiderivativeFamily(integrand,variable,primitive,constant,options)","Record an antiderivative family without claiming automatic integration."
    ),
    SymbolicTransformationDescriptor(
        "calculus.definite-integral","calculus","DefiniteIntegral",:calculus,[:CalculusExpression],:IntegralRecord,
        :obligationPreserving,:formulation,".calculus.DefiniteIntegral(integrand,variable,lower,upper,options)","Record a definite integral and its domain obligations."
    )
]);

SymbolicTransformationHasInput(descriptor, options) -> {;
    options.Has("input") ?: {;
        desired = @options[:input];
        @descriptor[:inputs].Filter((input)->input==@desired).Len()>0;
    } ?_ 1;
};
SymbolicTransformationOptionMatches(descriptor, options, key) ->
    options.Has(key) ?: descriptor.Get(key)==options.Get(key) ?_ 1;
SymbolicTransformationMatches(descriptor, options) -> {;
    ownerMatches = SymbolicTransformationOptionMatches(descriptor,options,"owner");
    categoryMatches = SymbolicTransformationOptionMatches(descriptor,options,"category");
    operationMatches = SymbolicTransformationOptionMatches(descriptor,options,"operation");
    domainMatches = SymbolicTransformationOptionMatches(descriptor,options,"domainpolicy");
    ownerMatches && categoryMatches && operationMatches && domainMatches &&
        SymbolicTransformationHasInput(descriptor,options);
};
SymbolicFindTransformations(options ?= {= }) -> {;
    options ? :Map ?: _ ?_ .Error("Symbolic transformation filters must be a Map");
    symbolicTransformationCatalog.Filter((descriptor)->SymbolicTransformationMatches(descriptor,@options));
};
SymbolicTransformation(id) -> {;
    id ? :String ?: _ ?_ .Error("Symbolic transformation id must be a String");
    matches = symbolicTransformationCatalog.Filter((descriptor)->descriptor[:id]==@id);
    matches.Len()==1 ?: matches[1] ?_ .Error(@"Unknown symbolic transformation @{id}");
};

symbolicNamespace = {= };
symbolicNamespace._proto = {=
    Fraction = (self, first, second ?= _) -> second == _ ?: .fraction(first) ?_ .fraction(first,second),
    FractionFunction = (self, value, variable ?= _) -> variable == _ ?: .fracfun(value) ?_ .fracfun(value,variable),
    CalculusExpression = (self, value) -> SymbolicCalculusExpression(value),
    Evaluate = (self, value, bindings ?= {= }, options ?= {= }) ->
        .calculus.Evaluate(SymbolicEvaluationTarget(value),bindings,options),
    EvaluateResult = (self, value, bindings ?= {= }, options ?= {= }) ->
        .calculus.EvaluateResult(SymbolicEvaluationTarget(value),bindings,options),
    SimplifyResult = (self, value) ->
        .CalculusGraphSimplify(self.CalculusExpression(value)),
    CheckSimplification = (self, result) ->
        .CalculusGraphSimplificationCheck(result),
    RewriteResult = (self, source, target, theorem) ->
        .CalculusGraphRewrite(
            self.CalculusExpression(source),
            self.CalculusExpression(target),
            theorem
        ),
    CheckRewrite = (self, result) -> .CalculusGraphRewriteCheck(result),
    Differentiate = (self, value, variable) ->
        .calculus.Differentiate(self.CalculusExpression(value),variable),
    DifferentiateResult = (self, value, variable) ->
        .calculus.DifferentiateResult(self.CalculusExpression(value),variable),
    DifferentiateN = (self, value, variable, order) ->
        .calculus.DifferentiateN(self.CalculusExpression(value),variable,order),
    DifferentiateNResult = (self, value, variable, order) ->
        .calculus.DifferentiateNResult(self.CalculusExpression(value),variable,order),
    Partial = (self, value, variable) ->
        .calculus.Partial(self.CalculusExpression(value),variable),
    PartialResult = (self, value, variable) ->
        .calculus.PartialResult(self.CalculusExpression(value),variable),
    Gradient = (self, value, variables) ->
        .calculus.Gradient(self.CalculusExpression(value),variables),
    GradientResult = (self, value, variables) ->
        .calculus.GradientResult(self.CalculusExpression(value),variables),
    Jacobian = (self, values, variables) ->
        .calculus.Jacobian(SymbolicCalculusExpressions(values),variables),
    JacobianResult = (self, values, variables) ->
        .calculus.JacobianResult(SymbolicCalculusExpressions(values),variables),
    Hessian = (self, value, variables) ->
        .calculus.Hessian(self.CalculusExpression(value),variables),
    HessianResult = (self, value, variables) ->
        .calculus.HessianResult(self.CalculusExpression(value),variables),
    SelectedPrimitive = (self, integrand, variable, primitive, options ?= {= }) ->
        .calculus.SelectedPrimitive(
            self.CalculusExpression(integrand),
            variable,
            self.CalculusExpression(primitive),
            SymbolicIntegralOptions(integrand,options)
        ),
    AntiderivativeFamily = (self, integrand, variable, primitive, constant ?= :C, options ?= {= }) ->
        .calculus.AntiderivativeFamily(
            self.CalculusExpression(integrand),
            variable,
            self.CalculusExpression(primitive),
            constant,
            SymbolicIntegralOptions(integrand,options)
        ),
    DefiniteIntegral = (self, integrand, variable, lower, upper, options ?= {= }) ->
        .calculus.DefiniteIntegral(
            self.CalculusExpression(integrand),
            variable,
            lower,
            upper,
            SymbolicIntegralOptions(integrand,options)
        ),
    Obligations = (self, value) -> SymbolicObligations(value),
    Transformations = (self, options ?= {= }) -> SymbolicFindTransformations(options),
    FindTransformations = (self, options ?= {= }) -> SymbolicFindTransformations(options),
    Transformation = (self, id) -> SymbolicTransformation(id),
    Services = (self) -> ["fraction","fracfun","poly","ratfun","calculus"]
};

.Host.RegisterValue("symbolic",symbolicNamespace,"Representation-sensitive symbolic and abstract Calculus workspace",["Algebra","Calculus","Analysis","Exact","Symbolic"]);
