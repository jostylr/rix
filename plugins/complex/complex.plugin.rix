/**
id: complex
description: Representation-generic certified complex singletons over RiX real backends.
kind: rix
mount: complex
exports: [FromParts, Real, Imaginary, Conjugate, NormSquared, ZeroStatus, Enclose, Refine, Exp, Sin, Cos, Log, LogResult, Sqrt, SqrtResult, Record, Capabilities, Rectangle, Disc, Union, FromSingleton, BoundingRectangle, RegionImage, Subdivide, AnalyzeBoundary]
groups: [Numerics, Exact]
permissions: []
requires: [rix.numerics@1]
provides: [rix.complex@1, rix.complex@2, rix.enclosable-complex@1, rix.complex-region@1]
schemas: [rix.complex.real@1, rix.complex.capabilities@1, rix.complex.enclosure@1, rix.complex.zero-status@1, rix.complex.function-result@1, rix.complex.region@1, rix.complex.region-analysis@1]
snapshot: false
deterministic: true
defaultEnabled: false
**/

ComplexExactScalar(value) -> (value ? :Integer) || (value ? :Rational);

ComplexCanComponent = {>
    (value) ?- [ComplexExactScalar(value)] -> 1,
    (value) ?- [value ? :Map] /CertifiedSingleton/ -> {;
        capabilities=value.NumericsCapabilities();
        capabilities[:certified]
          && capabilities[:arbitraryRefinement]
          && capabilities[:denotation]==:singleton;
    },
    (value) -> _
};

ComplexRequireComponent(value, label ?= "complex component") ->
    ComplexCanComponent(value)
      ?: value
      ?_ .Error(@"@{label} must be an exact Rational or a certified arbitrarily refinable singleton real");

ComplexFamily(value) -> value ? :ComplexReal;
ComplexRequire(value) -> ComplexFamily(value) ?: value ?_ .Error("Expected a ComplexReal value");
ComplexOperand(value) -> ComplexFamily(value) || ComplexCanComponent(value);
ComplexPair(left, right) ->
    (ComplexFamily(left) || ComplexFamily(right)) && ComplexOperand(left) && ComplexOperand(right);

ComplexCapabilities(value) -> {=
    valueKind=:complexCapabilities,
    schema="rix.complex.capabilities@1",
    backend=:complex,
    representation=:cartesianComponents,
    denotation=:singleton,
    componentDenotation=:singleton,
    enclosureGeometry=:axisAlignedRectangle,
    operations=[:enclose,:refine],
    evidenceLevels=[:proof],
    certified=1,
    arbitraryRefinement=1,
    deterministic=1,
    minimumWidth=0,
    maxCalls=100000,
    maxIterations=100000
};

ComplexBuild(real, imaginary, provenance ?= {= constructor=:fromParts }) -> {;
    exactReal = ComplexRequireComponent(real, "Complex real component");
    exactImaginary = ComplexRequireComponent(imaginary, "Complex imaginary component");
    value = {=
        valueKind=:complexReal,
        schema="rix.complex.real@1",
        real=exactReal,
        imaginary=exactImaginary,
        denotation=:singleton,
        certified=1,
        provenance=provenance
    };
    value._proto = {=
        Real=(self)->self[:real],
        Imaginary=(self)->self[:imaginary],
        Re=(self)->self[:real],
        Im=(self)->self[:imaginary],
        Conjugate=(self)->ComplexConjugate(self),
        NormSquared=(self)->ComplexNormSquared(self),
        ZeroStatus=(self,options ?= {= })->ComplexZeroStatus(self,options),
        Enclose=(self,request ?= {= })->ComplexProtocolEnclosure(self,request,:enclose),
        Refine=(self,request ?= {= })->ComplexProtocolEnclosure(self,request,:refine),
        ComplexCapabilities=(self)->ComplexCapabilities(self),
        Record=(self)->ComplexRecord(self)
    };
    .ImmutableValue(value ~!: :ComplexReal);
};

ComplexPromote(value) ->
    ComplexFamily(value)
      ?: value
      ?_ ComplexBuild(ComplexRequireComponent(value, "Complex scalar operand"),0,{= constructor=:realEmbedding });

ComplexAdd(left,right) -> {;
    a=ComplexPromote(left); b=ComplexPromote(right);
    ComplexBuild(a[:real]+b[:real],a[:imaginary]+b[:imaginary],{= operation=:add,left=a,right=b });
};

ComplexSubtract(left,right) -> {;
    a=ComplexPromote(left); b=ComplexPromote(right);
    ComplexBuild(a[:real]-b[:real],a[:imaginary]-b[:imaginary],{= operation=:subtract,left=a,right=b });
};

ComplexMultiply(left,right) -> {;
    a=ComplexPromote(left); b=ComplexPromote(right);
    ComplexBuild(
        a[:real]*b[:real]-a[:imaginary]*b[:imaginary],
        a[:real]*b[:imaginary]+a[:imaginary]*b[:real],
        {= operation=:multiply,left=a,right=b }
    );
};

ComplexNegate(value) -> {;
    exact=ComplexRequire(value);
    ComplexBuild(-exact[:real],-exact[:imaginary],{= operation=:negate,source=exact });
};

ComplexConjugate(value) -> {;
    exact=ComplexRequire(value);
    ComplexBuild(exact[:real],-exact[:imaginary],{= operation=:conjugate,source=exact });
};

ComplexNormSquared(value) -> {;
    exact=ComplexRequire(value);
    exact[:real]^2+exact[:imaginary]^2;
};

ComplexDivide(left,right) -> {;
    a=ComplexPromote(left); b=ComplexPromote(right);
    exactReal=b[:real] ~: :Rational;
    exactImaginary=b[:imaginary] ~: :Rational;
    exactReal != _ && exactImaginary != _
      && exactReal <= 0 && exactReal >= 0
      && exactImaginary <= 0 && exactImaginary >= 0
      ?: .Error("Cannot divide by exact complex zero")
      ?_ _;
    denominator=ComplexNormSquared(b);
    ComplexBuild(
        (a[:real]*b[:real]+a[:imaginary]*b[:imaginary])/denominator,
        (a[:imaginary]*b[:real]-a[:real]*b[:imaginary])/denominator,
        {= operation=:divide,left=a,right=b,zeroSeparation=:deferredToCertifiedRefinement }
    );
};

ComplexEqual(left,right) -> {;
    a=ComplexPromote(left); b=ComplexPromote(right);
    (a[:real] == b[:real]) && (a[:imaginary] == b[:imaginary]);
};

ComplexComponentEnclosure(value, request, budget, operation) -> {;
    exact=value ~: :Rational;
    exact != _
      ?: {=
          valueKind=:enclosure,
          schema="rix.numerics.enclosure@1",
          status=:enclosed,
          interval=exact:exact,
          certified=1,
          goalMet=1,
          requestedWidth=request[:absoluteWidth],
          achievedWidth=0,
          approximation=.CertifiedApproximation(exact,exact:exact,{= provider=:complex,reason=:exactComponent }),
          evidenceLevel=:proof,
          backend=:complex,
          operation=operation,
          trace=[],
          work={= calls=0,iterations=0,maxCalls=budget,exhausted=_ },
          diagnostics=[],
          evidence={= kind=:exactScalar,property=:containment },
          source={= plugin=:complex,component=:exactRational }
      }
      ?_ .numerics.Refine(value,{=
          absoluteWidth=request[:absoluteWidth],
          relativeWidth=request[:relativeWidth],
          evidenceRequired=request[:evidenceRequired],
          maxWork=budget,
          maxCalls=budget,
          maxIterations=budget,
          trace=request[:trace]
      });
};

ComplexProtocolEnclosure(value, rawRequest, operation) -> {;
    exact=ComplexRequire(value);
    request=.numerics.Request(rawRequest,operation);
    maxCalls=request[:work][:maxCalls];
    realBudget=maxCalls//2;
    imaginaryBudget=maxCalls-realBudget;
    realResult=ComplexComponentEnclosure(exact[:real],request,realBudget,operation);
    imaginaryResult=ComplexComponentEnclosure(exact[:imaginary],request,imaginaryBudget,operation);
    realInterval=realResult[:interval];
    imaginaryInterval=imaginaryResult[:interval];
    certified=realResult[:certified] && imaginaryResult[:certified];
    goalMet=realResult[:goalMet] && imaginaryResult[:goalMet];
    achievedWidth=.Max(realResult[:achievedWidth],imaginaryResult[:achievedWidth]);
    status=goalMet
      ?: :enclosed
      ?_ certified
           ?: :budgetExhausted
           ?_ :unknown;
    {=
        valueKind=:complexEnclosure,
        schema="rix.complex.enclosure@1",
        status=status,
        geometry=:axisAlignedRectangle,
        realInterval=realInterval,
        imaginaryInterval=imaginaryInterval,
        rectangle={= real=realInterval,imaginary=imaginaryInterval },
        midpoint={= real=realInterval.Midpoint(),imaginary=imaginaryInterval.Midpoint() },
        certified=certified,
        goalMet=goalMet,
        requestedWidth=request[:absoluteWidth],
        achievedWidth=achievedWidth,
        evidenceLevel=:proof,
        backend=:complex,
        operation=operation,
        trace={= real=realResult[:trace],imaginary=imaginaryResult[:trace] },
        work={=
            calls=realResult[:work][:calls]+imaginaryResult[:work][:calls],
            iterations=realResult[:work][:iterations]+imaginaryResult[:work][:iterations],
            maxCalls=maxCalls,
            exhausted=!goalMet
        },
        diagnostics=goalMet ?: [] ?_ [realResult[:status],imaginaryResult[:status]],
        evidence={=
            kind=:componentwiseCertifiedContainment,
            property=:complexRectangleContainment,
            real=realResult[:evidence],
            imaginary=imaginaryResult[:evidence]
        },
        source={= plugin=:complex,schema=exact[:schema],provenance=exact[:provenance] }
    };
};

ComplexZeroStatus(value, options ?= {= }) -> {;
    enclosure=ComplexProtocolEnclosure(value,options,:refine);
    real=enclosure[:realInterval];
    imaginary=enclosure[:imaginaryInterval];
    exactZero=real.Width()<=0 && imaginary.Width()<=0
      && real.Low()<=0 && real.Low()>=0
      && imaginary.Low()<=0 && imaginary.Low()>=0;
    separated=!(real.ContainsZero()) || !(imaginary.ContainsZero());
    status=exactZero ?: :zero ?_ separated ?: :nonzero ?_ :unknown;
    .ImmutableValue({=
        valueKind=:complexZeroStatus,
        schema="rix.complex.zero-status@1",
        status=status,
        zero=status==:zero ?: 1 ?_ status==:nonzero ?: _ ?_ ?,
        certified=status==:unknown ?: _ ?_ 1,
        enclosure=enclosure,
        evidence={= kind=:rectangleOriginSeparation,real=real,imaginary=imaginary }
    });
};

ComplexExp(value) -> {;
    z=ComplexPromote(value);
    scale=.numerics.Exp(z[:real]);
    ComplexBuild(
        scale*.numerics.Cos(z[:imaginary]),
        scale*.numerics.Sin(z[:imaginary]),
        {= function=:exp,source=z,identity=:cartesianExp }
    );
};

ComplexSin(value) -> {;
    z=ComplexPromote(value);
    ComplexBuild(
        .numerics.Sin(z[:real])*.numerics.Cosh(z[:imaginary]),
        .numerics.Cos(z[:real])*.numerics.Sinh(z[:imaginary]),
        {= function=:sin,source=z,identity=:cartesianSin }
    );
};

ComplexCos(value) -> {;
    z=ComplexPromote(value);
    ComplexBuild(
        .numerics.Cos(z[:real])*.numerics.Cosh(z[:imaginary]),
        -.numerics.Sin(z[:real])*.numerics.Sinh(z[:imaginary]),
        {= function=:cos,source=z,identity=:cartesianCos }
    );
};

ComplexBranchClassify(value, options ?= {= }) -> {;
    z=ComplexPromote(value);
    enclosure=ComplexProtocolEnclosure(z,options,:refine);
    real=enclosure[:realInterval];
    imaginary=enclosure[:imaginaryInterval];
    origin=real.Width()<=0 && imaginary.Width()<=0
      && real.Low()<=0 && real.Low()>=0
      && imaginary.Low()<=0 && imaginary.Low()>=0;
    offCut=real.Low()>0 || imaginary.Low()>0 || imaginary.High()<0;
    onCut=imaginary.Width()<=0 && imaginary.Low()<=0 && imaginary.Low()>=0 && real.High()<0;
    status=origin ?: :undefinedAtZero ?_ offCut ?: :resolved ?_ onCut ?: :branchBoundary ?_ :unknown;
    {= status=status,value=z,enclosure=enclosure,real=real,imaginary=imaginary };
};

ComplexFunctionResult(functionName, branchInfo, value, diagnostic) ->
    .ImmutableValue({=
        valueKind=:complexFunctionResult,
        schema="rix.complex.function-result@1",
        function=functionName,
        branch=:principal,
        branchRange="-pi < argument <= pi",
        branchCut=:nonpositiveRealAxis,
        status=branchInfo[:status],
        value=value,
        certified=branchInfo[:status]==:unknown ?: _ ?_ 1,
        boundary=branchInfo[:status]==:branchBoundary,
        enclosure=branchInfo[:enclosure],
        diagnostic=diagnostic,
        evidence={= kind=:certifiedBranchClassification,status=branchInfo[:status] }
    });

ComplexLogResult(value, options ?= {= }) -> {;
    branch=ComplexBranchClassify(value,options);
    available=branch[:status]==:resolved || branch[:status]==:branchBoundary;
    resultValue=available
      ?: {;
          z=@branch[:value];
          ComplexBuild(
              .numerics.Log(.numerics.Hypot(z[:real],z[:imaginary])),
              .numerics.Atan2(z[:imaginary],z[:real]),
              {= function=:log,branch=:principal,source=z,branchStatus=@branch[:status] }
          );
      }
      ?_ _;
    diagnostic=branch[:status]==:undefinedAtZero
      ?: :logUndefinedAtZero
      ?_ branch[:status]==:branchBoundary
           ?: :principalLogBranchBoundary
           ?_ branch[:status]==:unknown ?: :branchCutNotSeparated ?_ _;
    ComplexFunctionResult(:log,branch,resultValue,diagnostic);
};

ComplexLog(value, options ?= {= }) -> {;
    result=ComplexLogResult(value,options);
    result[:value] != _
      ?: result[:value]
      ?_ .Error("Complex principal Log is unresolved; inspect LogResult for zero or branch-cut evidence");
};

ComplexSqrtValue(branch) -> {;
    z=branch[:value];
    real=branch[:real];
    imaginary=branch[:imaginary];
    branch[:status]==:branchPoint
      ?: ComplexBuild(0,0,{= function=:sqrt,branch=:principal,source=z,branchStatus=:branchPoint })
      ?_ branch[:status]==:branchBoundary
           ?: ComplexBuild(0,.numerics.Sqrt(-z[:real]),{= function=:sqrt,branch=:principal,source=z,branchStatus=:branchBoundary })
           ?_ {;
               radius=.numerics.Hypot(@z[:real],@z[:imaginary]);
               realPart=.numerics.Sqrt((radius+@z[:real])/2);
               imaginaryPart=@real.Low()>0
                 ?: @z[:imaginary]/(2*realPart)
                 ?_ @imaginary.Low()>0
                      ?: .numerics.Sqrt((radius-@z[:real])/2)
                      ?_ @imaginary.High()<0
                           ?: -.numerics.Sqrt((radius-@z[:real])/2)
                           ?_ _;
               imaginaryPart==_
                 ?: _
                 ?_ ComplexBuild(realPart,imaginaryPart,{= function=:sqrt,branch=:principal,source=@z,branchStatus=@branch[:status] });
           };
};

ComplexSqrtResult(value, options ?= {= }) -> {;
    classified=ComplexBranchClassify(value,options);
    branch=classified[:status]==:undefinedAtZero
      ?: {=
          status=:branchPoint,
          value=classified[:value],
          enclosure=classified[:enclosure],
          real=classified[:real],
          imaginary=classified[:imaginary]
      }
      ?_ classified;
    resultValue=branch[:status]==:unknown ?: _ ?_ ComplexSqrtValue(branch);
    diagnostic=branch[:status]==:branchBoundary
      ?: :principalSqrtBranchBoundary
      ?_ branch[:status]==:unknown ?: :branchOrImaginarySignNotSeparated ?_ _;
    ComplexFunctionResult(:sqrt,branch,resultValue,diagnostic);
};

ComplexSqrt(value, options ?= {= }) -> {;
    result=ComplexSqrtResult(value,options);
    result[:value] != _
      ?: result[:value]
      ?_ .Error("Complex principal Sqrt is unresolved; inspect SqrtResult for branch evidence");
};

ComplexRecord(value) -> {;
    exact=ComplexRequire(value);
    {=
        valueKind=:complexReal,
        schema="rix.complex.real@1",
        real=exact[:real],
        imaginary=exact[:imaginary],
        denotation=:singleton,
        certified=1,
        provenance=exact[:provenance]
    };
};

## ComplexRegion denotes a set. It deliberately does not implement the
## singleton arithmetic operators above.
ComplexRegionIs(value) -> value ? :ComplexRegion;
ComplexRegionRequire(value) -> ComplexRegionIs(value) ?: value ?_ .Error("Expected a ComplexRegion value");
ComplexRegionBuild(geometry,data,evidence ?= {= constructor=geometry }) -> {;
    value={=
        valueKind=:complexRegion,schema="rix.complex.region@1",denotation=:set,
        geometry=geometry,data=data,evidence=evidence,certified=1
    };
    value.__type="ComplexRegion"; value._type="complex_region";
    .ImmutableValue(value ~!: :ComplexRegion);
};
ComplexRectangle(realInterval,imaginaryInterval,evidence ?= {= constructor=:rectangle }) ->
    ComplexRegionBuild(:rectangle,{= real=realInterval ~!: :RationalInterval,imaginary=imaginaryInterval ~!: :RationalInterval },evidence);
ComplexDisc(center,radius,evidence ?= {= constructor=:disc }) -> {;
    exactRadius=radius ~!: :Rational; exactRadius>=0 ?: _ ?_ .Error("Complex disc radius must be nonnegative");
    ComplexRegionBuild(:disc,{= center=ComplexPromote(center),radius=exactRadius },evidence);
};
ComplexUnion(regions,evidence ?= {= constructor=:finiteUnion }) -> {;
    regions.Len()>0 ?: _ ?_ .Error("Complex finite union needs at least one region");
    normalized:=[];
    {@ index=1;index<=@regions.Len();{;
        region=ComplexRegionRequire(@regions[index]);
        region[:geometry]==:finiteUnion
          ?:{; {@ child=1;child<=@region[:data][:regions].Len();{; @normalized~=@normalized.Push(@region[:data][:regions][child]); };child+=1}; }
          ?_ {; @normalized~=@normalized.Push(@region); };
    };index+=1};
    ComplexRegionBuild(:finiteUnion,{= regions=normalized },evidence);
};
ComplexRegionFromSingleton(value,request ?= {= absoluteWidth=1/1000,maxWork=400 }) -> {;
    exact=ComplexPromote(value); enclosure=exact.Refine(request);
    ComplexRectangle(enclosure[:realInterval],enclosure[:imaginaryInterval],{=
        constructor=:singletonEnclosure,source=exact,enclosure=enclosure,
        correlation={= sharedExpression=1,realSource=exact[:real],imaginarySource=exact[:imaginary] }
    });
};
ComplexRegionBoundingRectangle(region,request ?= {= absoluteWidth=1/1000,maxWork=400 }) -> {;
    exact=ComplexRegionRequire(region); geometry=exact[:geometry];
    geometry==:rectangle ?: exact
      ?_ geometry==:disc ?: {;
          center=@exact[:data][:center].Refine(@request); radius=@exact[:data][:radius];
          ComplexRectangle(
              (center[:realInterval].Low()-radius):(center[:realInterval].High()+radius),
              (center[:imaginaryInterval].Low()-radius):(center[:imaginaryInterval].High()+radius),
              {= constructor=:discBoundingRectangle,source=@exact,centerEnclosure=center,outward=1 }
          );
      }
      ?_ {;
          regions=@exact[:data][:regions]; first=ComplexRegionBoundingRectangle(regions[1],@request);
          realHull:=first[:data][:real]; imaginaryHull:=first[:data][:imaginary];
          {@ index=2;index<=@regions.Len();{;
              next=ComplexRegionBoundingRectangle(@regions[index],@request);
              @realHull=@realHull.Hull(next[:data][:real]);
              @imaginaryHull=@imaginaryHull.Hull(next[:data][:imaginary]);
          };index+=1};
          ComplexRectangle(realHull,imaginaryHull,{= constructor=:finiteUnionHull,source=@exact,outward=1 });
      };
};

ComplexRegionRange(kind,interval,options) -> {?
    kind==:exp ? .numerics.Range(.numerics.Exp(interval),options)[:interval];
    kind==:sin ? .numerics.Range(.numerics.Sin(interval),options)[:interval];
    kind==:cos ? .numerics.Range(.numerics.Cos(interval),options)[:interval];
    kind==:sinh ? .numerics.Range(.numerics.Sinh(interval),options)[:interval];
    kind==:cosh ? .numerics.Range(.numerics.Cosh(interval),options)[:interval];
    .Error("Unsupported certified scalar range in complex region kernel")
};
ComplexRegionRectangleImage(functionName,region,options) -> {;
    rectangle=ComplexRegionBoundingRectangle(region,options); x=rectangle[:data][:real]; y=rectangle[:data][:imaginary];
    sinX=ComplexRegionRange(:sin,x,options); cosX=ComplexRegionRange(:cos,x,options);
    sinY=ComplexRegionRange(:sin,y,options); cosY=ComplexRegionRange(:cos,y,options);
    sinhY=ComplexRegionRange(:sinh,y,options); coshY=ComplexRegionRange(:cosh,y,options);
    functionName==:exp ?: {;
        expX=ComplexRegionRange(:exp,@x,@options);
        ComplexRectangle(expX*@cosY,expX*@sinY,{= operation=:regionImage,function=:exp,algorithm=:validatedCartesianRange,source=@region,outward=1,correlation=@region[:evidence][:correlation] });
    }
      ?_ functionName==:sin
           ?: ComplexRectangle(sinX*coshY,cosX*sinhY,{= operation=:regionImage,function=:sin,algorithm=:validatedCartesianRange,source=region,outward=1,correlation=region[:evidence][:correlation] })
      ?_ functionName==:cos
           ?: ComplexRectangle(cosX*coshY,-sinX*sinhY,{= operation=:regionImage,function=:cos,algorithm=:validatedCartesianRange,source=region,outward=1,correlation=region[:evidence][:correlation] })
      ?_ .Error("Complex RegionImage currently supports Exp, Sin, and Cos");
};
ComplexRegionDiscImage(functionName,region,options) -> {;
    center=region[:data][:center]; radius=region[:data][:radius]; centerBox=center.Refine(options);
    realCenter=centerBox[:realInterval]; imaginaryCenter=centerBox[:imaginaryInterval];
    functionName==:exp ?: {;
        centerValue=ComplexExp(@center);
        expRealUpper=ComplexRegionRange(:exp,@realCenter,@options).High();
        expRadiusUpper=ComplexRegionRange(:exp,0:@radius,@options).High();
        outputRadius=expRealUpper*(expRadiusUpper-1);
        ComplexDisc(centerValue,outputRadius,{=
            operation=:regionImage,function=:exp,algorithm=:centeredValidatedComplexSeries,
            argumentReduction=:centeredDisc,series=:exponential,remainderBound=outputRadius,
            source=@region,correlation={= sharedCenter=1,source=@center },outward=1
        });
    }
      ?_ (functionName==:sin||functionName==:cos) ?: {;
          centerValue=@functionName==:sin ?: ComplexSin(@center) ?_ ComplexCos(@center);
          imaginaryMagnitude=.Max(@imaginaryCenter.Low().Abs(),@imaginaryCenter.High().Abs())+@radius;
          derivativeUpper=ComplexRegionRange(:cosh,0:imaginaryMagnitude,@options).High();
          outputRadius=@radius*derivativeUpper;
          ComplexDisc(centerValue,outputRadius,{=
              operation=:regionImage,function=@functionName,algorithm=:centeredValidatedComplexSeries,
              argumentReduction=:centeredDisc,series=@functionName,remainderBound=outputRadius,
              source=@region,correlation={= sharedCenter=1,source=@center },outward=1
          });
      }
      ?_ .Error("Complex RegionImage currently supports Exp, Sin, and Cos");
};
ComplexRegionImage(functionName,region,options ?= {= absoluteWidth=1/1000,maxWork=1000 }) -> {;
    exact=ComplexRegionRequire(region);
    exact[:geometry]==:finiteUnion ?: {;
        images=@exact[:data][:regions].Map((part)->ComplexRegionImage(@functionName,part,@options));
        ComplexUnion(images,{= operation=:regionImage,function=@functionName,algorithm=:componentwiseFiniteUnion,source=@exact,outward=1 });
    }
      ?_ exact[:geometry]==:disc
           ?: ComplexRegionDiscImage(functionName,exact,options)
           ?_ ComplexRegionRectangleImage(functionName,exact,options);
};

ComplexRegionSubdivide(region,options ?= {= }) -> {;
    rectangle=ComplexRegionBoundingRectangle(region,options); real=rectangle[:data][:real]; imaginary=rectangle[:data][:imaginary];
    real.Width()>=imaginary.Width() ?: {;
        midpoint=@real.Midpoint();
        [ComplexRectangle(@real.Low():midpoint,@imaginary,{= constructor=:adaptiveSubdivision,parent=@region,axis=:real }),ComplexRectangle(midpoint:@real.High(),@imaginary,{= constructor=:adaptiveSubdivision,parent=@region,axis=:real })];
    } ?_ {;
        midpoint=@imaginary.Midpoint();
        [ComplexRectangle(@real,@imaginary.Low():midpoint,{= constructor=:adaptiveSubdivision,parent=@region,axis=:imaginary }),ComplexRectangle(@real,midpoint:@imaginary.High(),{= constructor=:adaptiveSubdivision,parent=@region,axis=:imaginary })];
    };
};
ComplexRegionBoundaryClass(region,feature,options) -> {;
    rectangle=ComplexRegionBoundingRectangle(region,options); real=rectangle[:data][:real]; imaginary=rectangle[:data][:imaginary]; containsOrigin=real.ContainsZero()&&imaginary.ContainsZero();
    offBranchCut=real.Low()>0||imaginary.Low()>0||imaginary.High()<0;
    exactOrigin=real.Width()<=0&&imaginary.Width()<=0&&containsOrigin;
    status=(feature==:zero||feature==:pole) ?: (containsOrigin ?: (exactOrigin ?: :hit ?_ :boundary) ?_ :resolved)
      ?_ feature==:logBranch ?: (exactOrigin ?: :hit ?_ (offBranchCut ?: :resolved ?_ :boundary))
      ?_ feature==:sqrtBranch ?: (exactOrigin ?: :hit ?_ (offBranchCut ?: :resolved ?_ :boundary))
      ?_ .Error("AnalyzeBoundary feature must be zero, pole, logBranch, or sqrtBranch");
    {= status=status,feature=feature,region=region,bounds=rectangle,certified=1 };
};
ComplexRegionAnalyzeNode(region,feature,depth,maxDepth,remaining,options) -> {;
    classification=ComplexRegionBoundaryClass(region,feature,options); status=classification[:status];
    status==:resolved ?: {= resolved=[classification],hits=[],unresolved=[],inspected=1,subdivisions=0 }
      ?_ status==:hit ?: {= resolved=[],hits=[classification],unresolved=[],inspected=1,subdivisions=0 }
      ?_ (depth>=maxDepth||remaining<=1) ?: {= resolved=[],hits=[],unresolved=[classification.Merge({= status=:budgetExhausted })],inspected=1,subdivisions=0 }
      ?_ {;
          children=ComplexRegionSubdivide(@region,@options); childBudget=(@remaining-1)//2;
          left=ComplexRegionAnalyzeNode(children[1],@feature,@depth+1,@maxDepth,childBudget,@options);
          right=ComplexRegionAnalyzeNode(children[2],@feature,@depth+1,@maxDepth,@remaining-1-childBudget,@options);
          {=
              resolved=left[:resolved]++right[:resolved],hits=left[:hits]++right[:hits],unresolved=left[:unresolved]++right[:unresolved],
              inspected=1+left[:inspected]+right[:inspected],subdivisions=1+left[:subdivisions]+right[:subdivisions]
          };
      };
};
ComplexRegionAnalyzeBoundary(region,feature,options ?= {= maxDepth=6,maxCells=256,absoluteWidth=1/1000,maxWork=1000 }) -> {;
    exact=ComplexRegionRequire(region); maxDepth=options[:maxDepth]==_ ?: 6 ?_ options[:maxDepth]; maxCells=options[:maxCells]==_ ?: 256 ?_ options[:maxCells];
    analysis=ComplexRegionAnalyzeNode(exact,feature,0,maxDepth,maxCells,options); unresolved=analysis[:unresolved];
    .ImmutableValue({=
        valueKind=:complexRegionAnalysis,schema="rix.complex.region-analysis@1",feature=feature,
        status=unresolved.Len()==0 ?: :resolved ?_ :partial,resolved=analysis[:resolved],hits=analysis[:hits],unresolved=unresolved,
        certified=1,source=exact,work={= inspected=analysis[:inspected],subdivisions=analysis[:subdivisions],maxCells=maxCells,maxDepth=maxDepth },
        evidence={= kind=:adaptiveCertifiedRegionClassification,outward=1 }
    });
};

.TypeKnown(:ComplexReal) ?: _ ?_ .TypeRegister({=
    name=:ComplexReal,
    nativeType=:map,
    defaultTraits=[:number],
    convertFrom={= map=(x) ?- [x[:valueKind]==:complexReal] -> x },
    validate=(x)->x[:valueKind]==:complexReal && x[:schema]=="rix.complex.real@1",
    proto={=
        Real=(self)->self[:real],
        Imaginary=(self)->self[:imaginary],
        Re=(self)->self[:real],
        Im=(self)->self[:imaginary],
        Conjugate=(self)->ComplexConjugate(self),
        NormSquared=(self)->ComplexNormSquared(self),
        ZeroStatus=(self,options ?= {= })->ComplexZeroStatus(self,options),
        Enclose=(self,request ?= {= })->ComplexProtocolEnclosure(self,request,:enclose),
        Refine=(self,request ?= {= })->ComplexProtocolEnclosure(self,request,:refine),
        ComplexCapabilities=(self)->ComplexCapabilities(self),
        Record=(self)->ComplexRecord(self)
    },
    installs={=
        ADD=[{= name=:ComplexRealAdd,priority=440,prep=(x,y)->ComplexPair(x,y),impl=(x,y)->ComplexAdd(x,y) }],
        SUB=[{= name=:ComplexRealSub,priority=440,prep=(x,y)->ComplexPair(x,y),impl=(x,y)->ComplexSubtract(x,y) }],
        MUL=[{= name=:ComplexRealMul,priority=440,prep=(x,y)->ComplexPair(x,y),impl=(x,y)->ComplexMultiply(x,y) }],
        DIV=[{= name=:ComplexRealDiv,priority=440,prep=(x,y)->ComplexPair(x,y),impl=(x,y)->ComplexDivide(x,y) }],
        NEG=[{= name=:ComplexRealNeg,priority=440,prep=(x)->ComplexFamily(x),impl=(x)->ComplexNegate(x) }],
        EQ=[{= name=:ComplexRealEq,priority=440,prep=(x,y)->ComplexPair(x,y),impl=(x,y)->ComplexEqual(x,y) }],
        NEQ=[{= name=:ComplexRealNeq,priority=440,prep=(x,y)->ComplexPair(x,y),impl=(x,y)->!ComplexEqual(x,y) }]
    }
});

.TypeInstall(:ComplexReal);

.TypeKnown(:ComplexRegion) ?: _ ?_ .TypeRegister({=
    name=:ComplexRegion,nativeType=:map,convertFrom={= map=(x) ?- [x[:valueKind]==:complexRegion] -> x },
    validate=(x)->x[:schema]=="rix.complex.region@1"&&x[:denotation]==:set,
    proto={=
        Geometry=(self)->self[:geometry],BoundingRectangle=(self,request ?= {= })->ComplexRegionBoundingRectangle(self,request),
        Image=(self,functionName,options ?= {= })->ComplexRegionImage(functionName,self,options),
        Subdivide=(self,options ?= {= })->ComplexRegionSubdivide(self,options),
        AnalyzeBoundary=(self,feature,options ?= {= })->ComplexRegionAnalyzeBoundary(self,feature,options),
        Record=(self)->self
    },installs={= }
});
.TypeInstall(:ComplexRegion);

complexNamespace=(real,imaginary ?= 0)->ComplexBuild(real,imaginary);
complexNamespace._proto={=
    FromParts=(self,real,imaginary)->ComplexBuild(real,imaginary),
    Real=(self,value)->ComplexRequire(value)[:real],
    Imaginary=(self,value)->ComplexRequire(value)[:imaginary],
    Re=(self,value)->ComplexRequire(value)[:real],
    Im=(self,value)->ComplexRequire(value)[:imaginary],
    Conjugate=(self,value)->ComplexConjugate(value),
    NormSquared=(self,value)->ComplexNormSquared(value),
    ZeroStatus=(self,value,options ?= {= })->ComplexZeroStatus(value,options),
    Enclose=(self,value,options ?= {= })->ComplexProtocolEnclosure(value,options,:enclose),
    Refine=(self,value,options ?= {= })->ComplexProtocolEnclosure(value,options,:refine),
    Exp=(self,value)->ComplexExp(value),
    Sin=(self,value)->ComplexSin(value),
    Cos=(self,value)->ComplexCos(value),
    Log=(self,value,options ?= {= })->ComplexLog(value,options),
    LogResult=(self,value,options ?= {= })->ComplexLogResult(value,options),
    Sqrt=(self,value,options ?= {= })->ComplexSqrt(value,options),
    SqrtResult=(self,value,options ?= {= })->ComplexSqrtResult(value,options),
    Rectangle=(self,realInterval,imaginaryInterval)->ComplexRectangle(realInterval,imaginaryInterval),
    Disc=(self,center,radius)->ComplexDisc(center,radius),
    Union=(self,regions)->ComplexUnion(regions),
    FromSingleton=(self,value,request ?= {= absoluteWidth=1/1000,maxWork=400 })->ComplexRegionFromSingleton(value,request),
    BoundingRectangle=(self,region,request ?= {= })->ComplexRegionBoundingRectangle(region,request),
    RegionImage=(self,functionName,region,options ?= {= absoluteWidth=1/1000,maxWork=1000 })->ComplexRegionImage(functionName,region,options),
    Subdivide=(self,region,options ?= {= })->ComplexRegionSubdivide(region,options),
    AnalyzeBoundary=(self,region,feature,options ?= {= maxDepth=6,maxCells=256,absoluteWidth=1/1000,maxWork=1000 })->ComplexRegionAnalyzeBoundary(region,feature,options),
    Record=(self,value)->ComplexRecord(value),
    Capabilities=(self,value)->ComplexCapabilities(ComplexRequire(value))
};

.Host.RegisterCallableValue(
    "complex",
    complexNamespace,
    "Representation-generic certified complex singletons over RiX real backends",
    ["Numerics","Exact"]
);
