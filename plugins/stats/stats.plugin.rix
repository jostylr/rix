/**
id: stats
description: Exact descriptive statistics, confidence objects, linear regression, certified normal functions, and portable diagnostics.
kind: rix
mount: stats
aliases: [statistics]
exports: [Count, Mean, Quantile, Median, Variance, SampleVariance, NormalPDF, NormalCDF, NormalQuantile, Summary, SummaryTable, Histogram, HistogramGraphic, BoxPlot, DistributionSummary, SimulationValues, SimulationSummary, MeanConfidence, ProportionConfidence, LinearRegression, Predict, RegressionTable, ResidualTable]
groups: [Statistics, Exact, Graphics]
permissions: []
requires: [rix.numerics@1]
provides: [rix.statistics@1, rix.stats.inference@1, rix.stats.regression@1]
schemas: [rix.stats.summary@1, rix.stats.histogram@1, rix.stats.distribution-summary@1, rix.stats.confidence@1, rix.stats.regression@1]
snapshot: true
deterministic: true
defaultEnabled: false
**/

StatsOption(options, key, fallback) -> options.Has(key.Lower()) ?: options[key.Lower()] ?_ fallback;

StatsValues(values, allowEmpty ?= 0) -> {;
    values ? :Array ?: _ ?_ .Error("Statistics values must be an Array");
    (allowEmpty == 1 || values.Len() > 0) ?: _ ?_ .Error("Statistics requires at least one value");
    values.Map((value) -> {;
        exact = value ~!: :Rational;
        exact == _ ?: .Error("Statistics values must be exact Integers or Rationals") ?_ exact;
    });
};

StatsCount(values) -> StatsValues(values, 1).Len();

StatsSum(exactValues) -> exactValues.Reduce((sum, value) -> sum + value, 0);

StatsMean(values) -> {;
    exact = StatsValues(values);
    StatsSum(exact) / exact.Len();
};

StatsQuantile(values, probability, policy ?= :linear) -> {;
    exact = StatsValues(values).Sort();
    p = probability ~!: :Rational;
    (p >= 0 && p <= 1) ?: _ ?_ .Error("Quantile probability must be between 0 and 1");
    policy == :linear ?: _ ?_ .Error("Phase 1 supports the exact :linear quantile policy");
    rank = p * (exact.Len() - 1);
    lowerOffset = rank.Floor();
    lowerIndex = lowerOffset + 1;
    weight = rank - lowerOffset;
    lowerIndex == exact.Len()
      ?: exact[lowerIndex]
      ?_ exact[lowerIndex] + weight * (exact[lowerIndex + 1] - exact[lowerIndex]);
};

StatsMedian(values) -> StatsQuantile(values, 1/2);

StatsVariance(values, sample ?= 0) -> {;
    exact = StatsValues(values);
    sample == 1 && exact.Len() < 2 ?: .Error("Sample variance requires at least two values") ?_ _;
    mean = StatsSum(exact) / exact.Len();
    squared = exact.Reduce((sum, value) -> sum + (value - mean)^2, 0);
    squared / (sample == 1 ?: exact.Len() - 1 ?_ exact.Len());
};

StatsNormalScale(standardDeviation) -> {;
    scale = standardDeviation ~!: :Rational;
    scale > 0 ?: scale ?_ .Error("Normal standard deviation must be a positive exact Rational");
};

StatsNormalPDF(value, mean ?= _, standardDeviation ?= _) -> {;
    defaults = mean == _ && standardDeviation == _;
    location = mean == _ ?: 0 ?_ mean;
    scale = StatsNormalScale(standardDeviation == _ ?: 1 ?_ standardDeviation);
    defaults
      ?: .numerics.NormalPDF(value)
      ?_ .numerics.NormalPDF((value-location)/scale) / scale;
};

StatsNormalCDF(value, mean ?= _, standardDeviation ?= _) -> {;
    defaults = mean == _ && standardDeviation == _;
    location = mean == _ ?: 0 ?_ mean;
    scale = StatsNormalScale(standardDeviation == _ ?: 1 ?_ standardDeviation);
    defaults
      ?: .numerics.NormalCDF(value)
      ?_ .numerics.NormalCDF((value-location)/scale);
};

StatsNormalQuantile(probability, mean ?= _, standardDeviation ?= _) -> {;
    defaults = mean == _ && standardDeviation == _;
    location = mean == _ ?: 0 ?_ mean;
    scale = StatsNormalScale(standardDeviation == _ ?: 1 ?_ standardDeviation);
    defaults
      ?: .numerics.NormalQuantile(probability)
      ?_ location + scale*.numerics.NormalQuantile(probability);
};

StatsSummary(values) -> {;
    exact = StatsValues(values);
    sorted = exact.Sort();
    count = sorted.Len();
    mean = StatsSum(sorted) / count;
    {=
        valueKind=:statsSummary,
        schema="rix.stats.summary@1",
        count=count,
        minimum=sorted[1],
        q1=StatsQuantile(sorted, 1/4),
        median=StatsQuantile(sorted, 1/2),
        q3=StatsQuantile(sorted, 3/4),
        maximum=sorted.Last(),
        mean=mean,
        populationVariance=StatsVariance(sorted),
        sampleVariance=count >= 2 ?: StatsVariance(sorted, 1) ?_ _,
        quantilePolicy=:linearNMinusOne,
        exact=1
    };
};

StatsSummaryTable(values, options ?= {= }) -> {;
    summary = StatsSummary(values);
    caption = StatsOption(options, "caption", "Exact descriptive statistics");
    .Table(["statistic", "value"], [
        ["count", summary[:count]],
        ["minimum", summary[:minimum]],
        ["q1", summary[:q1]],
        ["median", summary[:median]],
        ["q3", summary[:q3]],
        ["maximum", summary[:maximum]],
        ["mean", summary[:mean]],
        ["population variance", summary[:populationVariance]],
        ["sample variance", summary[:sampleVariance]]
    ], {= caption=caption });
};

StatsPositiveInteger(value, label) -> {;
    integer = value ~!: :Integer;
    integer >= 1 ?: integer ?_ .Error(@"@{label} must be a positive Integer");
};

StatsZeros(length) -> {;
    result := [];
    {@ index = 1; index <= @length; {; @result ~= @result.Push(0); }; index += 1 };
    result;
};

StatsHistogram(values, binCount ?= 5) -> {;
    exact = StatsValues(values);
    count = StatsPositiveInteger(binCount, "Histogram bin count");
    minimum = exact.Sort()[1];
    maximum = exact.Sort().Last();
    constant = minimum == maximum;
    effectiveCount = constant ?: 1 ?_ count;
    width = constant ?: 0 ?_ (maximum - minimum) / effectiveCount;
    counts := StatsZeros(effectiveCount);
    {@ index = 1; index <= @exact.Len(); {;
        bin = @constant ?: 1 ?_ ((@exact[index] - @minimum) / @width).Floor() + 1;
        bin > @effectiveCount ?: {; @bin ~= @effectiveCount; } ?_ _;
        @counts ~= @counts.Set(bin, @counts[bin] + 1);
    }; index += 1 };
    bins := [];
    {@ index = 1; index <= @effectiveCount; {;
        low = @constant ?: @minimum ?_ @minimum + (index - 1) * @width;
        high = @constant ?: @maximum ?_ @minimum + index * @width;
        @bins ~= @bins.Push({=
            index=index,
            low=low,
            high=high,
            count=@counts[index],
            includesHigh=index == @effectiveCount
        });
    }; index += 1 };
    {=
        valueKind=:statsHistogram,
        schema="rix.stats.histogram@1",
        bins=bins,
        count=exact.Len(),
        minimum=minimum,
        maximum=maximum,
        width=width,
        exact=1
    };
};

StatsHistogramGraphic(value, options ?= {= }) -> {;
    histogram = value ? :Array
      ?: StatsHistogram(value, StatsOption(options, "bins", 5))
      ?_ value;
    histogram[:schema] == "rix.stats.histogram@1" ?: _ ?_ .Error("HistogramGraphic expects values or a stats histogram");
    size = StatsOption(options, "size", [420, 220]);
    fill = StatsOption(options, "fill", "#2563eb");
    margin = 28;
    chartWidth = size[1] - 2 * margin;
    chartHeight = size[2] - 2 * margin;
    bins = histogram[:bins];
    maximumCount = bins.Map((bin) -> bin[:count]).Sort().Last();
    cellWidth = chartWidth / bins.Len();
    children := [
        .Graphics.Path([[margin, margin], [margin, margin + chartHeight], [margin + chartWidth, margin + chartHeight]], {= stroke="#334155", width=1, fill="none" })
    ];
    {@ index = 1; index <= @bins.Len(); {;
        height = @chartHeight * @bins[index][:count] / @maximumCount;
        @children ~= @children.Push(.Graphics.Rectangle(
            [@margin + (index - 1) * @cellWidth + 1, @margin + @chartHeight - height],
            [@cellWidth - 2, height],
            {= fill=@fill, stroke="#1e3a8a", width=1 }
        ));
    }; index += 1 };
    .Graphics.Graphic(size, children, {=
        schema="rix.stats.histogram-graphic@1",
        histogram=histogram,
        alt="Exact histogram"
    });
};

StatsBoxPlot(values, options ?= {= }) -> {;
    summary = StatsSummary(values);
    size = StatsOption(options, "size", [420, 120]);
    fill = StatsOption(options, "fill", "#bfdbfe");
    left = 30;
    right = size[1] - 30;
    y = size[2] / 2;
    spread = summary[:maximum] - summary[:minimum];
    position = (value) -> @spread == 0 ?: (@left + @right) / 2 ?_ @left + (value - @summary[:minimum]) * (@right - @left) / @spread;
    minX = summary[:minimum] |> position;
    q1X = summary[:q1] |> position;
    medianX = summary[:median] |> position;
    q3X = summary[:q3] |> position;
    maxX = summary[:maximum] |> position;
    .Graphics.Graphic(size, [
        .Graphics.Path([[minX, y], [maxX, y]], {= stroke="#334155", width=2, fill="none" }),
        .Graphics.Path([[minX, y - 14], [minX, y + 14]], {= stroke="#334155", width=2 }),
        .Graphics.Path([[maxX, y - 14], [maxX, y + 14]], {= stroke="#334155", width=2 }),
        .Graphics.Rectangle([q1X, y - 24], [q3X - q1X, 48], {= fill=fill, stroke="#1e3a8a", width=2 }),
        .Graphics.Path([[medianX, y - 24], [medianX, y + 24]], {= stroke="#be123c", width=3 })
    ], {= schema="rix.stats.box-plot@1", summary=summary, alt="Exact box plot" });
};

StatsDistributionSummary(value) -> {;
    ((value ? :Map) && value[:schema] == "rix.probability.distribution@1")
      ?: _
      ?_ .Error("DistributionSummary expects a probability distribution record");
    (value._proto.Has("MEAN") && value._proto.Has("VARIANCE"))
      ?: _
      ?_ .Error("DistributionSummary requires a univariate distribution with Mean and Variance methods");
    mean = value.Mean();
    variance = value.Variance();
    {=
        valueKind=:statsDistributionSummary,
        schema="rix.stats.distribution-summary@1",
        sourceSchema=value[:schema],
        family=value.Family(),
        support=value.Support(),
        parameters=value.Parameters(),
        mean=mean,
        variance=variance,
        momentStatus=(mean == _ || variance == _) ?: :unavailable ?_ :available,
        exactProbability=value[:exactprobability],
        certifiedFunctions=value[:certifiedfunctions]
    };
};

StatsSimulationValues(value) -> {;
    ((value ? :Map) && value[:schema] == "rix.probability.simulation@1")
      ?: StatsValues(value[:values])
      ?_ .Error("SimulationValues expects a probability simulation record with exact scalar values");
};

StatsObservedValues(value) -> ((value ? :Map) && value[:schema] == "rix.probability.simulation@1")
  ?: StatsSimulationValues(value)
  ?_ StatsValues(value);

StatsSimulationSummary(value) -> {;
    exact = StatsSimulationValues(value);
    StatsSummary(exact).Merge({=
        sourceSchema=value[:schema],
        sourceFamily=value[:family],
        sourceCount=value[:count],
        sourceSeed=value[:seed],
        sourceSamplingPolicy=value[:samplingpolicy]
    });
};

StatsConfidenceLevel(value) -> {;
    level = value ~!: :Rational;
    (level > 0 && level < 1)
      ?: level
      ?_ .Error("Confidence level must be strictly between 0 and 1");
};

StatsMeanConfidence(valuesValue, levelValue ?= 95/100, options ?= {= }) -> {;
    values = StatsObservedValues(valuesValue);
    values.Len() >= 2 ?: _ ?_ .Error("MeanConfidence requires at least two observations");
    level = StatsConfidenceLevel(levelValue);
    center = StatsMean(values);
    knownStandardDeviation = StatsOption(options,"knownStandardDeviation",_);
    variance = knownStandardDeviation == _
      ?: StatsVariance(values,1)
      ?_ {;
          scale = @knownStandardDeviation ~!: :Rational;
          scale > 0 ?: scale^2 ?_ .Error("knownStandardDeviation must be a positive exact Rational");
      };
    standardError = .numerics.Sqrt(variance/values.Len());
    critical = .numerics.NormalQuantile((1+level)/2);
    margin = critical*standardError;
    {=
        valueKind=:statsConfidence,
        schema="rix.stats.confidence@1",
        parameter=:mean,
        method=knownStandardDeviation == _ ?: :normalApproximationWithSampleVariance ?_ :normalKnownScale,
        level=level,
        estimate=center,
        standardError=standardError,
        criticalValue=critical,
        margin=margin,
        lower=center-margin,
        upper=center+margin,
        count=values.Len(),
        certified=1
    };
};

StatsProportionConfidence(successesValue, trialsValue, levelValue ?= 95/100) -> {;
    successes = successesValue ~!: :Integer;
    trials = trialsValue ~!: :Integer;
    trials >= 1 ?: _ ?_ .Error("ProportionConfidence trials must be positive");
    (successes >= 0 && successes <= trials)
      ?: _
      ?_ .Error("ProportionConfidence successes must be between zero and trials");
    level = StatsConfidenceLevel(levelValue);
    estimate = successes/trials;
    critical = .numerics.NormalQuantile((1+level)/2);
    squared = critical^2;
    denominator = 1+squared/trials;
    center = (estimate+squared/(2*trials))/denominator;
    margin = critical*.numerics.Sqrt(estimate*(1-estimate)/trials+squared/(4*trials^2))/denominator;
    {=
        valueKind=:statsConfidence,
        schema="rix.stats.confidence@1",
        parameter=:proportion,
        method=:wilsonScore,
        level=level,
        estimate=estimate,
        standardError=.numerics.Sqrt(estimate*(1-estimate)/trials),
        criticalValue=critical,
        margin=margin,
        lower=center-margin,
        upper=center+margin,
        successes=successes,
        count=trials,
        certified=1
    };
};

StatsRequireRegression(value) -> ((value ? :Map) && value[:schema] == "rix.stats.regression@1")
  ?: value
  ?_ .Error("Expected a stats regression result");

StatsLinearRegression(xValues, yValues) -> {;
    x = StatsValues(xValues);
    y = StatsValues(yValues);
    x.Len() == y.Len() ?: _ ?_ .Error("LinearRegression x and y must have the same length");
    x.Len() >= 2 ?: _ ?_ .Error("LinearRegression requires at least two observations");
    count = x.Len();
    xMean = StatsMean(x);
    yMean = StatsMean(y);
    sxx = x.Reduce((sum,value)->sum+(value-xMean)^2,0);
    syy = y.Reduce((sum,value)->sum+(value-yMean)^2,0);
    sxy = x.Reduce((sum,value,index)->sum+(value-xMean)*(y[index]-yMean),0);
    sxx.Numerator() != 0 ?: _ ?_ .Error("LinearRegression predictor values must not all be equal");
    slope = sxy/sxx;
    intercept = yMean-slope*xMean;
    fitted = x.Map((value)->intercept+slope*value);
    residuals = y.Map((value,index)->value-fitted[index]);
    sse = StatsSum(residuals.Map((value)->value^2));
    rSquared = syy.Numerator() == 0 ?: 1 ?_ 1-sse/syy;
    degrees = count-2;
    mse = degrees >= 1 ?: sse/degrees ?_ _;
    slopeStandardError = degrees >= 1 ?: .numerics.Sqrt(mse/sxx) ?_ _;
    interceptStandardError = degrees >= 1
      ?: .numerics.Sqrt(mse*(1/count+xMean^2/sxx))
      ?_ _;
    {=
        valueKind=:statsRegression,
        schema="rix.stats.regression@1",
        model=:simpleLinear,
        count=count,
        x=x,
        y=y,
        xMean=xMean,
        yMean=yMean,
        slope=slope,
        intercept=intercept,
        fitted=fitted,
        residuals=residuals,
        sse=sse,
        sxx=sxx,
        syy=syy,
        rSquared=rSquared,
        degreesOfFreedom=degrees,
        residualMeanSquare=mse,
        slopeStandardError=slopeStandardError,
        interceptStandardError=interceptStandardError,
        exactCoefficients=1,
        certifiedDiagnostics=1
    };
};

StatsPredict(modelValue, xValue) -> {;
    model = StatsRequireRegression(modelValue);
    x = xValue ~!: :Rational;
    model[:intercept]+model[:slope]*x;
};

StatsRegressionTable(modelValue) -> {;
    model = StatsRequireRegression(modelValue);
    .Table(["term","estimate","standard error"],[
        ["intercept",model[:intercept],model[:interceptStandardError]],
        ["slope",model[:slope],model[:slopeStandardError]],
        ["R squared",model[:rSquared],_],
        ["residual mean square",model[:residualMeanSquare],_]
    ],{= caption="Simple linear regression diagnostics" });
};

StatsResidualTable(modelValue) -> {;
    model = StatsRequireRegression(modelValue);
    rows = model[:x].Map((x,index)->[index,x,model[:y][index],model[:fitted][index],model[:residuals][index]]);
    .Table(["observation","x","observed","fitted","residual"],rows,{= caption="Regression residuals" });
};

statsNamespace = {= };
statsNamespace._proto = {=
    Count=(self, values)->StatsCount(values),
    Mean=(self, values)->StatsMean(values),
    Quantile=(self, values, probability, policy ?= :linear)->StatsQuantile(values, probability, policy),
    Median=(self, values)->StatsMedian(values),
    Variance=(self, values)->StatsVariance(values),
    SampleVariance=(self, values)->StatsVariance(values, 1),
    NormalPDF=(self, value, mean ?= _, standardDeviation ?= _)->StatsNormalPDF(value, mean, standardDeviation),
    NormalCDF=(self, value, mean ?= _, standardDeviation ?= _)->StatsNormalCDF(value, mean, standardDeviation),
    NormalQuantile=(self, probability, mean ?= _, standardDeviation ?= _)->StatsNormalQuantile(probability, mean, standardDeviation),
    Summary=(self, values)->StatsSummary(values),
    SummaryTable=(self, values, options ?= {= })->StatsSummaryTable(values, options),
    Histogram=(self, values, binCount ?= 5)->StatsHistogram(values, binCount),
    HistogramGraphic=(self, value, options ?= {= })->StatsHistogramGraphic(value, options),
    BoxPlot=(self, values, options ?= {= })->StatsBoxPlot(values, options),
    DistributionSummary=(self,value)->StatsDistributionSummary(value),
    SimulationValues=(self,value)->StatsSimulationValues(value),
    SimulationSummary=(self,value)->StatsSimulationSummary(value),
    MeanConfidence=(self,values,level ?= 95/100,options ?= {= })->StatsMeanConfidence(values,level,options),
    ProportionConfidence=(self,successes,trials,level ?= 95/100)->StatsProportionConfidence(successes,trials,level),
    LinearRegression=(self,x,y)->StatsLinearRegression(x,y),
    Predict=(self,model,x)->StatsPredict(model,x),
    RegressionTable=(self,model)->StatsRegressionTable(model),
    ResidualTable=(self,model)->StatsResidualTable(model)
};
.Host.RegisterValue("stats", statsNamespace, "Exact descriptive statistics and portable plots", ["Statistics", "Exact", "Graphics"]);
