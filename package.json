{
  "name": "rix",
  "version": "0.1.0",
  "description": "RiX, the Rational Interval Expression Language",
  "type": "module",
  "files": [
    "README.md",
    "benchmarks/",
    "bin/",
    "examples/algebra/",
    "examples/complex/",
    "examples/documents/",
    "examples/eval/",
    "examples/geometry/",
    "examples/newton/",
    "examples/plugins/",
    "examples/quadratic/*.rix",
    "examples/quadratic/README.md",
    "examples/renderers/",
    "examples/rixcel/",
    "examples/stern-brocot/",
    "plugins/",
    "schemas/",
    "src/"
  ],
  "exports": {
    ".": "./src/index.js",
    "./parser": "./src/parser/index.js",
    "./codemirror": "./src/tools/codemirror/index.js",
    "./language-service": "./src/tools/language-service/index.js",
    "./language-service/config-node": "./src/tools/language-service/config-node.js",
    "./schemas/*": "./schemas/*",
    "./eval": "./src/eval/index.js",
    "./runtime": "./src/runtime/index.js"
  },
  "bin": {
    "rix": "./bin/rix.js",
    "rix-to-ir": "./bin/rix-to-ir.js",
    "rix-language-server": "./bin/rix-language-server.js",
    "rix-worker": "./bin/rix-worker.js"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov && bun ./scripts/check-coverage.js",
    "test:rix": "bun ./bin/rix.js test",
    "test:examples": "bun test tests/cli/examples.test.js",
    "test:plugin-tutorials": "bun test tests/tools/plugin-tutorials.test.js",
    "test:parser": "bun test tests/parser",
    "test:eval": "bun test tests/eval",
    "test:tools": "bun test tests/tools",
    "test:docs": "bun test tests/tools/documentation-examples.test.js",
    "test:package": "bun test tests/tools/package-smoke.test.js",
    "test:pack": "npm pack --dry-run --cache=tmp/npm-cache",
    "bench:numerics": "bun ./benchmarks/numerics-precision.js",
    "smoke:package": "bun ./scripts/package-consumer-smoke.js",
    "build:lezer": "lezer-generator src/tools/lezer/rix.grammar -o src/tools/lezer/parser.js",
    "check:editor-policy": "bun ./scripts/generate-editor-policy.js --check",
    "test:codemirror": "bun test tests/tools/codemirror.test.js",
    "test:editor": "bun test tests/tools/language-service.test.js tests/tools/lsp.test.js tests/tools/workspace-config.test.js tests/tools/execution-worker.test.js tests/cli/editor-tools.test.js editors/vscode/tests",
    "build:demo": "bun build ./documentation/parser/src/demo.js --outfile ./documentation/parser/demo.js --target browser",
    "docs:reference": "bun ./documentation/scripts/generate-reference.js",
    "docs:examples": "bun ./documentation/scripts/check-examples.js documentation",
    "docs:check": "bun run docs:reference && bun ./documentation/scripts/run-quarto.js render",
    "build:docs": "bun run build:demo && bun run docs:reference && bun ./documentation/scripts/run-quarto.js render",
    "build:docs:dynamic": "bun run build:docs",
    "build:docs:static": "bun run build:demo && bun run docs:reference && bun ./documentation/scripts/run-quarto.js render --profile static",
    "preview:docs": "bun run build:demo && bun run docs:reference && bun ./documentation/scripts/run-quarto.js preview",
    "preview:docs:static": "bun run build:demo && bun run docs:reference && bun ./documentation/scripts/run-quarto.js preview --profile static",
    "build:all": "bun run build:docs",
    "check:ci": "bun run test:coverage && bun run test:rix && bun run test:examples && bun run test:plugin-tutorials && bun run docs:examples && bun run check:editor-policy && bun run test:package && bun run test:pack",
    "check:release": "bun run check:ci && bun run smoke:package",
    "prepublishOnly": "bun run check:release"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@ratmath/core": "^0.4.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "marked": "^15.0.12"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "keywords": [
    "rix",
    "programming-language",
    "mathematics",
    "exact-arithmetic",
    "rational",
    "interval-arithmetic",
    "symbolic-math",
    "computer-algebra",
    "calculator",
    "bun"
  ],
  "author": "James Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jostylr/rix.git"
  },
  "homepage": "https://docs.rix.ratmath.com/",
  "bugs": {
    "url": "https://github.com/jostylr/rix/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
