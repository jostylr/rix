{
  "scopeName": "markdown.rix.codeblock",
  "injectionSelector": "L:text.html.markdown, L:text.html.quarto",
  "patterns": [{
    "name": "meta.embedded.block.rix",
    "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?:rix|RiX)\\s*$",
    "beginCaptures": { "3": { "name": "punctuation.definition.markdown" } },
    "end": "(^|\\G)(\\s*)(\\3)\\s*$",
    "endCaptures": { "3": { "name": "punctuation.definition.markdown" } },
    "patterns": [{ "include": "source.rix" }]
  }]
}

