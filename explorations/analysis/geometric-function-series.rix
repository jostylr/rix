## Explanatory Exploration: exact uniform convergence of a geometric function series.
## Browser-safe: the final value is a portable Fragment.

.Plugin.Load("analysis");
.Plugin.Load("plot");

$$radiusTenths := 5;
$$accuracyPower := 3;

$$view := {;
    radius := $radiusTenths/10;
    epsilon := 1/(10^$accuracyPower);
    series := .analysis.GeometricSeries(radius);
    uniform := series.Check(:uniform,{= epsilon=epsilon,maxWork=160 });
    functionLimit := .analysis.Limit(series,_,{= mode=:uniform })
      .Check({= epsilon=epsilon,maxWork=160 });
    continuity := .analysis.Exchange(:continuity,functionLimit).Check();
    differentiation := .analysis.Exchange(:differentiation,functionLimit).Check();
    scalar := .analysis.GeometricScalarSeries(1,radius);
    scalarLimit := scalar.Check({= epsilon=epsilon,maxWork=160 });
    scalarCauchy := scalar.Cauchy({= epsilon=epsilon,maxWork=160 });
    selected := [0,1,2,3,uniform[:witness][:index]];
    termRows := selected.Map((index)->[
        index,
        series.Term(index)(radius),
        series.TailBound(index),
        series.TailBound(index) <= epsilon ?: :meetsTarget ?_ :tooWide
    ]);

    tailData := [];
    {@ index=0; index<=@uniform[:witness][:index]; {;
        @tailData ~= @tailData.Push([index,@series.TailBound(index)]);
    }; index+=1 };
    graph := .plot.Line(tailData,{=
        size=[700,320],
        label="certified uniform remainder r^(n+1)/(1-r)",
        stroke="#216e8c",
        xLabel="partial-sum index n",
        yLabel="exact tail bound"
    });

    modes := [:pointwise,:uniform,:almostEverywhere,:inMeasure,:norm];
    modeRows := modes.Map((mode)->{;
        result := series.Check(mode,{= epsilon=@epsilon,maxWork=160 });
        [mode,result[:status],result[:reason],result[:allows][:evaluation]]
    });

    .Fragment([
        .Heading(1,"Uniform convergence of the geometric function series"),
        .Paragraph(@"On the exact domain [-@{radius},@{radius}], S_n(x)=1+x+...+x^n has the global remainder bound @{radius}^(n+1)/(1-@{radius})."),
        .ControlPanel({=
            title="Exact domain and accuracy",
            description="The controls select exact Rational values; the checker searches only within its explicit work budget.",
            controls=[
                .Controls.Slider($$radiusTenths,1:9,1,"radius in tenths"),
                .Controls.Slider($$accuracyPower,1:4,1,"epsilon = 10^-p")
            ]
        }),
        .Figure(graph,"The line displays exact theorem bounds. It illustrates the certificate; it is not sampled evidence for convergence."),
        .Table(
            ["n","S_n(r)","uniform tail bound","target test"],
            termRows,
            {= caption=@"Exact endpoint values and bounds for epsilon=@{epsilon}" }
        ),
        .Heading(2,"One sequence, five distinct claims"),
        .Table(
            ["mode","status","reason","may exchange limit and evaluation"],
            modeRows,
            {= caption="The supported kernel certifies uniform convergence; other modes stay explicit and unknown" }
        ),
        .Heading(2,"The scalar series and its Cauchy witness"),
        .Table(
            ["quantity","exact value"],
            [
                ["sum",scalar.Sum()],
                ["effective index",scalarLimit[:witness][:index]],
                ["tail bound",scalarLimit[:witness][:tailBound]],
                ["Cauchy pair bound",scalarCauchy[:witness][:pairBound]],
                ["limsup",scalar.Limsup({= epsilon=epsilon,maxWork=160 })[:value]],
                ["liminf",scalar.Liminf({= epsilon=epsilon,maxWork=160 })[:value]]
            ],
            {= caption="Phase 2 derives scalar limit and Cauchy records from the same exact remainder identity" }
        ),
        .Heading(2,"A theorem must discharge every exchange hypothesis"),
        .Table(
            ["operation","status","remaining obligations"],
            [
                [:continuity,continuity[:status],continuity[:obligations]],
                [:differentiation,differentiation[:status],differentiation[:obligations]]
            ],
            {= caption="Uniform limits of the polynomial terms are continuous; differentiating the limit needs additional evidence" }
        ),
        .Paragraph(@"The certified witness is N=@{uniform[:witness][:index]} with tail @{uniform[:witness][:tailBound]} <= @{epsilon}.")
    ])
};

$view
